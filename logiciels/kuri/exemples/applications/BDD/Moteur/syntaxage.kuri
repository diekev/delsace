ASA :: struct {
    instructions: [..]*Instruction;
}

détruit_asa :: fonc (asa: *ASA) -> rien
{
    pour inst dans asa.instructions {
        discr inst.genre {
            CRÉE {
                inst_crée := inst comme *InstructionCréationTable;

                pour déf dans inst_crée.colonnes {
                    déloge(*déf);
                }

                déloge(*inst_crée.colonnes);
                déloge(*inst_crée);
            }
            SÉLECTIONNE {
                inst_sél := inst comme *InstructionSélection;

                pour expr dans inst_sél.items {
                    déloge(*expr);
                }

                déloge(*inst_sél.items);
                déloge(*inst_sél);
            }
            INSÈRE {
                inst_insère := inst comme *InstructionInsère;

                pour expr dans inst_insère.valeurs {
                    déloge(*expr);
                }

                déloge(*inst_insère.valeurs);
                déloge(*inst_insère);
            }
            MÉTA_SORS,
            MÉTA_TABLES {
                déloge(*inst);
            }
        }
    }

    déloge(*asa.instructions);
}

parse :: fonc (chn: chaine) -> ASA
{
    lexèmes := lèxe(chn);

    /*
    pour l dans lexèmes {
        imprime("%\n", l)
    }
*/

    diffère déloge(*lexèmes);

    syntaxeuse: Syntaxeuse;
    syntaxeuse.lexèmes = lexèmes;

    tantque !fini(*syntaxeuse) {
        parse_instruction(*syntaxeuse);
    }

    asa: ASA;
    asa.instructions = syntaxeuse.instructions;

    si syntaxeuse.possède_erreur {
        imprime("%\n", syntaxeuse.message_erreur);
        détruit_asa(*asa);
    }

    retourne asa;
}

Syntaxeuse :: struct {
    lexèmes: [..]Lexème;
    curseur: z32;

    possède_erreur: bool;
    message_erreur: chaine;

    instructions: [..]*Instruction;
}

fini :: fonc (syntaxeuse: *Syntaxeuse) -> bool #enligne
{
    si syntaxeuse.possède_erreur {
        retourne vrai;
    }
    retourne syntaxeuse.curseur >= syntaxeuse.lexèmes.taille;
}

avance :: fonc (syntaxeuse: *Syntaxeuse) #enligne
{
    syntaxeuse.curseur += 1;
}

lexème_courant :: fonc (syntaxeuse: *Syntaxeuse) -> Lexème #enligne
{
    retourne syntaxeuse.lexèmes[syntaxeuse.curseur];
}

lexème_précédent :: fonc (syntaxeuse: *Syntaxeuse) -> Lexème #enligne
{
    retourne syntaxeuse.lexèmes[syntaxeuse.curseur - 1];
}

apparie_et_consomme :: fonc (syntaxeuse: *Syntaxeuse, genre: GenreLexème) -> bool
{
    si fini(syntaxeuse) {
        retourne faux;
    }

    si lexème_courant(syntaxeuse).genre != genre {
        retourne faux;
    }

    avance(syntaxeuse);
    retourne vrai;
}

apparie_et_consomme :: fonc (syntaxeuse: *Syntaxeuse, identifiant: chaine) -> bool
{
    si fini(syntaxeuse) {
        retourne faux;
    }

    lexème := lexème_courant(syntaxeuse);

    si lexème.genre != GenreLexème.IDENTIFIANT {
        retourne faux;
    }

    si lexème.valeur != identifiant {
        retourne faux;
    }

    avance(syntaxeuse);
    retourne vrai;
}

rapporte_erreur :: fonc (syntaxeuse: *Syntaxeuse, message: chaine, args: ...eini)
{
    si syntaxeuse.possède_erreur {
        retourne;
    }

    syntaxeuse.message_erreur = imprime_chaine(message, ...args);
    syntaxeuse.possède_erreur = vrai;
}

crée_instruction :: fonc (syntaxeuse: *Syntaxeuse, $T: type_de_données) -> *T
{
    inst := loge(T);
    tableau_ajoute(*syntaxeuse.instructions, inst);
    retourne inst;
}

parse_instruction :: fonc (syntaxeuse: *Syntaxeuse)
{
    lexème := lexème_courant(syntaxeuse);

    discr lexème.genre {
        MOT_CLÉ_CRÉE {
            avance(syntaxeuse);
            parse_instruction_crée(syntaxeuse);
        }
        MOT_CLÉ_INSÈRE {
            avance(syntaxeuse);
            parse_instruction_insère(syntaxeuse);
        }
        MOT_CLÉ_SÉLECTIONNE {
            avance(syntaxeuse);
            parse_instruction_sélectionne(syntaxeuse);
        }
        POINT {
            avance(syntaxeuse);

            si apparie_et_consomme(syntaxeuse, "sors") {
                inst := crée_instruction(syntaxeuse, Instruction);
                inst.genre = GenreInstruction.MÉTA_SORS;
                retourne;
            }

            si apparie_et_consomme(syntaxeuse, "tables") {
                inst := crée_instruction(syntaxeuse, Instruction);
                inst.genre = GenreInstruction.MÉTA_TABLES;
                retourne;
            }

            rapporte_erreur(syntaxeuse, "Méta commande inconnue");
        }
        sinon {
            rapporte_erreur(syntaxeuse, "Attendu un mot-clé : obtenu %", lexème.genre);
        }
    }
}

// 1. SÉLECTIONNE (déjà consommé lors de l'appel)
// 2. $expressions [, ...]
// 3. DEPUIS
// 4. $table
// 5. ;
parse_instruction_sélectionne :: fonc (syntaxeuse: *Syntaxeuse)
{
    inst := crée_instruction(syntaxeuse, InstructionSélection);

    saufsi parse_expressions(syntaxeuse, *inst.items) {
        rapporte_erreur(syntaxeuse, "Impossible de parser les expressions");
        retourne;
    }

    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.MOT_CLÉ_DEPUIS) {
        rapporte_erreur(syntaxeuse, "Attendu 'depuis' après 'sélectionne'");
        retourne;
    }

    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.IDENTIFIANT) {
        rapporte_erreur(syntaxeuse, "Attendu 'identifiant'");
        retourne;
    }

    inst.depuis = lexème_précédent(syntaxeuse);

    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.POINT_VIRGULE) {
        rapporte_erreur(syntaxeuse, "Attendu un point virgule à la fin de l'instruction");
        retourne;
    }
}

// 1. CRÉE  (déjà consommé lors de l'appel)
// 2. $nom-table
// 3. (
// 4. [nom-colonne type-colonne, ...]
// 5. )
// 6. ;
parse_instruction_crée :: fonc (syntaxeuse: *Syntaxeuse)
{
    inst := crée_instruction(syntaxeuse, InstructionCréationTable);

    // 2. $nom-table
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.IDENTIFIANT) {
        rapporte_erreur(syntaxeuse, "Attendu 'identifiant'");
        retourne;
    }

    inst.nom = lexème_précédent(syntaxeuse);

    // 3. (
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.PARENTHÈSE_OUVRANTE) {
        rapporte_erreur(syntaxeuse, "Attendu '('");
        retourne;
    }

    tantque !fini(syntaxeuse) {
        lexème := lexème_courant(syntaxeuse);

        si lexème.genre == GenreLexème.PARENTHÈSE_FERMANTE {
            arrête;
        }

        desc := loge(DéfinitionColonne);
        tableau_ajoute(*inst.colonnes, desc);

        // nom-colonne
        si lexème.genre != GenreLexème.IDENTIFIANT {
            rapporte_erreur(syntaxeuse, "Attendu 'identifiant'");
            retourne;
        }

        desc.nom = lexème;

        avance(syntaxeuse);
        lexème = lexème_courant(syntaxeuse);

        // type-colonne
        si lexème.genre != GenreLexème.MOT_CLÉ_TEXTE && lexème.genre != GenreLexème.MOT_CLÉ_ENTIER {
            rapporte_erreur(syntaxeuse, "Attendu 'entier' ou 'texte'");
            retourne;
        }

        desc.type_données = lexème;

        avance(syntaxeuse);

        saufsi apparie_et_consomme(syntaxeuse, GenreLexème.VIRGULE) {
            arrête;
        }
    }

    // 5. )
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.PARENTHÈSE_FERMANTE) {
        rapporte_erreur(syntaxeuse, "Attendu ')'");
        retourne;
    }

    // 6. ;
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.POINT_VIRGULE) {
        rapporte_erreur(syntaxeuse, "Attendu un point virgule à la fin de l'instruction");
        retourne;
    }
}

// 1. INSÈRE
// 2. DANS
// 3. $nom-table
// 4. VALEURS
// 5. (
// 6. $expression [, ...]
// 7. )
// 8. ;
parse_instruction_insère :: fonc (syntaxeuse: *Syntaxeuse)
{
    inst := crée_instruction(syntaxeuse, InstructionInsère);

    // 2. DANS
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.MOT_CLÉ_DANS) {
        rapporte_erreur(syntaxeuse, "Attendu 'dans'");
        retourne;
    }

    // 3. $nom-table
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.IDENTIFIANT) {
        rapporte_erreur(syntaxeuse, "Attendu 'identifiant'");
        retourne;
    }

    inst.table = lexème_précédent(syntaxeuse);

    // 4. VALEURS
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.MOT_CLÉ_VALEURS) {
        rapporte_erreur(syntaxeuse, "Attendu 'valeurs'");
        retourne;
    }

    // 5. (
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.PARENTHÈSE_OUVRANTE) {
        rapporte_erreur(syntaxeuse, "Attendu '('");
        retourne;
    }

    // 6. $expression [, ...]
    saufsi parse_expressions(syntaxeuse, *inst.valeurs) {
        rapporte_erreur(syntaxeuse, "Impossible de parser les expresssions pour INSÈRE !");
        retourne;
    }

    // 7. )
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.PARENTHÈSE_FERMANTE) {
        rapporte_erreur(syntaxeuse, "Attendu '('");
        retourne;
    }

    // 8. ;
    saufsi apparie_et_consomme(syntaxeuse, GenreLexème.POINT_VIRGULE) {
        rapporte_erreur(syntaxeuse, "Attendu un point virgule à la fin de l'instruction");
        retourne;
    }
}

parse_expressions :: fonc (syntaxeuse: *Syntaxeuse, exprs: *[..]*Expression) -> bool
{
    tantque !fini(syntaxeuse) {
        lexème := lexème_courant(syntaxeuse);
        genre := lexème.genre;

        si genre != GenreLexème.IDENTIFIANT && genre != GenreLexème.NUMÉRIQUE && genre != GenreLexème.CHAINE {
            rapporte_erreur(syntaxeuse, "Attendu 'identifiant'");
            retourne faux;
        }

        expr := loge(Expression);
        expr.genre = GenreExpression.LITTÉRALE;
        expr.littérale = lexème;

        tableau_ajoute(exprs, expr);

        avance(syntaxeuse);

        saufsi apparie_et_consomme(syntaxeuse, GenreLexème.VIRGULE) {
            arrête;
        }
    }

    retourne vrai;
}
