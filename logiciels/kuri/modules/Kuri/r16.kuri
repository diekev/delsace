__table_r16_r32: [65536]r32 #compilatrice #ailleurs;
__table_r32_r16: [512]n16 #compilatrice #ailleurs;

Naturel_Ou_Réel :: union nonsûr {
    i: n32;
    f: r32;
}

r16_vers_r32 :: fonc (valeur: r16) -> r32 #interface #enligne
{
    h := mémoire(*valeur comme *n16);
    résultat := __table_r16_r32[h];
    retourne résultat;
}

r16_vers_r64 :: fonc (valeur: r16) -> r64 #interface #enligne
{
    retourne r16_vers_r32(valeur) comme r64;
}

r16_fabs :: fonc (f: r32) -> r32
{
    si f < 0.0 {
        retourne -f;
    }
    retourne f;
}

r16_depuis_r32_except :: fonc (i: n32) -> n16
{
    résultat: n16 = ---;

    s := ((i >> 16) & 0x8000);
    e := (((i >> 13) & 0x3fc00) - 0x1c000) comme z32;

    si e <= 0 {
        /* Dénormalisée. */
        u: Naturel_Ou_Réel;
        u.i = i;
        résultat = (s | (r16_fabs(u.f) * 1.6777216e7 + 0.5) comme n32) comme n16;
    }
    sinon si e == 0x23c00 {
        /* Soit infini, soit nan. Préservons les bits les plus significatis de m pour le code nan. */
        résultat = (s | 0x7c00 | ((i & 0x7fffff) >> 13)) comme n16;
    }
    sinon {
        /* Surcharge, convertisonns en infini. */
        résultat = (s | 0x7c00) comme n16;
    }

    retourne résultat;
}

r16_depuis_r32 :: fonc (val: r32) -> r16 #interface #enligne
{
    résultat: n16 = ---;

    si val == 0.0 {
        résultat = 0;
    }
    sinon {
        u: Naturel_Ou_Réel;
        u.f = val;

        e := __table_r32_r16[(u.i >> 23) & 0x1ff];

        si e {
            résultat = (e + (((u.i & 0x7fffff) + 0x1000) >> 13)) comme n16;
        }
        sinon {
            résultat = r16_depuis_r32_except(u.i);
        }
    }

    retourne mémoire(*résultat comme *r16);
}

r16_depuis_r64 :: fonc (v: r64) -> r16 #interface #enligne
{
    retourne r16_depuis_r32(v comme r32);
}

/* ************* opérateurs unaires ************* */

opérateur + :: (a: r16) -> r16
{
    retourne a;
}

opérateur - :: (a: r16) -> r16
{
    f := r16_vers_r32(a);
    retourne r16_depuis_r32(-f);
}

/* ************* addition ************* */

opérateur + :: (a: r16, b: r16) -> r16
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne r16_depuis_r32(f1 + f2);
}

opérateur + :: (a: r16, b: r32) -> r16
{
    f1 := r16_vers_r32(a);
    retourne r16_depuis_r32(f1 + b);
}

opérateur + :: (a: r32, b: r16) -> r16
{
    f1 := r16_vers_r32(b);
    retourne r16_depuis_r32(a + f1);
}

opérateur + :: (a: r16, b: r64) -> r16
{
    f1 := r16_vers_r64(a);
    retourne r16_depuis_r64(f1 + b);
}

opérateur + :: (a: r64, b: r16) -> r16
{
    f1 := r16_vers_r64(b);
    retourne r16_depuis_r64(a + f1);
}

/* ************* soustraction ************* */

opérateur - :: (a: r16, b: r16) -> r16
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne r16_depuis_r32(f1 - f2);
}

opérateur - :: (a: r16, b: r32) -> r16
{
    f1 := r16_vers_r32(a);
    retourne r16_depuis_r32(f1 - b);
}

opérateur - :: (a: r32, b: r16) -> r16
{
    f1 := r16_vers_r32(b);
    retourne r16_depuis_r32(a - f1);
}

opérateur - :: (a: r16, b: r64) -> r16
{
    f1 := r16_vers_r64(a);
    retourne r16_depuis_r64(f1 - b);
}

opérateur - :: (a: r64, b: r16) -> r16
{
    f1 := r16_vers_r64(b);
    retourne r16_depuis_r64(a - f1);
}

/* ************* multiplication ************* */

opérateur * :: (a: r16, b: r16) -> r16
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne r16_depuis_r32(f1 * f2);
}

opérateur * :: (a: r16, b: r32) -> r16
{
    f1 := r16_vers_r32(a);
    retourne r16_depuis_r32(f1 * b);
}

opérateur * :: (a: r32, b: r16) -> r16
{
    f1 := r16_vers_r32(b);
    retourne r16_depuis_r32(a * f1);
}

opérateur * :: (a: r16, b: r64) -> r16
{
    f1 := r16_vers_r64(a);
    retourne r16_depuis_r64(f1 * b);
}

opérateur * :: (a: r64, b: r16) -> r16
{
    f1 := r16_vers_r64(b);
    retourne r16_depuis_r64(a * f1);
}

/* ************* division ************* */

opérateur / :: (a: r16, b: r16) -> r16
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne r16_depuis_r32(f1 / f2);
}

opérateur / :: (a: r16, b: r32) -> r16
{
    f1 := r16_vers_r32(a);
    retourne r16_depuis_r32(f1 / b);
}

opérateur / :: (a: r32, b: r16) -> r16
{
    f1 := r16_vers_r32(b);
    retourne r16_depuis_r32(a / f1);
}

opérateur / :: (a: r16, b: r64) -> r16
{
    f1 := r16_vers_r64(a);
    retourne r16_depuis_r64(f1 / b);
}

opérateur / :: (a: r64, b: r16) -> r16
{
    f1 := r16_vers_r64(b);
    retourne r16_depuis_r64(a / f1);
}

/* ************* comparaisons ************* */

opérateur < :: (a: r16, b: r16) -> bool
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne f1 < f2;
}

opérateur < :: (a: r16, b: r32) -> bool
{
    f1 := r16_vers_r32(a);
    retourne f1 < b;
}

opérateur < :: (a: r32, b: r16) -> bool
{
    f1 := r16_vers_r32(b);
    retourne a < f1;
}

opérateur < :: (a: r16, b: r64) -> bool
{
    f1 := r16_vers_r64(a);
    retourne f1 < b;
}

opérateur < :: (a: r64, b: r16) -> bool
{
    f1 := r16_vers_r64(b);
    retourne a < f1;
}

opérateur <= :: (a: r16, b: r16) -> bool
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne f1 <= f2;
}

opérateur <= :: (a: r16, b: r32) -> bool
{
    f1 := r16_vers_r32(a);
    retourne f1 <= b;
}

opérateur <= :: (a: r32, b: r16) -> bool
{
    f1 := r16_vers_r32(b);
    retourne a <= f1;
}

opérateur <= :: (a: r16, b: r64) -> bool
{
    f1 := r16_vers_r64(a);
    retourne f1 <= b;
}

opérateur <= :: (a: r64, b: r16) -> bool
{
    f1 := r16_vers_r64(b);
    retourne a <= f1;
}

opérateur > :: (a: r16, b: r16) -> bool
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne f1 > f2;
}

opérateur > :: (a: r16, b: r32) -> bool
{
    f1 := r16_vers_r32(a);
    retourne f1 > b;
}

opérateur > :: (a: r32, b: r16) -> bool
{
    f1 := r16_vers_r32(b);
    retourne a > f1;
}

opérateur > :: (a: r16, b: r64) -> bool
{
    f1 := r16_vers_r64(a);
    retourne f1 > b;
}

opérateur > :: (a: r64, b: r16) -> bool
{
    f1 := r16_vers_r64(b);
    retourne a > f1;
}

opérateur >= :: (a: r16, b: r16) -> bool
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne f1 >= f2;
}

opérateur >= :: (a: r16, b: r32) -> bool
{
    f1 := r16_vers_r32(a);
    retourne f1 >= b;
}

opérateur >= :: (a: r32, b: r16) -> bool
{
    f1 := r16_vers_r32(b);
    retourne a >= f1;
}

opérateur >= :: (a: r16, b: r64) -> bool
{
    f1 := r16_vers_r64(a);
    retourne f1 >= b;
}

opérateur >= :: (a: r64, b: r16) -> bool
{
    f1 := r16_vers_r64(b);
    retourne a >= f1;
}

opérateur == :: (a: r16, b: r16) -> bool
{
    f1 := r16_vers_r32(a);
    f2 := r16_vers_r32(b);
    retourne f1 == f2;
}

opérateur == :: (a: r16, b: r32) -> bool
{
    f1 := r16_vers_r32(a);
    retourne f1 == b;
}

opérateur == :: (a: r32, b: r16) -> bool
{
    f1 := r16_vers_r32(b);
    retourne a == f1;
}

opérateur == :: (a: r16, b: r64) -> bool
{
    f1 := r16_vers_r64(a);
    retourne f1 == b;
}

opérateur == :: (a: r64, b: r16) -> bool
{
    f1 := r16_vers_r64(b);
    retourne a == f1;
}
