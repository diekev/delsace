OIIO_get_int_attribute :: fonc (nom: chaine, valeur_défaut := 0) -> z32
{
    retourne OIIO_get_int_attribute(vers_oiio(nom), valeur_défaut);
}

OIIO_get_float_attribute :: fonc (nom: chaine, valeur_défaut := 0) -> z32
{
    retourne OIIO_get_float_attribute(vers_oiio(nom), valeur_défaut);
}

OIIO_get_string_attribute :: fonc (nom: chaine, valeur_défaut := "") -> chaine
{
    résultat := OIIO_get_string_attribute(vers_oiio(nom), vers_oiio(valeur_défaut));
    retourne chaine(résultat.characters, résultat.size comme z64);
}

OIIO_ImageInput_open :: fonc (chemin: chaine, config: *OIIO_ImageSpec = nul, ioproxy: *OIIO_Filesystem_IOProxy = nul) -> *OIIO_ImageInput
{
    retourne OIIO_ImageInput_open(vers_oiio(chemin), config, ioproxy);
}

OIIO_ImageInput_supports :: fonc (input: *OIIO_ImageInput, feature: chaine) -> bool
{
    retourne OIIO_ImageInput_supports(input, vers_oiio(feature));
}

oiio_read_image :: fonc (image: *OIIO_ImageInput, subimage: z32, miplevel: z32, chbegin: z32, chend: z32, format: OIIO_TypeDesc, data: *rien, xstride: z64, ystride: z64, zstride: z64, progress_callback: OIIO_ProgressCallback = nul, progress_callback_data: *rien = nul) -> bool
{
    retourne OIIO_ImageInput_read_image(image, subimage, miplevel, chbegin, chend, format, data, xstride, ystride, zstride, progress_callback, progress_callback_data);
}

OIIO_ImageOutput_create :: fonc (chemin: chaine, ioproxy: *OIIO_Filesystem_IOProxy = nul, plugin_searchpath := "") -> *OIIO_ImageOutput
{
    retourne OIIO_ImageOutput_create(vers_oiio(chemin), ioproxy, vers_oiio(plugin_searchpath));
}

OIIO_ImageOutput_open :: fonc (output: *OIIO_ImageOutput, chemin: chaine, spec: *OIIO_ImageSpec, mode := OIIO_ImageOutput_OpenMode.CREATE) -> bool
{
    retourne OIIO_ImageOutput_open(output, vers_oiio(chemin), spec, mode);
}

oiio_write_image :: fonc (output: *OIIO_ImageOutput, format: OIIO_TypeDesc, data: *rien, xstride: z64, ystride: z64, zstride: z64, progress_callback: OIIO_ProgressCallback = nul, progress_callback_data: *rien = nul) -> bool
{
    retourne OIIO_ImageOutput_write_image(output, format, data, xstride, ystride, zstride, progress_callback, progress_callback_data);
}

donne_extra_attribs :: fonc (spec: *OIIO_ImageSpec) -> []OIIO_ParamValue
{
    résultat: []OIIO_ParamValue;
    résultat.données = OIIO_ImageSpec_donne_extra_attribs(spec);
    résultat.taille = OIIO_ImageSpec_donne_extra_attribs_size(spec) comme z64;
    retourne résultat;
}

donne_nom :: fonc (param: *OIIO_ParamValue) -> chaine
{
    oiio_string := OIIO_ParamValue_name(param);
    retourne chaine(oiio_string.characters, oiio_string.size comme z64);
}

vers_oiio :: fonc (chn: chaine) -> OIIO_StringView
{
    résultat: OIIO_StringView = ---;
    résultat.characters = chn.caractères;
    résultat.size = chn.taille comme n64;
    retourne résultat;
}

vers_kuri :: fonc (ustr: *OIIO_ustring) -> chaine
{
    résultat: chaine = ---;
    résultat.caractères = OIIO_ustring_c_str(ustr);
    résultat.taille = OIIO_ustring_size(ustr) comme z64;
    retourne résultat;
}

donne_descriptrice_depuis_oiio :: fonc (spec: *OIIO_ImageSpec, typedesc_désiré: OIIO_TypeDesc) -> DescriptriceImage
{
    largeur := OIIO_ImageSpec_donne_width(spec);
    hauteur := OIIO_ImageSpec_donne_height(spec);
    channels := OIIO_ImageSpec_donne_nchannels(spec);
    basetype := typedesc_désiré.basetype comme n32 comme OIIO_TYPEDESC_BASETYPE;

    desc: DescriptriceImage;
    desc.largeur = largeur comme n32;
    desc.hauteur = hauteur comme n32;

    si channels == 1 {
        si basetype == OIIO_TYPEDESC_BASETYPE.UINT8 || basetype == OIIO_TYPEDESC_BASETYPE.INT8 {
            desc.format = FormatPixel.Gris_8;
        }
        sinon si basetype == OIIO_TYPEDESC_BASETYPE.FLOAT {
            desc.format = FormatPixel.Gris_32;
        }
        sinon {
            panique("type image non supporté : %", basetype);
        }
    }
    sinon si channels == 3 {
        si basetype == OIIO_TYPEDESC_BASETYPE.UINT8 || basetype == OIIO_TYPEDESC_BASETYPE.INT8 {
            desc.format = FormatPixel.RVB_8;
        }
        sinon si basetype == OIIO_TYPEDESC_BASETYPE.FLOAT {
            desc.format = FormatPixel.RVB_32;
        }
        sinon {
            panique("type image non supporté : %", basetype);
        }
    }
    sinon si channels == 4 {
        si basetype == OIIO_TYPEDESC_BASETYPE.UINT8 || basetype == OIIO_TYPEDESC_BASETYPE.INT8 {
            desc.format = FormatPixel.RVBA_8;
        }
        sinon si basetype == OIIO_TYPEDESC_BASETYPE.FLOAT {
            desc.format = FormatPixel.RVBA_32;
        }
        sinon {
            panique("type image non supporté : %", basetype);
        }
    }
    sinon {
        panique("nombre de composant non-géré : %", channels);
    }

    retourne desc;
}

donne_typedesc :: fonc (desc: DescriptriceImage) -> OIIO_TypeDesc
{
    résultat: OIIO_TypeDesc;
    résultat.aggregate = OIIO_TYPEDESC_AGGREGATE.SCALAR comme n32 comme n8;

    discr desc.format {
        Gris_8, RVB_8, RVBA_8 {
            résultat.basetype = OIIO_TYPEDESC_BASETYPE.UINT8 comme n32 comme n8;
        }
        Gris_32, RVB_32, RVBA_32 {
            résultat.basetype = OIIO_TYPEDESC_BASETYPE.FLOAT comme n32 comme n8;
        }
    }

    retourne résultat;
}

initialise_image_spec :: fonc (spec: *OIIO_ImageSpec, format: OIIO_TypeDesc, desc: DescriptriceImage)
{
    OIIO_ImageSpec_init(spec);
    OIIO_ImageSpec_definis_width(spec, desc.largeur comme z32);
    OIIO_ImageSpec_definis_height(spec, desc.hauteur comme z32);
    OIIO_ImageSpec_definis_format(spec, format);

    discr desc.format {
        Gris_8, Gris_32 {
            OIIO_ImageSpec_definis_nchannels(spec, 1);
        }
        RVB_8, RVB_32 {
            OIIO_ImageSpec_definis_nchannels(spec, 3);
        }
        RVBA_8, RVBA_32 {
            OIIO_ImageSpec_definis_nchannels(spec, 4);
        }
    }
}
