importe SimpleLexage;

/* ------------------------------------------------------------------------- */
/** \nom CXX_Table_De_Symboles
 * À FAIRE : fusionne avec Table_De_Symboles
 * \{ */

Name_Kind :: énum {
    TEMPLATE;
    NAMESPACE;
    ENUM;
    CLASS;
    TYPEDEF;
    TEMPLATE_PARAMETER;
}

CXX_Name :: struct {
    kind: Name_Kind;
    texte: chaine;
    node: *ASTNode;
}

CXX_Bloc_De_Noms :: struct {
    bloc_parent: *CXX_Bloc_De_Noms;
    noms: [..]CXX_Name;
}

ajoute_nom :: fonc (bloc: *CXX_Bloc_De_Noms, kind: Name_Kind, texte: chaine, node: *ASTNode)
{
    name := tableau_ajoute_élément(*bloc.noms);
    name.kind = kind;
    name.texte = texte;
    name.node = node;
}

CXX_Table_De_Noms :: struct {
    blocs: [..]*CXX_Bloc_De_Noms;
    bloc_courant: *CXX_Bloc_De_Noms;

    noms: [..]CXX_Name;
}

empile_bloc :: fonc (table: *CXX_Table_De_Noms) -> *CXX_Bloc_De_Noms
{
    résultat := loge(CXX_Bloc_De_Noms);
    résultat.bloc_parent = table.bloc_courant;
    table.bloc_courant = résultat;
    tableau_ajoute(*table.blocs, résultat);
    retourne résultat;
}

dépile_bloc :: fonc (table: *CXX_Table_De_Noms)
{
    table.bloc_courant = table.bloc_courant.bloc_parent;
}

ajoute_nom :: fonc (table: *CXX_Table_De_Noms, kind: Name_Kind, texte: chaine, node: *ASTNode)
{
    ajoute_nom(table.bloc_courant, kind, texte, node);
}

trouve_noms :: fonc (table: *CXX_Table_De_Noms, texte: chaine) -> []CXX_Name
{
    table.noms.taille = 0;

    bloc_courant := table.bloc_courant;

    tantque bloc_courant {
        pour bloc_courant.noms {
            si it.texte == texte {
                tableau_ajoute(*table.noms, it);
            }
        }

        bloc_courant = bloc_courant.bloc_parent;
    }

    retourne table.noms;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Parseuse_CPP
 * \{ */

Parseuse_CPP :: struct {
    empl base: Base_Parseuse;

    table_de_noms: CXX_Table_De_Noms;
}

initialise_parseuse :: fonc (parseuse: *Parseuse_CPP, unit: *TranslationUnit)
{
    initialise_base_parseuse(parseuse, unit);

    _ := empile_bloc(*parseuse.table_de_noms);
    ajoute_nom(*parseuse.table_de_noms, Name_Kind.TYPEDEF, "__builtin_va_list", nul);
}

parse_translation_unit :: fonc (parseuse: *Parseuse_CPP)
{
    assert(parseuse.unit != nul);

    parse_declaration_sequence(parseuse, *parseuse.unit.declarations, faux);
}

// declaration-seq
parse_declaration_sequence :: fonc (parseuse: *Parseuse_CPP, declarations: *[..]*ASTNode, fini_sur_accolade_fermante: bool)
{
    tantque !fini(parseuse) {
        lexème := épie_lexème_suivant(parseuse);
        si est_fin_de_fichier(lexème) {
            arrête;
        }
        si fini_sur_accolade_fermante && est_ponctuation(lexème, "}") {
            arrête;
        }
        si est_ponctuation(lexème, "#") {
            consomme(parseuse);
            parse_directive(parseuse);
            continue;
        }
        declaration := parse_declaration(parseuse);
        si declaration {
            si parseuse.messagère {
                envoie_message_déclaration_parsée(parseuse.messagère, parseuse.unit, declaration);
            }
            tableau_ajoute(declarations, declaration);
        }
    }
}

parse_declaration :: fonc (parseuse: *Parseuse_CPP) -> *ASTNode
{
    lexème := épie_lexème_suivant(parseuse);

    // block-declaration
    // function-definition
    // explicit-instantiation
    // explicit-specialization
    // empty-declaration
    // attribute-declaration

    // template-declaration
    si est_mot_clé(lexème, "template") {
        retourne parse_template_declaration(parseuse);
    }

    // linkage-specification
    si est_mot_clé(lexème, "extern") {
        état := sauvegarde_état(parseuse);
        consomme(parseuse);

        token_linkage := épie_lexème_suivant(parseuse);
        si est_chaine_littérale(token_linkage) {
            consomme(parseuse);

            _ := parse_attributs_gcc(parseuse);

            declarations: [..]*ASTNode;
            lexème_suivant := épie_lexème_suivant(parseuse);
            si est_ponctuation(lexème_suivant, "{") {
                consomme(parseuse);
                parse_declaration_sequence(parseuse, *declarations, vrai);
                consomme_ponctuation(parseuse, "}");
            }
            sinon {
                declaration := parse_declaration(parseuse);
                si declaration {
                    tableau_ajoute(*declarations, declaration);
                }
            }

            parse_declaration_sequence(parseuse, *declarations, vrai);

            résultat := crée_noeud(*parseuse.créatrice, lexème, CXX_Linkage_Specification);
            résultat.linkage = token_linkage;
            résultat.declarations = declarations;
            retourne résultat;
        }

        restaure_état(parseuse, état);
    }

    // namespace-definition
    si est_mot_clé(lexème, "namespace") {
        retourne parse_namespace_definition(parseuse, faux);
    }

    si est_mot_clé(lexème, "inline") {
        état := sauvegarde_état(parseuse);
        consomme(parseuse);
        lexème_suivant := épie_lexème_suivant(parseuse);
        si est_mot_clé(lexème_suivant, "namespace") {
            retourne parse_namespace_definition(parseuse, vrai);
        }
        restaure_état(parseuse, état);
    }

    retourne parse_block_declaration(parseuse, vrai);
}

parse_block_declaration :: fonc (parseuse: *Parseuse_CPP, permet_définition_fonction: bool) -> *ASTNode
{
    lexème := épie_lexème_suivant(parseuse);

    // asm-definition
    // namespace-alias-definition
    // using-declaration
    // using-directive
    // static_assert-declaration
    // alias-declaration
    // opaque-enum-declaration

    // simple-declaration
    declaration := parse_simple_declaration(parseuse, permet_définition_fonction);
    si declaration {
        retourne declaration;
    }

    rapporte_erreur(parseuse, lexème, "attendu une déclaration");
    retourne nul;
}

parse_simple_declaration :: fonc (parseuse: *Parseuse_CPP, permet_définition_fonction: bool) -> *ASTNode
{
    // decl-specifier-seqopt init-declarator-listopt ;
    // attribute-specifier-seq decl-specifier-seqopt init-declarator-list ;

    decl_specifier := parse_decl_specifier_seq(parseuse);
    saufsi decl_specifier {
        retourne nul;
    }

    est_typedef := est_mot_clé(decl_specifier.token, "typedef");

    // init-declarator-list
    list: [..]*CXX_Init_Declarator;
    tantque !fini(parseuse) {
        init_declarator := parse_init_declarator(parseuse);
        saufsi init_declarator {
            arrête;
        }

        si est_typedef {
            nom := donne_nom_déclaration(init_declarator);
            saufsi nom {
                rapporte_erreur(parseuse, init_declarator.token, "impossible de définir le nom de la déclaration");
            }

            // À FAIRE : noeud pour les typedefs
            ajoute_nom(*parseuse.table_de_noms, Name_Kind.TYPEDEF, nom, nul);
        }

        tableau_ajoute(*list, init_declarator);

        lexème := épie_lexème_suivant(parseuse);
        saufsi est_ponctuation(lexème, ",") {
            arrête;
        }
        consomme(parseuse);
    }

    si list.taille == 1 {
        init_declarator := list[0];

        si init_declarator.declarator.genre == CXX_Parameters_And_Qualifiers {
            lexème := épie_lexème_suivant(parseuse);
            si est_ponctuation(lexème, "{") && permet_définition_fonction {
                // À FAIRE : le mieux serait de ne pas avoir à faire ceci
                déloge(*list);

                function_body := parse_function_body(parseuse);

                résultat := crée_noeud(*parseuse.créatrice, init_declarator.token, CXX_Function_Definition);
                résultat.specifiers = decl_specifier;
                résultat.declarator = init_declarator.declarator;
                résultat.body = function_body;
                retourne résultat;
            }
        }
    }

    _ := parse_attributs_gcc(parseuse);

    consomme_ponctuation(parseuse, ";");

    résultat := crée_noeud(*parseuse.créatrice, decl_specifier.token, CXX_Simple_Declaration);
    résultat.decl_specifier = decl_specifier;
    résultat.list = list;
    retourne résultat;
}

parse_decl_specifier_seq :: fonc (parseuse: *Parseuse_CPP) -> *CXX_Declaration_Specifier
{
    racine: *CXX_Declaration_Specifier;
    dernier: *CXX_Declaration_Specifier;

    tantque !fini(parseuse) {
        lexème := épie_lexème_suivant(parseuse);

        noeud: *CXX_Declaration_Specifier;

        si est_storage_class_specifier(parseuse, lexème) {
            consomme(parseuse);
            noeud = crée_noeud(*parseuse.créatrice, lexème, CXX_Storage_Class_Specifier);
        }
        sinon si est_function_specifier(parseuse, lexème) {
            consomme(parseuse);
            noeud = crée_noeud(*parseuse.créatrice, lexème, CXX_Function_Specifier);
        }
        sinon si est_mot_clé(lexème, ["friend", "typedef", "constexpr"]) {
            consomme(parseuse);
            noeud = crée_noeud(*parseuse.créatrice, lexème, CXX_Declaration_Specifier);
        }
        sinon {
            noeud = parse_type_specifier(parseuse);
        }

        saufsi noeud {
            arrête;
        }

        saufsi racine {
            racine = noeud;
        }

        si dernier {
            dernier.next = noeud;
        }

        dernier = noeud;
    }

    retourne racine;
}

parse_init_declarator :: fonc (parseuse: *Parseuse_CPP) -> *CXX_Init_Declarator
{
    declarator := parse_declarator(parseuse);
    saufsi declarator {
        retourne nul;
    }
    résultat := crée_noeud(*parseuse.créatrice, declarator.token, CXX_Init_Declarator);
    résultat.declarator = declarator;
    // À FAIRE : initialisateur;
    retourne résultat;
}

donne_nom_déclaration :: fonc (init_declarator: *CXX_Init_Declarator) -> chaine
{
    retourne donne_nom_déclaration(init_declarator.declarator);
}

donne_nom_déclaration :: fonc (declarator: *ASTNode) -> chaine
{
    si declarator.genre == CXX_ID_Expression {
        id := declarator comme *CXX_ID_Expression;
        retourne donne_texte(id.token);
    }

    si declarator.genre == CXX_Ptr_Declarator {
        ptr := declarator comme *CXX_Ptr_Declarator;
        retourne donne_nom_déclaration(ptr.next);
    }

    si declarator.genre == CXX_Parameters_And_Qualifiers {
        params := declarator comme *CXX_Parameters_And_Qualifiers;
        retourne donne_nom_déclaration(params.left);
    }

    si declarator.genre == CXX_Array_Declarator {
        array := declarator comme *CXX_Array_Declarator;
        retourne donne_nom_déclaration(array.left);
    }

    imprime_arbre(declarator);
    retourne "";
}

parse_declarator :: fonc (parseuse: *Parseuse_CPP) -> *ASTNode
{
    retourne parse_ptr_declarator(parseuse);
}

parse_ptr_declarator :: fonc (parseuse: *Parseuse_CPP) -> *ASTNode
{
    lexème := épie_lexème_suivant(parseuse);

    // À FAIRE : nested-name-specifier
    si est_ponctuation(lexème, "*") || est_ponctuation(lexème, "&") || est_ponctuation(lexème, "&&") {
        consomme(parseuse);

        résultat := crée_noeud(*parseuse.créatrice, lexème, CXX_Ptr_Declarator);
        résultat.next = parse_ptr_declarator(parseuse);
        retourne résultat;
    }

    retourne parse_noptr_declarator(parseuse);
}

parse_noptr_declarator :: fonc (parseuse: *Parseuse_CPP) -> *ASTNode
{
    lexème := épie_lexème_suivant(parseuse);

    résultat: *ASTNode;

    // declarator-id attribute-specifier-seqopt
    // À FAIRE : declarator-id
    si est_symbole(lexème) {
        consomme(parseuse);
        résultat = crée_noeud(*parseuse.créatrice, lexème, CXX_ID_Expression);
    }
    // ( ptr-declarator )
    sinon si est_ponctuation(lexème, "(") {
        consomme(parseuse);
        résultat = parse_ptr_declarator(parseuse);
        consomme_ponctuation(parseuse, ")");
    }

    saufsi résultat {
        retourne nul;
    }

    tantque !fini(parseuse) {
        lexème = épie_lexème_suivant(parseuse);
        // noptr-declarator parameters-and-qualifiers
        si est_ponctuation(lexème, "(") {
            consomme(parseuse);

            parameters := crée_noeud(*parseuse.créatrice, lexème, CXX_Parameters_And_Qualifiers);
            parameters.left = résultat;

            tantque !fini(parseuse) {
                lexème_suivant := épie_lexème_suivant(parseuse);
                si est_ponctuation(lexème_suivant, ")") {
                    arrête;
                }

                parameter := parse_parameter_declaration(parseuse);
                saufsi parameter {
                    arrête;
                }
                tableau_ajoute(*parameters.parameters, parameter);

                lexème_suivant = épie_lexème_suivant(parseuse);
                saufsi est_ponctuation(lexème_suivant, ",") {
                    arrête;
                }
                consomme(parseuse);
            }

            résultat = parameters;

            consomme_ponctuation(parseuse, ")");

            // À FAIRE : qualifiers
            lexème = épie_lexème_suivant(parseuse);
            si est_mot_clé(lexème, "noexcept") {
                consomme(parseuse);
                tableau_ajoute(*parameters.qualifiers, lexème);
            }
        }
        // noptr-declarator [ constant-expressionopt ] attribute-specifier-seqopt
        sinon si est_ponctuation(lexème, "[") {
            consomme(parseuse);

            // À FAIRE : attribute-specifier-seqopt
            array := crée_noeud(*parseuse.créatrice, lexème, CXX_Array_Declarator);
            array.left = résultat;

            lexème = épie_lexème_suivant(parseuse);
            saufsi est_ponctuation(lexème, "]") {
                array.size_expression = parse_constant_expression(parseuse);
            }

            consomme_ponctuation(parseuse, "]");

            résultat = array;
        }
        sinon {
            arrête;
        }
    }

    retourne résultat;
}

parse_namespace_definition :: fonc (parseuse: *Parseuse_CPP, est_inline: bool) -> *Namespace_Definition
{
    lexème := donne_lexème_suivant(parseuse);

    lexème_suivant := donne_lexème_suivant(parseuse);

    // À FAIRE : extension-namespace-definition

    nom: chaine;

    si est_symbole(lexème_suivant) {
        nom = donne_texte(lexème_suivant);
        _ := parse_attributs_gcc(parseuse);
        lexème_suivant = donne_lexème_suivant(parseuse);
    }

    saufsi est_ponctuation(lexème_suivant, "{") {
        rapporte_erreur(parseuse, lexème_suivant, "attendu un '{'");
    }

    declarations: [..]*ASTNode;
    parse_declaration_sequence(parseuse, *declarations, vrai);

    consomme_ponctuation(parseuse, "}");

    résultat := crée_noeud(*parseuse.créatrice, lexème, Namespace_Definition);
    résultat.declarations = declarations;
    résultat.est_inline = est_inline;
    si nom {
        ajoute_nom(*parseuse.table_de_noms, Name_Kind.NAMESPACE, nom, résultat);
    }
    retourne résultat;
}

parse_function_body :: fonc (parseuse: *Parseuse_CPP) -> *ASTNode
{
    retourne parse_compound_statement(parseuse);
}

parse_compound_statement :: fonc (parseuse: *Parseuse_CPP) -> *CompoundStatement
{
    lexème_compound := épie_lexème_suivant(parseuse);
    consomme_ponctuation(parseuse, "{");

    items: [..]*ASTNode;
    tantque !fini(parseuse) {
        lexème := épie_lexème_suivant(parseuse);
        si est_ponctuation(lexème, "}") {
            arrête;
        }

        statement := parse_statement(parseuse);
        si statement {
            tableau_ajoute(*items, statement);
        }
    }

    consomme_ponctuation(parseuse, "}");

    résultat := crée_noeud(*parseuse.créatrice, lexème_compound, CompoundStatement);
    résultat.items = items;
    retourne résultat;
}

parse_statement :: fonc (parseuse: *Parseuse_CPP) -> *ASTNode
{
    lexème := épie_lexème_suivant(parseuse);

    // labeled-statement

    si est_mot_clé(lexème, "case") {
        consomme(parseuse);

        expression := parse_constant_expression(parseuse);
        consomme_ponctuation(parseuse, ":");

        statement := parse_statement(parseuse);

        case_clause := crée_noeud(*parseuse.créatrice, lexème, CaseClause);
        case_clause.expression = expression;
        case_clause.statement = statement;
        retourne case_clause;
    }

    si est_mot_clé(lexème, "default") {
        consomme(parseuse);
        consomme_ponctuation(parseuse, ":");

        statement := parse_statement(parseuse);

        default_clause := crée_noeud(*parseuse.créatrice, lexème, DefaultClause);
        default_clause.statement = statement;
        retourne default_clause;
    }

    si est_symbole(lexème) {
        sauvegarde := parseuse.lexème_courant;
        consomme(parseuse);

        lexème_suivant := épie_lexème_suivant(parseuse);
        si est_ponctuation(lexème_suivant, ":") {
            consomme(parseuse);

            statement := parse_statement(parseuse);

            résultat := crée_noeud(*parseuse.créatrice, lexème, LabelStatement);
            résultat.identifier = donne_texte(lexème);
            résultat.statement = statement;
            retourne résultat;
        }
        sinon {
            parseuse.lexème_courant = sauvegarde;
        }
    }

    // attribute-specifier-seqopt compound-statement
    si est_ponctuation(lexème, "{") {
        retourne parse_compound_statement(parseuse);
    }

    // attribute-specifier-seqopt selection-statement

    si est_mot_clé(lexème, "if") {
        consomme(parseuse);

        consomme_ponctuation(parseuse, "(");
        expression := parse_expression(parseuse);
        consomme_ponctuation(parseuse, ")");

        statement := parse_statement(parseuse);

        else_statement: *ASTNode;
        lexème_suivant := épie_lexème_suivant(parseuse);
        si est_mot_clé(lexème_suivant, "else") {
            consomme(parseuse);
            else_statement = parse_statement(parseuse);
        }

        if_statement := crée_noeud(*parseuse.créatrice, lexème, IfStatement);
        if_statement.expression = expression;
        if_statement.statement = statement;
        if_statement.else_statement = else_statement;
        retourne if_statement;
    }

    si est_mot_clé(lexème, "switch") {
        consomme(parseuse);

        consomme_ponctuation(parseuse, "(");
        expression := parse_expression(parseuse);
        consomme_ponctuation(parseuse, ")");

        statement := parse_statement(parseuse);

        switch_statement := crée_noeud(*parseuse.créatrice, lexème, SwitchStatement);
        switch_statement.expression = expression;
        switch_statement.statement = statement;
        retourne switch_statement;
    }

    // attribute-specifier-seqopt iteration-statement

    si est_mot_clé(lexème, "while") {
        consomme(parseuse);

        consomme_ponctuation(parseuse, "(");
        expression := parse_expression(parseuse);
        consomme_ponctuation(parseuse, ")");

        statement := parse_statement(parseuse);

        while_statement := crée_noeud(*parseuse.créatrice, lexème, WhileStatement);
        while_statement.expression = expression;
        while_statement.statement = statement;
        retourne while_statement;
    }

    si est_mot_clé(lexème, "do") {
        lexème_do := lexème;
        consomme(parseuse);

        statement := parse_statement(parseuse);

        consomme_mot_clé(parseuse, "while");
        consomme_ponctuation(parseuse, "(");
        expression := parse_expression(parseuse);
        consomme_ponctuation(parseuse, ")");
        consomme_ponctuation(parseuse, ";");

        do_while_statement := crée_noeud(*parseuse.créatrice, lexème_do, DoWhileStatement);
        do_while_statement.statement = statement;
        do_while_statement.expression = expression;
        retourne do_while_statement;
    }

    si est_mot_clé(lexème, "for") {
        lexème_for := lexème;
        consomme(parseuse);

        consomme_ponctuation(parseuse, "(");

        initializer: *ASTNode;
        test: *Expression;
        update: *Expression;

        lexème_suivant := épie_lexème_suivant(parseuse);
        si est_declaration_specifier(parseuse, lexème_suivant) {
            initializer = parse_declaration(parseuse);
        }
        sinon {
            saufsi est_ponctuation(lexème_suivant, ";") {
                initializer = parse_expression(parseuse);
            }
            consomme_ponctuation(parseuse, ";");
        }

        lexème_suivant = épie_lexème_suivant(parseuse);
        saufsi est_ponctuation(lexème_suivant, ";") {
            test = parse_expression(parseuse);
        }
        consomme_ponctuation(parseuse, ";");

        lexème_suivant = épie_lexème_suivant(parseuse);
        saufsi est_ponctuation(lexème_suivant, ")") {
            update = parse_expression(parseuse);
        }

        consomme_ponctuation(parseuse, ")");

        statement := parse_statement(parseuse);

        for_statement := crée_noeud(*parseuse.créatrice, lexème_for, ForStatement);
        for_statement.initializer = initializer;
        for_statement.test = test;
        for_statement.update = update;
        for_statement.statement = statement;
        retourne for_statement;
    }

    // attribute-specifier-seqopt jump-statement

    si est_mot_clé(lexème, "goto") {
        lexème_goto := lexème;
        consomme(parseuse);
        lexème = donne_lexème_suivant(parseuse);
        saufsi est_symbole(lexème) {
            rapporte_erreur(parseuse, lexème, "attendu un symbole");
        }
        consomme_ponctuation(parseuse, ";");
        résultat := crée_noeud(*parseuse.créatrice, lexème_goto, GotoStatement);
        résultat.identifier = donne_texte(lexème);
        retourne résultat;
    }

    si est_mot_clé(lexème, "continue") {
        consomme(parseuse);
        consomme_ponctuation(parseuse, ";");
        résultat := crée_noeud(*parseuse.créatrice, lexème, ContinueStatement);
        retourne résultat;
    }

    si est_mot_clé(lexème, "break") {
        consomme(parseuse);
        consomme_ponctuation(parseuse, ";");
        résultat := crée_noeud(*parseuse.créatrice, lexème, BreakStatement);
        retourne résultat;
    }

    si est_mot_clé(lexème, "return") {
        lexème_return := lexème;
        consomme(parseuse);

        expression: *Expression;

        lexème = épie_lexème_suivant(parseuse);
        saufsi est_ponctuation(lexème, ";") {
            expression = parse_expression(parseuse);
        }

        consomme_ponctuation(parseuse, ";");

        résultat := crée_noeud(*parseuse.créatrice, lexème_return, ReturnStatement);
        résultat.expression = expression;
        retourne résultat;
    }

    // declaration-statement
    si est_declaration_specifier(parseuse, lexème) {
        retourne parse_block_declaration(parseuse, faux);
    }

    // attribute-specifier-seqopt try-block

    // attribute-specifier-seqopt expression-statement

    expression := parse_expression(parseuse);
    si expression {
        lexème = épie_lexème_suivant(parseuse);
        consomme_ponctuation(parseuse, ";");

        résultat := crée_noeud(*parseuse.créatrice, lexème, ExpressionStatement);
        résultat.expression = expression;
        retourne résultat;
    }

    rapporte_erreur(parseuse, épie_lexème_suivant(parseuse), "attendu une instruction");
    retourne nul;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Parsage des expressions.
 * \{ */

donne_info_parsage_opérateur_binaire_cpp :: fonc (texte: chaine) -> (bool, InfoParsageOpérateur)
{
    est_opérateur := vrai;
    résultat: InfoParsageOpérateur;

    si texte == "," {
        résultat.précédence = 1;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "=" || texte == "+=" || texte == "-=" || texte == "*=" || texte == "/=" || texte == "%=" || texte == "<<=" || texte == ">>=" || texte == "&=" || texte == "|=" || texte == "^=" {
        résultat.précédence = 2;
        résultat.associativité = Associativité.DROITE;
    }
    sinon si texte == "?" {
        résultat.précédence = 3;
        résultat.associativité = Associativité.DROITE;
    }
    sinon si texte == "||" {
        résultat.précédence = 4;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "&&" {
        résultat.précédence = 5;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "|" {
        résultat.précédence = 6;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "^" {
        résultat.précédence = 7;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "&" {
        résultat.précédence = 8;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "==" || texte == "!=" {
        résultat.précédence = 9;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == ">" || texte == ">=" || texte == "<" || texte == "<=" {
        résultat.précédence = 10;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "<<" || texte == ">>" {
        résultat.précédence = 11;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "-" || texte == "+" {
        résultat.précédence = 12;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon si texte == "*" || texte == "/" || texte == "%" {
        résultat.précédence = 13;
        résultat.associativité = Associativité.GAUCHE;
    }
    /* la précédence de 14 est réservée pour les opérateurs unaires */
    sinon si texte == "(" || texte == "[" || texte == "." || texte == "->" || texte == "++" || texte == "--" {
        résultat.précédence = 15;
        résultat.associativité = Associativité.GAUCHE;
    }
    sinon {
        est_opérateur = faux;
    }

    retourne est_opérateur, résultat;
}

donne_info_parsage_opérateur_unaire_cpp :: fonc () -> InfoParsageOpérateur
{
    résultat: InfoParsageOpérateur;
    résultat.précédence = 14;
    résultat.associativité = Associativité.DROITE;
    retourne résultat;
}

parse_expression :: fonc (empl parseuse: *Parseuse_CPP) -> *Expression
{
    résultat := parse_assignment_expression(parseuse);

    lexème := épie_lexème_suivant(parseuse);
    si est_ponctuation(lexème, ",") {
        lexème_comma := lexème;
        consomme(parseuse);

        expressions: [..]*Expression;
        tableau_ajoute(*expressions, résultat);

        tantque !fini(parseuse) {
            expression := parse_assignment_expression(parseuse);
            tableau_ajoute(*expressions, expression);

            lexème = épie_lexème_suivant(parseuse);
            saufsi est_ponctuation(lexème, ",") {
                arrête;
            }
            consomme(parseuse);
        }

        comma := crée_noeud(*créatrice, lexème_comma, CommaExpression);
        comma.expressions = expressions;

        résultat = comma;
    }

    retourne résultat;
}

parse_constant_expression :: fonc (parseuse: *Parseuse_CPP) -> *Expression
{
    _, info := donne_info_parsage_opérateur_binaire_cpp("?");
    retourne parse_expression(parseuse, info);
}

parse_assignment_expression :: fonc (parseuse: *Parseuse_CPP) -> *Expression
{
    _, info := donne_info_parsage_opérateur_binaire_cpp("=");
    retourne parse_expression(parseuse, info);
}

parse_unary_expression :: fonc (parseuse: *Parseuse_CPP) -> *Expression
{
    info := donne_info_parsage_opérateur_unaire_cpp();
    retourne parse_expression(parseuse, info);
}

parse_expression :: fonc (empl parseuse: *Parseuse_CPP, info_courante: InfoParsageOpérateur) -> *Expression
{
    gauche := parse_expression_primaire(parseuse);
    saufsi gauche {
        retourne nul;
    }

    résultat := gauche;

    tantque !fini(parseuse) {
        lexème := épie_lexème_suivant(parseuse);

        texte := donne_texte(lexème);
        est_opérateur, info := donne_info_parsage_opérateur_binaire_cpp(texte);
        saufsi est_opérateur {
            arrête;
        }

        si info.précédence < info_courante.précédence {
            arrête;
        }

        si info.précédence == info_courante.précédence && info_courante.associativité == Associativité.GAUCHE {
            arrête;
        }

        si texte == ">" || texte == ">=" || texte == "<" || texte == "<=" || texte == "==" || texte == "!=" || texte == "-" || texte == "+" || texte == "*" || texte == "/" || texte == "<<" || texte == ">>" || texte == "&" || texte == "^" || texte == "|" || texte == "%" || texte == "||" || texte == "&&" {
            consomme(parseuse);

            opérateur_binaire := crée_noeud(*créatrice, lexème, BinaryExpression);
            opérateur_binaire.op = texte;
            opérateur_binaire.left = résultat;
            opérateur_binaire.right = parse_expression(parseuse, info);

            résultat = opérateur_binaire;
        }
        sinon si texte == "(" {
            consomme(parseuse);

            arguments: [..]*Expression;

            tantque !fini(parseuse) {
                lexème_suivant := épie_lexème_suivant(parseuse);
                si est_ponctuation(lexème_suivant, ")") {
                    arrête;
                }

                argument := parse_assignment_expression(parseuse);
                saufsi argument {
                    arrête;
                }

                tableau_ajoute(*arguments, argument);

                lexème_suivant = épie_lexème_suivant(parseuse);
                saufsi est_ponctuation(lexème_suivant, ",") {
                    arrête;
                }

                consomme(parseuse);
            }

            consomme_ponctuation(parseuse, ")");

            call := crée_noeud(*créatrice, lexème, CallExpression);
            call.callee = résultat;
            call.arguments = arguments;

            résultat = call;
        }
        sinon si texte == "." || texte == "->" {
            consomme(parseuse);

            lexème_suivant := épie_lexème_suivant(parseuse);
            saufsi est_symbole(lexème_suivant) {
                rapporte_erreur(parseuse, lexème_suivant, "attendu un identifiant après '%'", texte);
            }

            consomme(parseuse);

            member_access := crée_noeud(*créatrice, lexème, MemberAccessExpression);
            member_access.is_arrow = texte == "->";
            member_access.left = résultat;
            member_access.identifier = lexème_suivant;

            résultat = member_access;
        }
        sinon si texte == "=" {
            consomme(parseuse);

            assignment := crée_noeud(*créatrice, lexème, AssignmentExpression);
            assignment.left = résultat;
            assignment.right = parse_expression(parseuse, info);

            résultat = assignment;
        }
        sinon si texte == "+=" || texte == "-=" || texte == "*=" || texte == "/=" || texte == "%=" || texte == "<<=" || texte == ">>=" || texte == "&=" || texte == "|=" || texte == "^=" {
            consomme(parseuse);

            assignment := crée_noeud(*créatrice, lexème, CompoundAssignmentExpression);
            assignment.op = texte;
            assignment.left = résultat;
            assignment.right = parse_expression(parseuse, info);

            résultat = assignment;
        }
        sinon si texte == "++" || texte == "--" {
            consomme(parseuse);

            update := crée_noeud(*créatrice, lexème, PostFixUpdateExpression);
            update.op = texte;
            update.operand = résultat;

            résultat = update;
        }
        sinon si texte == "[" {
            consomme(parseuse);

            index := crée_noeud(*créatrice, lexème, IndexExpression);
            index.left = résultat;
            index.right = parse_expression(parseuse);

            résultat = index;

            consomme_ponctuation(parseuse, "]");
        }
        sinon si texte == "?" {
            consomme(parseuse);
            consequent := parse_expression(parseuse);
            consomme_ponctuation(parseuse, ":");
            alternate := parse_expression(parseuse, info);

            ternary := crée_noeud(*créatrice, lexème, TernaryExpression);
            ternary.test = résultat;
            ternary.consequent = consequent;
            ternary.alternate = alternate;

            résultat = ternary;
        }
        sinon {
            rapporte_erreur_interne(parseuse, lexème, "opérateur non-géré");
            arrête;
        }
    }

    retourne résultat;
}

parse_expression_primaire :: fonc (empl parseuse: *Parseuse_CPP) -> *Expression
{
    résultat: *Expression;

    lexème := épie_lexème_suivant(parseuse);

    si est_mot_clé(lexème, "sizeof") {
        consomme(parseuse);

        operand: *Expression;

        lexème_suivant := épie_lexème_suivant(parseuse);
        si est_ponctuation(lexème_suivant, "(") {
            consomme(parseuse);

            lexème_suivant = épie_lexème_suivant(parseuse);
            si est_type_specifier(parseuse, lexème_suivant) || est_type_qualifier(lexème_suivant) {
                rapporte_erreur(parseuse, lexème_suivant, "sizeof(type) non-implémenté");
            }
            sinon {
                operand = parse_expression(parseuse);
            }

            consomme_ponctuation(parseuse, ")");
        }
        sinon {
            operand = parse_unary_expression(parseuse);
        }

        sizeof := crée_noeud(*créatrice, lexème, SizeOfExpression);
        sizeof.operand = operand;

        résultat = sizeof;
    }
    sinon si est_littérale_nombre_entier(lexème) {
        consomme(parseuse);

        literal := crée_noeud(*créatrice, lexème, IntegerConstant);

        résultat = literal;
    }
    sinon si est_littérale_nombre_réel(lexème) {
        consomme(parseuse);

        literal := crée_noeud(*créatrice, lexème, FloatingConstant);

        résultat = literal;
    }
    sinon si est_littérale_caractère(lexème) {
        consomme(parseuse);

        literal := crée_noeud(*créatrice, lexème, CharacterConstant);

        résultat = literal;
    }
    sinon si est_mot_clé(lexème, "true") || est_mot_clé(lexème, "false") {
        consomme(parseuse);

        literal := crée_noeud(*créatrice, lexème, Boolean_Constant);

        résultat = literal;
    }
    sinon si est_ponctuation(lexème, "-") || est_ponctuation(lexème, "+") || est_ponctuation(lexème, "!") || est_ponctuation(lexème, "~") {
        consomme(parseuse);

        operand := parse_unary_expression(parseuse);

        unary := crée_noeud(*créatrice, lexème, UnaryExpression);
        unary.op = donne_texte(lexème);
        unary.operand = operand;

        résultat = unary;
    }
    sinon si est_ponctuation(lexème, "*") {
        consomme(parseuse);

        operand := parse_unary_expression(parseuse);

        indirection := crée_noeud(*créatrice, lexème, IndirectionExpression);
        indirection.operand = operand;

        résultat = indirection;
    }
    sinon si est_ponctuation(lexème, "&") {
        consomme(parseuse);

        operand := parse_unary_expression(parseuse);

        address := crée_noeud(*créatrice, lexème, AddressExpression);
        address.operand = operand;

        résultat = address;
    }
    sinon si est_symbole(lexème) {
        consomme(parseuse);

        reference := crée_noeud(*créatrice, lexème, DeclarationReference);

        résultat = reference;
    }
    sinon si est_chaine_littérale(lexème) {
        consomme(parseuse);

        literal := crée_noeud(*créatrice, lexème, StringLiteral);

        résultat = literal;
    }
    sinon si est_ponctuation(lexème, "(") {
        consomme(parseuse);
        // À FAIRE : note que l'expression possède des parenthèses
        résultat = parse_expression(parseuse);
        consomme_ponctuation(parseuse, ")");
    }
    sinon si est_ponctuation(lexème, "++") || est_ponctuation(lexème, "--") {
        consomme(parseuse);

        operand := parse_unary_expression(parseuse);

        update := crée_noeud(*créatrice, lexème, PrefixUpdateExpression);
        update.op = donne_texte(lexème);
        update.operand = operand;

        résultat = update;
    }
    sinon {
        rapporte_erreur(parseuse, lexème, "attendu une expression primaire");
    }

    retourne résultat;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Classes
 * \{ */

parse_class_specifier :: fonc (parseuse: *Parseuse_CPP, class_key: Token) -> *CXX_Class_Specifier
{
    lexème := épie_lexème_suivant(parseuse);
    class_name: Token;
    si est_symbole(lexème) {
        class_name = donne_lexème_suivant(parseuse);
    }

    consomme_ponctuation(parseuse, "{");

    members: [..]*ASTNode;

    tantque !fini(parseuse) {
        lexème = épie_lexème_suivant(parseuse);
        si est_ponctuation(lexème, "}") {
            arrête;
        }

        member := parse_member_declaration(parseuse);
        saufsi member {
            arrête;
        }

        tableau_ajoute(*members, member);
    }

    consomme_ponctuation(parseuse, "}");

    résultat := crée_noeud(*parseuse.créatrice, class_key, CXX_Class_Specifier);
    résultat.members = members;
    retourne résultat;
}

parse_member_declaration :: fonc (parseuse: *Parseuse_CPP) -> *CXX_Member_Declaration
{
    specifier := parse_decl_specifier_seq(parseuse);

    // À FAIRE : member-declator-list

    declarators: [..]*ASTNode;

    tantque !fini(parseuse) {
        lexème := épie_lexème_suivant(parseuse);
        si est_ponctuation(lexème, ";") {
            arrête;
        }

        declarator := parse_declarator(parseuse);
        saufsi declarator {
            arrête;
        }

        tableau_ajoute(*declarators, declarator);
    }

    consomme_ponctuation(parseuse, ";");

    résultat := crée_noeud(*parseuse.créatrice, specifier.token, CXX_Member_Declaration);
    résultat.specifier = specifier;
    résultat.list = declarators;
    retourne résultat;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Templates
 * \{ */

parse_template_declaration :: fonc (parseuse: *Parseuse_CPP) -> *ASTNode
{
    lexème_template := épie_lexème_suivant(parseuse);
    consomme_mot_clé(parseuse, "template");

    lexème := épie_lexème_suivant(parseuse);
    saufsi est_ponctuation(lexème, "<") {
        rapporte_erreur(parseuse, lexème, "attendu '<'");
    }

    parameters, est_explicit_specialization := parse_template_parameters(parseuse);

    declaration := parse_declaration(parseuse);

    saufsi declaration {
        déloge(*parameters);
        retourne nul;
    }

    template_name: chaine;

    si declaration.genre == CXX_Simple_Declaration {
        simple_declaration := declaration comme *CXX_Simple_Declaration;
        specifier := simple_declaration.decl_specifier;

        si specifier.genre == CXX_Elaborated_Type_Specifier {
            elaborated := specifier comme *CXX_Elaborated_Type_Specifier;
            template_name = donne_texte(elaborated.identifier);
        }
        sinon {
            rapporte_erreur(parseuse, simple_declaration.token, "specifier non-géré pour les templates");
        }
    }
    sinon {
        rapporte_erreur(parseuse, declaration.token, "déclaration non-gérée pour les templates");
    }

    assert(template_name != "");

    résultat: *ASTNode;

    si est_explicit_specialization {
        assert(parameters.taille == 0);

        // À FAIRE : vérifie que nous spécialisons un template existant

        specialization := crée_noeud(*parseuse.créatrice, lexème_template, Explicit_Specialization);
        specialization.declaration = declaration;

        résultat = specialization;
    }
    sinon {
        template := crée_noeud(*parseuse.créatrice, lexème_template, Template_Declaration);
        template.declaration = declaration;
        template.parameters = parameters;

        résultat = template;

        dépile_bloc(*parseuse.table_de_noms);

        ajoute_nom(*parseuse.table_de_noms, Name_Kind.TEMPLATE, template_name, résultat);
    }

    retourne résultat;
}

parse_template_parameters :: fonc (parseuse: *Parseuse_CPP) -> ([..]*ASTNode, bool)
{
    parameters: [..]*ASTNode;

    consomme_ponctuation(parseuse, "<");
    diffère consomme_ponctuation(parseuse, ">");

    lexème := épie_lexème_suivant(parseuse);
    si est_ponctuation(lexème, ">") {
        retourne parameters, vrai;
    }

    _ := empile_bloc(*parseuse.table_de_noms);

    tantque !fini(parseuse) {
        lexème = épie_lexème_suivant(parseuse);
        si est_ponctuation(lexème, ">") {
            arrête;
        }

        si est_mot_clé(lexème, "typename") || est_mot_clé(lexème, "class") {
            consomme(parseuse);

            type_parameter := crée_noeud(*parseuse.créatrice, lexème, Type_Parameter);

            lexème = épie_lexème_suivant(parseuse);
            si est_ponctuation(lexème, "...") {
                type_parameter.est_variadique = vrai;
                consomme(parseuse);
            }

            lexème = épie_lexème_suivant(parseuse);
            si est_symbole(lexème) {
                type_parameter.identifier = lexème;
                consomme(parseuse);
            }

            saufsi type_parameter.est_variadique {
                lexème = épie_lexème_suivant(parseuse);
                si est_ponctuation(lexème, "=") {
                    consomme(parseuse);

                    type_id := parse_type_id(parseuse);
                    saufsi type_id {
                        rapporte_erreur(parseuse, épie_lexème_suivant(parseuse), "attendu un type-id");
                    }

                    type_parameter.type_id = type_id;
                }
            }

            nom := donne_texte(type_parameter.identifier);
            si nom {
                ajoute_nom(*parseuse.table_de_noms, Name_Kind.TEMPLATE_PARAMETER, nom, type_parameter);
            }

            tableau_ajoute(*parameters, type_parameter);
        }
        sinon si est_mot_clé(lexème, "template") {
            rapporte_erreur(parseuse, lexème, "template type parameter non-géré");
        }
        sinon {
            param := parse_parameter_declaration(parseuse);
            si param {
                tableau_ajoute(*parameters, param);
            }
        }

        lexème = épie_lexème_suivant(parseuse);
        saufsi est_ponctuation(lexème, ",") {
            arrête;
        }
        consomme(parseuse);
    }

    retourne parameters, faux;
}

parse_parameter_declaration :: fonc (parseuse: *Parseuse_CPP) -> *Parameter_Declaration
{
    specifier := parse_decl_specifier_seq(parseuse);
    saufsi specifier {
        retourne nul;
    }

    declarator := parse_declarator(parseuse);

    résultat := crée_noeud(*parseuse.créatrice, specifier.token, Parameter_Declaration);
    résultat.specifiers = specifier;
    résultat.declarator = declarator;
    retourne résultat;
}

parse_type_id :: fonc (parseuse: *Parseuse_CPP) -> *ASTNode
{
    /* type-specifier-seq abstract-declaratoropt */
    // À FAIRE : abstract-declarator
    retourne parse_type_specifier_seq(parseuse);
}

parse_type_specifier_seq :: fonc (parseuse: *Parseuse_CPP) -> *CXX_Type_Specifier
{
    racine: *CXX_Type_Specifier;
    dernier: *CXX_Type_Specifier;

    tantque !fini(parseuse) {
        type_specifier := parse_type_specifier(parseuse);
        saufsi type_specifier {
            arrête;
        }

        saufsi racine {
            racine = type_specifier;
        }

        si dernier {
            dernier.next = type_specifier;
        }

        dernier = type_specifier;
    }

    retourne racine;
}

parse_type_specifier :: fonc (parseuse: *Parseuse_CPP) -> *CXX_Type_Specifier
{
    lexème := épie_lexème_suivant(parseuse);
    type_specifier_kind := détermine_type_specifier(parseuse, lexème);
    si type_specifier_kind == Type_Specifier_Kind.NONE {
        retourne nul;
    }

    résultat: *CXX_Type_Specifier;
        
    consomme(parseuse);

    si est_mot_clé(lexème, "decltype") {
        consomme_ponctuation(parseuse, "(");
        lexème_expr := donne_lexème_suivant(parseuse);
        saufsi est_mot_clé(lexème_expr, "nullptr") {
            rapporte_erreur(parseuse, lexème_expr, "expression non-gérée");
        }
        expression := crée_noeud(*parseuse.créatrice, lexème_expr, CXX_Nullptr_Expression);
        decltype := crée_noeud(*parseuse.créatrice, lexème, CXX_Decltype_Specifier);
        decltype.expression = expression;
        résultat = decltype;
        consomme_ponctuation(parseuse, ")");
    }
    sinon si type_specifier_kind == Type_Specifier_Kind.ELABORATED {
        elaborated := crée_noeud(*parseuse.créatrice, lexème, CXX_Elaborated_Type_Specifier);
        elaborated.identifier = donne_lexème_suivant(parseuse);

        lexème_suivant := épie_lexème_suivant(parseuse);

        si est_ponctuation(lexème_suivant, "<") {
            /* simple-template-id */

            nom_type := donne_texte(elaborated.identifier);
            noms := trouve_noms(*parseuse.table_de_noms, nom_type);

            template_declaration: *Template_Declaration;
            pour noms {
                si it.kind == Name_Kind.TEMPLATE {
                    assert(it.node.genre == Template_Declaration);
                    template_declaration = it.node comme *Template_Declaration;
                    arrête;
                }
            }

            si template_declaration {
                elaborated.template_declaration = template_declaration;
                parameters, _ := parse_template_parameters(parseuse);
                elaborated.template_parameters = parameters;
            }
        }

        assert(est_symbole(elaborated.identifier));
        résultat = elaborated;
    }
    sinon si type_specifier_kind == Type_Specifier_Kind.SIMPLE_TEMPLATE_ID {
        elaborated := crée_noeud(*parseuse.créatrice, lexème, CXX_Elaborated_Type_Specifier);
        elaborated.identifier = lexème;
        assert(est_symbole(elaborated.identifier));
        résultat = elaborated;

        nom_type := donne_texte(elaborated.identifier);
        noms := trouve_noms(*parseuse.table_de_noms, nom_type);

        template_declaration: *Template_Declaration;
        pour noms {
            si it.kind == Name_Kind.TEMPLATE {
                assert(it.node.genre == Template_Declaration);
                template_declaration = it.node comme *Template_Declaration;
                arrête;
            }
        }

        saufsi template_declaration {
            rapporte_erreur(parseuse, elaborated.identifier, "unknown template");
        }
        sinon {
            elaborated.template_declaration = template_declaration;
            parameters, _ := parse_template_parameters(parseuse);
            elaborated.template_parameters = parameters;
        }
    }
    sinon si type_specifier_kind == Type_Specifier_Kind.CLASS_SPECIFIER {
        résultat = parse_class_specifier(parseuse, lexème);
    }
    sinon {
        résultat = crée_noeud(*parseuse.créatrice, lexème, CXX_Type_Specifier);
    }

    retourne résultat;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Utilitaires.
 * \{ */

// CXX_Declaration_Specifier_Sequence :: struct {
//     declaration_specifiers: CXX_Declaration_Specifiers;
//     function_specifiers: CXX_Function_Specifiers;
//     storage_classes: CXX_Storage_Class_Specifiers;
// }

// CXX_Declaration_Specifiers :: énum_drapeau n8 {
//     FRIEND;
//     TYPEDEF;
//     CONSTEXPR;
// }

// CXX_Storage_Class_Specifiers :: énum_drapeau n8 {
//     REGISTER;
//     STATIC;
//     THREAD_LOCAL;
//     EXTERN;
//     MUTABLE;
// }

// CXX_Function_Specifiers :: énum_drapeau n8 {
//     INLINE;
//     VIRTUAL;
//     EXPLICIT;
// }

est_declaration_specifier :: fonc (parseuse: *Parseuse_CPP, lexème: Token) -> bool
{
    si est_storage_class_specifier(parseuse, lexème) {
        retourne vrai;
    }
    si est_type_specifier(parseuse, lexème) {
        retourne vrai;
    }
    si est_function_specifier(parseuse, lexème) {
       retourne vrai;
    }
    mots_clés := ["friend", "typedef", "constexpr"];
    retourne est_mot_clé(lexème, mots_clés);
}

est_storage_class_specifier :: fonc (parseuse: *Parseuse_CPP @inutilisée, lexème: Token) -> bool
{
    mots_clés := ["register", "static", "thread_local", "extern", "mutable"];
    retourne est_mot_clé(lexème, mots_clés);
}

Type_Specifier_Kind :: énum {
    NONE;
    /* simple-type-specifier */
    FUNDAMENTAL;
    DECLTYPE;
    /* type-name */
    CLASS_NAME;
    ENUM_NAME;
    TYPEDEF_NAME;
    SIMPLE_TEMPLATE_ID;
    /* class-specifier */
    CLASS_SPECIFIER;
    /* enum-specifier */
    ENUM_SPECIFIER;
    /* elaborated */
    ELABORATED;
    CV_QUALIFIER;
}

détermine_type_specifier :: fonc (parseuse: *Parseuse_CPP, lexème: Token) -> Type_Specifier_Kind
{
    état := sauvegarde_état(parseuse);
    diffère restaure_état(parseuse, état);

    /* elaborated-type-specifier */

    // class-key attribute-specifier-seqopt nested-name-specifieropt identifier
    // class-key nested-name-specifieropt templateopt simple-template-id
    si est_class_key(lexème) {
        consomme(parseuse);
        lexème_suivant := épie_lexème_suivant(parseuse);
        si est_symbole(lexème_suivant) {
            consomme(parseuse);
            lexème_suivant = épie_lexème_suivant(parseuse);

            si est_ponctuation(lexème_suivant, ":") || est_ponctuation(lexème_suivant, "{") {
                retourne Type_Specifier_Kind.CLASS_SPECIFIER;
            }

            retourne Type_Specifier_Kind.ELABORATED;
        }

        si est_ponctuation(lexème_suivant, "{") {
            retourne Type_Specifier_Kind.CLASS_SPECIFIER;
        }

        retourne Type_Specifier_Kind.NONE;
    }

    // enum nested-name-specifieropt identifier
    si est_mot_clé(lexème, "enum") {
        consomme(parseuse);
        lexème_suivant := épie_lexème_suivant(parseuse);
        si est_symbole(lexème_suivant) {
            consomme(parseuse);
            lexème_suivant = épie_lexème_suivant(parseuse);

            si est_ponctuation(lexème_suivant, ":") || est_ponctuation(lexème_suivant, "{") {
                retourne Type_Specifier_Kind.ENUM_SPECIFIER;
            }

            retourne Type_Specifier_Kind.ELABORATED;
        }

        retourne Type_Specifier_Kind.NONE;
    }

    /* simple-type-specifier */

    // nested-name-specifieropt type-name
    // nested-name-specifier template simple-template-id

    mots_clés := ["char", "char16_t", "char32_t", "wchar_t", "bool", "short", "int", "long", "signed", "unsigned", "float", "double", "void", "auto"];
    si est_mot_clé(lexème, mots_clés) {
        retourne Type_Specifier_Kind.FUNDAMENTAL;
    }

    si est_mot_clé(lexème, "decltype") {
        retourne Type_Specifier_Kind.DECLTYPE;
    }

    si est_cv_qualifier(parseuse, lexème) {
        retourne Type_Specifier_Kind.CV_QUALIFIER;
    }

    si est_symbole(lexème) {
        noms := trouve_noms(*parseuse.table_de_noms, donne_texte(lexème));

        si noms.taille > 1 {
            rapporte_erreur(parseuse, lexème, "multiple potential identifiers");
        }
        sinon si noms.taille == 1 {
            name_kind := noms[0].kind;
            discr name_kind {
                TEMPLATE {
                    retourne Type_Specifier_Kind.SIMPLE_TEMPLATE_ID;
                }
                ENUM {
                    retourne Type_Specifier_Kind.ENUM_NAME;
                }
                CLASS {
                    retourne Type_Specifier_Kind.CLASS_NAME;
                }
                TYPEDEF {
                    retourne Type_Specifier_Kind.TYPEDEF_NAME;
                }
                TEMPLATE_PARAMETER {
                    // À FAIRE : trouve ce que ce doit être
                    retourne Type_Specifier_Kind.FUNDAMENTAL;
                }
                sinon {
                    rapporte_erreur(parseuse, lexème, "unexpected identifier");
                }
            }
        }
    }

    retourne Type_Specifier_Kind.NONE;
}

est_type_specifier :: fonc (parseuse: *Parseuse_CPP, lexème: Token) -> bool
{
    retourne est_trailing_type_specifier(parseuse, lexème) || est_class_specifier(parseuse, lexème) || est_enum_specifier(parseuse, lexème);
}

est_trailing_type_specifier :: fonc (parseuse: *Parseuse_CPP, lexème: Token) -> bool
{
    si est_simple_type_specifier(parseuse, lexème) {
        retourne vrai;
    }
    si est_elaborated_type_specifier(parseuse, lexème) {
        retourne vrai;
    }
    si est_typename_specifier(parseuse, lexème) {
        retourne vrai;
    }
    si est_cv_qualifier(parseuse, lexème) {
        retourne vrai;
    }
    retourne faux;
}

est_simple_type_specifier :: fonc (parseuse: *Parseuse_CPP, lexème: Token) -> bool
{
    kind := détermine_type_specifier(parseuse, lexème);
    retourne kind == Type_Specifier_Kind.DECLTYPE || kind == Type_Specifier_Kind.FUNDAMENTAL || est_type_name(kind);
}

est_elaborated_type_specifier :: fonc (parseuse: *Parseuse_CPP, lexème: Token) -> bool
{
    kind := détermine_type_specifier(parseuse, lexème);
    retourne kind == Type_Specifier_Kind.ELABORATED;
}

est_type_name :: fonc (kind: Type_Specifier_Kind) -> bool
{
    retourne kind == Type_Specifier_Kind.CLASS_NAME || kind == Type_Specifier_Kind.ENUM_NAME || kind == Type_Specifier_Kind.TYPEDEF_NAME || kind == Type_Specifier_Kind.SIMPLE_TEMPLATE_ID;
}

est_class_key :: fonc (lexème: Token) -> bool
{
    retourne est_mot_clé(lexème, ["struct", "union", "class"]);
}

est_typename_specifier :: fonc (parseuse: *Parseuse_CPP @inutilisée, lexème: Token) -> bool
{
    retourne est_mot_clé(lexème, "typename");
}

est_cv_qualifier :: fonc (parseuse: *Parseuse_CPP @inutilisée, lexème: Token) -> bool
{
    retourne est_mot_clé(lexème, ["const", "volatile"]);
}

est_class_specifier :: fonc (parseuse: *Parseuse_CPP, lexème: Token) -> bool
{
    kind := détermine_type_specifier(parseuse, lexème);
    retourne kind == Type_Specifier_Kind.CLASS_SPECIFIER;
}

est_enum_specifier :: fonc (parseuse: *Parseuse_CPP, lexème: Token) -> bool
{
    kind := détermine_type_specifier(parseuse, lexème);
    retourne kind == Type_Specifier_Kind.ENUM_SPECIFIER;
}

est_function_specifier :: fonc (parseuse: *Parseuse_CPP @inutilisée, lexème: Token) -> bool
{
    mots_clés := ["inline", "virtual", "explicit"];
    retourne est_mot_clé(lexème, mots_clés);
}

/** \} */
