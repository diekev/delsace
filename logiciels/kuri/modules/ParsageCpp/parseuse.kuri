/* ------------------------------------------------------------------------- */
/** \nom Base_Parseuse
 * \{ */

Base_Parseuse :: struct {
    État :: struct {
        position: z64;
    }

    unit: *TranslationUnit;
    lexèmes: []Token;
    lexème_courant: z64;

    créatrice: CréatriceNoeuds;

    typedef_names: TableDeHachage(chaine, *TypedefDecl);

    messagère: *Messagère;
}

initialise_base_parseuse :: fonc (base: *Base_Parseuse, unit: *TranslationUnit)
{
    base.unit = unit;
    base.lexèmes = convertis_en_tokens(unit.lexèmes_préprocès);
    base.lexème_courant = 0;
}

fini :: fonc (parseuse: *Base_Parseuse) -> bool
{
    retourne parseuse.lexème_courant >= parseuse.lexèmes.taille;
}

donne_lexème_suivant :: fonc (parseuse: *Base_Parseuse) -> Token
{
    si fini(parseuse) {
        lexème := Lexème(type = TypeLexème.FinDeFichier);
        retourne Token(lexème = lexème);
    }
    résultat := parseuse.lexèmes[parseuse.lexème_courant];
    parseuse.lexème_courant += 1;
    retourne résultat;
}

épie_lexème_suivant :: fonc (parseuse: *Base_Parseuse) -> Token
{
    si fini(parseuse) {
        lexème := Lexème(type = TypeLexème.FinDeFichier);
        retourne Token(lexème = lexème);
    }
    résultat := parseuse.lexèmes[parseuse.lexème_courant];
    retourne résultat;
}

consomme :: fonc (parseuse: *Base_Parseuse)
{
    parseuse.lexème_courant += 1;
}

consomme_symbole :: fonc (parseuse: *Base_Parseuse)
{
    lexème := donne_lexème_suivant(parseuse);
    si lexème.lexème.type != TypeLexème.Symbole {
        rapporte_erreur(parseuse, lexème, "attendu un symbole");
    }
}

consomme_mot_clé :: fonc (parseuse: *Base_Parseuse, texte: chaine)
{
    lexème := donne_lexème_suivant(parseuse);
    saufsi est_mot_clé(lexème, texte) {
        rapporte_erreur(parseuse, lexème, "attendu un '%'", texte);
    }
}

consomme_ponctuation :: fonc (parseuse: *Base_Parseuse, texte: chaine)
{
    lexème := donne_lexème_suivant(parseuse);
    saufsi est_ponctuation(lexème, texte) {
        rapporte_erreur(parseuse, lexème, "attendu un '%'", texte);
    }
}

rapporte_erreur_interne :: fonc (parseuse: *Base_Parseuse, lexème: Token, format: chaine, args: ...eini)
{
    rapporte_diagnostique(parseuse.unit, TypeDiagnostique.ERREUR_INTERNE, lexème, format, ...args);
} @Imprimeuse

rapporte_erreur :: fonc (parseuse: *Base_Parseuse, lexème: Token, format: chaine, args: ...eini)
{
    rapporte_diagnostique(parseuse.unit, TypeDiagnostique.ERREUR, lexème, format, ...args);
} @Imprimeuse

sauvegarde_état :: fonc (parseuse: *Base_Parseuse) -> Base_Parseuse.État
{
    résultat: Base_Parseuse.État;
    résultat.position = parseuse.lexème_courant;
    retourne résultat;
}

restaure_état :: fonc (parseuse: *Base_Parseuse, état: Base_Parseuse.État)
{
    parseuse.lexème_courant = état.position;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Attribut
 * \{ */

Attribut :: struct {
    précédent: *Attribut;

    nom: chaine;
    tokens: [..]Token;
}

crée_attribut :: fonc (nom: chaine, précédent: *Attribut) -> *Attribut
{
    résultat := loge(Attribut);
    résultat.nom = nom;
    résultat.précédent = précédent;
    retourne résultat;
}

parse_attributs_gcc :: fonc (empl parseuse: *Base_Parseuse) -> *Attribut
{
    résultat: *Attribut;

    boucle {
        lexème := épie_lexème_suivant(parseuse);
        texte := donne_texte(lexème);

        si texte == "__asm__" || texte == "__asm" {
            résultat = crée_attribut(texte, résultat);

            consomme(parseuse);
            consomme_ponctuation(parseuse, "(");

            lexème = donne_lexème_suivant(parseuse);
            saufsi est_chaine_littérale(lexème) {
                rapporte_erreur(parseuse, lexème, "attendu une chaine littérale");
            }

            tableau_ajoute(*résultat.tokens, lexème);

            consomme_ponctuation(parseuse, ")");
            continue;
        }

        si texte != "__attribute__" {
            arrête;
        }

        consomme(parseuse);
        consomme_ponctuation(parseuse, "(");
        consomme_ponctuation(parseuse, "(");

        tantque !fini(parseuse) {
            lexème = épie_lexème_suivant(parseuse);
            si est_ponctuation(lexème, ")") {
                arrête;
            }

            lexème = donne_lexème_suivant(parseuse);

            résultat = crée_attribut(donne_texte(lexème), résultat);

            lexème = épie_lexème_suivant(parseuse);
            si est_ponctuation(lexème, "(") {
                consomme(parseuse);

                parenthèse := 0;
                tantque !fini(parseuse) {
                    lexème = épie_lexème_suivant(parseuse);
                    si est_ponctuation(lexème, "(") {
                        parenthèse += 1;
                    }
                    si est_ponctuation(lexème, ")") {
                        si parenthèse == 0 {
                            arrête;
                        }
                        parenthèse -= 1;
                    }

                    tableau_ajoute(*résultat.tokens, lexème);

                    consomme(parseuse);
                }

                consomme_ponctuation(parseuse, ")");

                lexème = épie_lexème_suivant(parseuse);
            }

            saufsi est_ponctuation(lexème, ",") {
                arrête;
            }

            consomme(parseuse);
        }

        consomme_ponctuation(parseuse, ")");
        consomme_ponctuation(parseuse, ")");
    }

    retourne résultat;
}

parse_directive :: fonc (parseuse: *Base_Parseuse)
{
    lexème := donne_lexème_suivant(parseuse);
    saufsi est_symbole(lexème, "pragma") {
        rapporte_erreur(parseuse, lexème, "directive inconnue");
        retourne;
    }
    
    lexème = donne_lexème_suivant(parseuse);
    saufsi est_symbole(lexème, "GCC") {
        rapporte_erreur(parseuse, lexème, "compilateur inconnu");
        retourne;
    }

    lexème = donne_lexème_suivant(parseuse);
    si est_symbole(lexème, "visibility") {
        // À FAIRE : empile l'état
        lexème = donne_lexème_suivant(parseuse);

        si est_symbole(lexème, "push") {
            consomme_ponctuation(parseuse, "(");

            lexème = donne_lexème_suivant(parseuse);
            saufsi est_symbole(lexème, "default") || est_mot_clé(lexème, "default") {
                rapporte_erreur(parseuse, lexème, "état de visibility inconnu");
            }

            consomme_ponctuation(parseuse, ")");
        }
        sinon si est_symbole(lexème, "pop") {
            // À FAIRE : dépile l'état
        }
        sinon {
            rapporte_erreur(parseuse, lexème, "instruction de pragma inconnue");
        }
    }
    sinon {
        rapporte_erreur(parseuse, lexème, "catégorie de pragma inconnue");
    }
}

/** \} */
