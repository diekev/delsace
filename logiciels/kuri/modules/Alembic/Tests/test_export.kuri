}

crée_test_attributs :: fonc ()
{
    chemin := "/tmp/attributs-polymesh.abc";

    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    racine := get_root_object(archive);

    matrice_objet_mesh := crée_xform_neutre_pour_objet(racine, "PolyMesh", ts_défaut);
    mesh := abc_output_polymesh_create(matrice_objet_mesh, "PolyMeshShape", ts_défaut);

    mesh_sample := sample_create(mesh);
    diffère destroy(mesh_sample);

    positions := [
        Vec3(-1.0, 0.0, -1.0),
        Vec3( 1.0, 0.0, -1.0),
        Vec3( 1.0, 0.0,  1.0),
        Vec3(-1.0, 0.0,  1.0),
    ];

    set_positions(mesh_sample, positions);

    face_indices := [0, 1, 2, 3];
    set_face_indices(mesh_sample, face_indices);

    face_counts := [4];
    set_face_counts(mesh_sample, face_counts);

    sample_set(mesh, mesh_sample);

    arb_geom_params := get_arb_geom_params(mesh);

    geom_param := abc_output_float_geom_param_create(arb_geom_params, "test", faux, Abc_Geometry_Scope.UNIFORM, 1);

    échantillons := [1.0 / metadata.fps];
    temps_par_cycle := 1.0 / metadata.fps;
    ts_animation := create_time_sampling(archive, échantillons, temps_par_cycle);

    set_time_sampling(geom_param, ts_animation);

    values := r32.[4, 5, 6, 7];

    pour 9 {
        sample: Abc_Output_Float_Geom_Param_Sample;
        sample.scope = Abc_Geometry_Scope.UNIFORM;
        sample.values.values = values.données;

        si 4 <= indice_it <= 7 {
            sample.values.values = values.données + indice_it - 4;
            sample.values.num_values = 1;
        }

        sample_set(geom_param, *sample);
    }
}

crée_courbes_vides :: fonc ()
{
    chemin := "/tmp/empty-curves.abc";

    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    échantillons := [1.0 / metadata.fps];
    temps_par_cycle := 1.0 / metadata.fps;
    ts_animation := create_time_sampling(archive, échantillons, temps_par_cycle);

    racine := get_root_object(archive);

    matrice_curves := crée_xform_neutre_pour_objet(racine, "Curves", ts_défaut);
   
    curves := abc_output_curves_create(matrice_curves, "CurvesGeom", ts_animation);

    curves_sample := sample_create(curves);
    diffère destroy(curves_sample);

    positions_pleines := [Vec3(0.0, 0.0, 0.0), Vec3(1.0, 0.0, 0.0)];
    num_vertices_pleins := z32.[2];

    pour 10 {
        reset(curves_sample);

        set_type(curves_sample, Abc_Curve_Type.LINEAR);
        set_basis(curves_sample, Abc_Basis_Type.NO_BASIS);

        positions: []Vec3;
        num_vertices: []z32;

        si (it + 1) % 2 == 0 {
            positions = positions_pleines;
            num_vertices = num_vertices_pleins;
        }

        set_positions(curves_sample, positions);
        set_curves_num_vertices(curves_sample, num_vertices);

        sample_set(curves, curves_sample);
    }
}
