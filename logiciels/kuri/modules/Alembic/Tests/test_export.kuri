                    sinon si info.suffixe == "f" {
                        imprime_dans_enchaineuse(*enchaineuse, "%.x = 0.123;\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.y = 0.456;\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.z = 0.789;\n", nom_valeur);
                    }
                    sinon {
                        panique("suffixe non-géré : %", info.suffixe);
                    }
                }
                sinon si info.taille == 4 {
                    si info.suffixe == "c" {
                        imprime_dans_enchaineuse(*enchaineuse, "%.r = 0x1a;\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.g = 0x2b;\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.b = 0x3c;\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.a = 0x4d;\n", nom_valeur);
                    }
                    sinon si info.suffixe == "h" {
                        imprime_dans_enchaineuse(*enchaineuse, "%.r = vers_abc_half(0.123);\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.g = vers_abc_half(0.456);\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.b = vers_abc_half(0.789);\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.a = vers_abc_half(0.159);\n", nom_valeur);
                    }
                    sinon si info.suffixe == "f" {
                        imprime_dans_enchaineuse(*enchaineuse, "%.r = 0.123;\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.g = 0.456;\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.b = 0.789;\n", nom_valeur);
                        imprime_dans_enchaineuse(*enchaineuse, "%.a = 0.159;\n", nom_valeur);
                    }
                    sinon {
                        panique("suffixe non-géré : %", info.suffixe);
                    }
                }
                sinon {
                    panique("taille non-gérée : %", info.taille);
                }
            }
            sinon {
                assert(info.préfixe == "N" || info.préfixe == "P" || info.préfixe == "V");

                imprime_dans_enchaineuse(*enchaineuse, "%.x = 123;\n", nom_valeur);
                imprime_dans_enchaineuse(*enchaineuse, "%.y = 456;\n", nom_valeur);

                si info.taille == 3 {
                    imprime_dans_enchaineuse(*enchaineuse, "%.z = 789;\n", nom_valeur);
                }
                sinon si info.taille != 2 {
                    panique("taille non-gérée : %", info.taille);
                }
            }
        }

        imprime_dans_enchaineuse(*enchaineuse, "%_array_sample: Abc_%_Array_Sample;\n", nom_court, type_geom);
        imprime_dans_enchaineuse(*enchaineuse, "%_array_sample.values = *%;\n", nom_court, nom_valeur);
        imprime_dans_enchaineuse(*enchaineuse, "%_array_sample.num_values = 1;\n", nom_court);
        imprime_dans_enchaineuse(*enchaineuse, "set(prop_%, %_array_sample);\n", nom_court, nom_court);
        ajoute_au_tampon(*enchaineuse, "\n");
    }

    retourne chaine_depuis_enchaineuse(*enchaineuse);
}

crée_test_rayons_courbes :: fonc (chemin: chaine, export_rayon: bool)
{
    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    racine := get_root_object(archive);

    matrice_curves := crée_xform_neutre_pour_objet(racine, "Curves", ts_défaut);

    échantillons := [1.0 / metadata.fps];
    temps_par_cycle := 1.0 / metadata.fps;
    ts_animation := create_time_sampling(archive, échantillons, temps_par_cycle);

    curves := abc_output_curves_create(matrice_curves, "CurvesGeom", ts_animation);

    curves_sample := sample_create(curves);
    diffère destroy(curves_sample);

    cx := 0.0;
    cy := 0.0;

    rx := 1.0;
    ry := 1.0;

    segs := 100;

    phi_delta := Constantes(r32).TAU / segs comme r32;

    phi := 0.0;

    pour segs {
        reset(curves_sample);

        ca0 := cx + cosinus(phi) * rx;
        sa0 := cy + sinus(phi) * ry;

        phi += phi_delta;

        set_type(curves_sample, Abc_Curve_Type.LINEAR);

        set_basis(curves_sample, Abc_Basis_Type.NO_BASIS);

        positions := [Vec3(0.0, 0.0, 0.0), Vec3(ca0, 0.0, sa0)];
        set_positions(curves_sample, positions);

        num_vertices := z32.[2];
        set_curves_num_vertices(curves_sample, num_vertices);

        si export_rayon {
            width := 50 - abs((it + 1) - 50);
            widths := r32.[width comme r32 * 0.01, width comme r32 * 0.01];
            set_widths(curves_sample, widths, Abc_Geometry_Scope.VERTEX);
        }

        sample_set(curves, curves_sample);
    }
}

crée_test_scope_rayons_courbes :: fonc (chemin: chaine, scope: Abc_Geometry_Scope)
{
    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    racine := get_root_object(archive);

    matrice_curves := crée_xform_neutre_pour_objet(racine, "Curves", ts_défaut);

    curves := abc_output_curves_create(matrice_curves, "CurvesGeom", ts_défaut);

    curves_sample := sample_create(curves);
    diffère destroy(curves_sample);

    set_type(curves_sample, Abc_Curve_Type.LINEAR);
    set_basis(curves_sample, Abc_Basis_Type.NO_BASIS);

    positions := [Vec3(0.0, 0.0, 0.0), Vec3(0.0, 1.0, 0.0), Vec3(1.0, 0.0, 0.0), Vec3(1.0, 1.0, 0.0)];
    set_positions(curves_sample, positions);

    num_vertices := z32.[2, 2];
    set_curves_num_vertices(curves_sample, num_vertices);

    si scope == Abc_Geometry_Scope.CONSTANT {
        widths := [0.2];
        set_widths(curves_sample, widths, scope);
    }
    sinon si scope == Abc_Geometry_Scope.UNIFORM {
        widths := [0.4, 0.6];
        set_widths(curves_sample, widths, scope);
    }
    sinon {
        assert(scope != Abc_Geometry_Scope.UNKNOWN);
        widths := [0.8, 1.0, 1.2, 1.4];
        set_widths(curves_sample, widths, scope);
    }

    sample_set(curves, curves_sample);
}

crée_test_rayons_points :: fonc (chemin: chaine, export_rayon: bool)
{
    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    racine := get_root_object(archive);

    échantillons := [1.0 / metadata.fps];
    temps_par_cycle := 1.0 / metadata.fps;
    ts_animation := create_time_sampling(archive, échantillons, temps_par_cycle);

    matrice_objet_point := crée_xform_neutre_pour_objet(racine, "PointCloud", ts_défaut);

    objet_point := abc_output_points_create(matrice_objet_point, "PointCloudPoints", ts_animation);
    point_sample := sample_create(objet_point);
    diffère destroy(point_sample);

    cx := 0.0;
    cy := 0.0;

    rx := 1.0;
    ry := 1.0;

    segs := 100;

    phi_delta := Constantes(r32).TAU / segs comme r32;

    phi := 0.0;

    pour segs {
        reset(point_sample);

        ca0 := cx + cosinus(phi) * rx;
        sa0 := cy + sinus(phi) * ry;

        phi += phi_delta;

        position := Vec3(ca0, 0.0, sa0);
        set_positions(point_sample, [position]);

        ids := n64.[0];
        set_ids(point_sample, ids);

        si export_rayon {
            width := 50 - abs((it + 1) - 50);
            widths := r32.[width comme r32 * 0.01];

            geom_param: Abc_Output_Float_Geom_Param_Sample;
            geom_param.values.values = *widths[0];
            geom_param.values.num_values = 1;
            geom_param.scope = Abc_Geometry_Scope.VERTEX;

            set_widths(point_sample, geom_param);
        }

        sample_set(objet_point, point_sample);
    }
}

crée_test_scope_rayons_points :: fonc (chemin: chaine, scope: Abc_Geometry_Scope)
{
    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    racine := get_root_object(archive);

    matrice_objet_point := crée_xform_neutre_pour_objet(racine, "PointCloud", ts_défaut);

    objet_point := abc_output_points_create(matrice_objet_point, "PointCloudPoints", ts_défaut);
    point_sample := sample_create(objet_point);
    diffère destroy(point_sample);

    positions := [Vec3(0.0, 0.0, 0.0), Vec3(0.0, 1.0, 0.0)];
    set_positions(point_sample, positions);

    ids := n64.[0, 1];
    set_ids(point_sample, ids);

    si scope == Abc_Geometry_Scope.CONSTANT {
    geom_param: Abc_Output_Float_Geom_Param_Sample;
        widths := [0.2];
        geom_param.values.values = widths.données;
        geom_param.values.num_values = 1;
        geom_param.scope = scope;

        set_widths(point_sample, geom_param);
    }
    sinon {
        assert(scope != Abc_Geometry_Scope.UNKNOWN);

        widths := [0.4, 0.6];
        geom_param: Abc_Output_Float_Geom_Param_Sample;
        geom_param.values.values = widths.données;
        geom_param.values.num_values = 2;
        geom_param.scope = scope;

        set_widths(point_sample, geom_param);
    }

    sample_set(objet_point, point_sample);
}

crée_test_visibilité :: fonc (chemin: chaine)
{
    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    racine := get_root_object(archive);

    _ := crée_objet_points_simple(racine, "VISIBLE", ts_défaut);

    courbes := crée_objet_courbes_simple(racine, "HIDDEN", ts_défaut);

    visibility_prop := abc_output_object_create_visibility_property(courbes, ts_défaut);
    set(visibility_prop, Abc_Object_Visibility.HIDDEN);
}

crée_test_visibilité :: fonc (chemin: chaine, visibilité_parent: Abc_Object_Visibility, visibilité_enfant: Abc_Object_Visibility)
{
    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    racine := get_root_object(archive);

    nom_parent := imprime_chaine("%", visibilité_parent);
    nom_enfant := imprime_chaine("%", visibilité_enfant);

    parent := crée_xform_neutre_pour_objet(racine, nom_parent, ts_défaut);
    visibility_prop := abc_output_object_create_visibility_property(parent, ts_défaut);
    set(visibility_prop, visibilité_parent);

    enfant := abc_output_points_create(parent, nom_enfant, ts_défaut);
    initialise_points_simple(enfant);
    visibility_prop = abc_output_object_create_visibility_property(enfant, ts_défaut);
    set(visibility_prop, visibilité_enfant);
}

crée_test_visibilité_animée :: fonc (chemin: chaine)
{
    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    archive := abc_output_archive_create(chemin, *metadata);
    diffère destroy(archive);

    ts_défaut := default_time_sampling(archive);

    racine := get_root_object(archive);

    parent := crée_xform_neutre_pour_objet(racine, "ANIMATED", ts_défaut);

    échantillons := [1.0 / metadata.fps];
    temps_par_cycle := 1.0 / metadata.fps;
    ts_animation := create_time_sampling(archive, échantillons, temps_par_cycle);

    enfant := abc_output_points_create(parent, "ANIMATED-SHAPE", ts_défaut);
    initialise_points_simple(enfant);
    visibility_prop := abc_output_object_create_visibility_property(enfant, ts_animation);

    a := 0;
    b := 1;
    c := a + b;
    a = b;
    b = c;

    visibilité_enfant := Abc_Object_Visibility.VISIBLE;

    pour 24 {
        si it + 1 == c {
            visibilité_enfant = Abc_Object_Visibility.VISIBLE;

            c = a + b;
            a = b;
            b = c;
        }
        sinon {
            visibilité_enfant = Abc_Object_Visibility.HIDDEN;
        }

        set(visibility_prop, visibilité_enfant);
    }
}

crée_objet_points_simple :: fonc (parent: *Abc_Output_Xform, nom: chaine, ts: Abc_Time_Sample_Index) -> *Abc_Output_Points
{
    matrice_objet_point := crée_xform_neutre_pour_objet(parent, nom, ts);
    objet_point := abc_output_points_create(matrice_objet_point, "PointCloud", ts);
    initialise_points_simple(objet_point);
    retourne objet_point;
}

initialise_points_simple :: fonc (points: *Abc_Output_Points)
{
    point_sample := sample_create(points);
    diffère destroy(point_sample);

    position := Vec3(0.0, 0.0, 0.0);
    set_positions(point_sample, [position]);

    ids := n64.[0];
    set_ids(point_sample, ids);

    sample_set(points, point_sample);
}

crée_objet_courbes_simple :: fonc (parent: *Abc_Output_Xform, nom: chaine, ts: Abc_Time_Sample_Index) -> *Abc_Output_Curves
{
    matrice_curves := crée_xform_neutre_pour_objet(parent, nom, ts);

    curves := abc_output_curves_create(matrice_curves, "Curves", ts);

    curves_sample := sample_create(curves);
    diffère destroy(curves_sample);

    set_type(curves_sample, Abc_Curve_Type.LINEAR);

    set_basis(curves_sample, Abc_Basis_Type.NO_BASIS);

    positions := [Vec3(0.0, 0.0, 0.0), Vec3(1.0, 0.0, 0.0)];
    set_positions(curves_sample, positions);

    num_vertices := z32.[2];
    set_curves_num_vertices(curves_sample, num_vertices);

    sample_set(curves, curves_sample);

    retourne curves;
}

