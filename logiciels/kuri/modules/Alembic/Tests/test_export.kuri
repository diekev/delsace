        nom_court := it.nom_court;

        ajoute_au_tampon(*enchaineuse, "// ", type_geom, "\n");

        imprime_dans_enchaineuse(*enchaineuse, "prop_% := abc_output_%_array_property_create(parent, \"prop_%\");\n", nom_court, nom_court, nom_court);
        imprime_dans_enchaineuse(*enchaineuse, "abc_output_array_property_set_time_sample_index(prop_%, ts);\n", nom_court);

