/** \nom Infos maillage
 * \{ */

imprime_infos_maillage :: fonc (object: Abc_Generic_Input_Object)
{
    imprimeln("%", get_full_name(object));

    polymesh := object.polymesh;
    schema := get_schema(polymesh);

    variance := get_topology_variance(schema);
    imprimeln("    %", variance);
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Infos caméra
 * \{ */

imprime_infos_caméra :: fonc (object: Abc_Generic_Input_Object)
{
    imprimeln("%", get_full_name(object));

    camera := object.camera;
    schema := get_schema(camera);

    sample := get_value(schema, Abc_Sample_Selector());
    child_bounds: Abc_Box3d;
    get_child_bounds(sample, *child_bounds);
    imprimeln("    child bounds : %", child_bounds);

    num_ops := get_num_ops(sample);
    imprimeln("    num_ops : %", num_ops);

    pour op_index dans num_ops {
        op: Abc_Film_Back_Xform_Op = ---;
        init(*op);

        get_op(sample, op_index, *op);

        op_type := get_type(*op);
        op_hint := get_hint(*op);
        diffère destroy(*op_hint);

        imprimeln("        [%] % (hint : %)", op_index, op_type, vers_kuri(op_hint));
    }
}

