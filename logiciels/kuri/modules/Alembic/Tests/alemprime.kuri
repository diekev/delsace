/* ------------------------------------------------------------------------- */
/** \nom FaceSets
 * \{ */

imprime_infos_facesets :: fonc (object: Abc_Generic_Input_Object)
{
    header := abc_input_object_get_header(object);

    si matches_polymesh(header) {
        polymesh := object.polymesh;
        schema := get_schema(polymesh);

        names: []Abc_String;
        get_faceset_names(schema, *names.données, *names.taille comme *n64);

        si names {
            imprimeln("  %", get_full_name(object));
        }

        pour abc_name dans names {
            faceset := get_faceset(schema, abc_name);
            imprime_info_faceset(faceset);
        }
    }
    sinon si matches_subd(header) {
        subd := object.subd;
        schema := get_schema(subd);

        names: []Abc_String;
        get_faceset_names(schema, *names.données, *names.taille comme *n64);

        si names {
            imprimeln("  %", get_full_name(object));
        }

        pour abc_name dans names {
            faceset := get_faceset(schema, abc_name);
            imprime_info_faceset(faceset);
        }
    }
    sinon {
        imprimeln("L'objet n'est ni un PolyMesh ni un SubD");
    }
}

imprime_info_faceset :: fonc (faceset: *Abc_Input_FaceSet)
{
    name := abc_input_object_get_name(faceset);

    faceset_schema := get_schema(faceset);
    num_faceset_samples := get_num_samples(faceset_schema);
    exclusivity := get_face_exclusivity(faceset_schema);
    imprimeln("    % : % samples (%)", name, num_faceset_samples, exclusivity);

    // pour num_faceset_samples {
    //     selector := Abc_Sample_Selector();
    //     selector.requested_index = it comme z64;

    //     sample := get(faceset_schema, selector);
    //     diffère destroy(sample);

    //     faces := get_faces(sample);
    //     imprimeln("        num_faces %", faces.num_values);

    //     self_bounds := get_self_bounds(sample);
