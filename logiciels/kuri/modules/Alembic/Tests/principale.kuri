imprime_informations_points :: fonc (chemin: chaine)
{
    iarchive := abc_input_archive_create(chemin);
    saufsi iarchive {
        imprimeln("Impossible d'ouvrir l'archive '%'", chemin);
        retourne;
    }
    diffère abc_input_archive_destroy(iarchive);

    top := abc_input_archive_get_top(iarchive);
    saufsi abc_input_object_valid(top) {
        imprimeln("L'object top n'est pas valide");
        retourne;
    }

    pour abc_input_object_get_num_children(top) {
        header := abc_input_object_get_child_header(top, it);
        traverse_hiérarchie_pour_points(top, header);
    }
}

traverse_hiérarchie_pour_points :: fonc (parent: Abc_Generic_Input_Object, header: *Abc_Object_Header)
{
    nom: Abc_String;
    abc_object_header_get_name(header, *nom);
    next_object: Abc_Generic_Input_Object;
    
    si abc_object_header_matches_points(header) {
        points := abc_input_points_get(parent, nom);
        next_object = points;

        imprime_chemin_archive_courante(vrai);

        abc_input_object_get_full_name(next_object, *nom);
        imprimeln("    %", vers_kuri(nom));
    }
    sinon {
        next_object = abc_input_object_get_child(parent, nom);
    }

    si abc_input_object_valid(next_object) {
        pour abc_input_object_get_num_children(next_object) {
            header = abc_input_object_get_child_header(next_object, it);
            traverse_hiérarchie_pour_points(next_object, header);
        }
    }
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Animation Attributs
 * \{ */

test_données_manquantes_blender :: fonc (chemin: chaine)
{
    iarchive := abc_input_archive_create(chemin);
    saufsi iarchive {
        imprimeln("Impossible d'ouvrir l'archive '%'", chemin);
        retourne;
    }
    diffère abc_input_archive_destroy(iarchive);

    top := abc_input_archive_get_top(iarchive);
    saufsi abc_input_object_valid(top) {
        imprimeln("L'object top n'est pas valide");
        retourne;
    }

    objets: [..]Abc_Generic_Input_Object;
    filtre: Filtre_Objet;
    filtre.CURVES = vrai;
    filtre.POLYMESH = vrai;
    filtre.POINTS = vrai;

    pour abc_input_object_get_num_children(top) {
        header := abc_input_object_get_child_header(top, it);
        rassemble_objets(top, header, *objets, filtre);
    }

    saufsi objets {
        imprimeln("Aucun objet");
        retourne;
    }

    pour objets {
        arb_geom_params := donne_arb_geom_params(it);
        nom := donne_full_name(it);

        saufsi arb_geom_params {
            imprimeln("Pas de .arbGeomParam pour '%'", nom);
            continue;
        }

        saufsi abc_input_compound_property_valid(arb_geom_params) {
            imprimeln(".arbGeomParam invalide pour '%'", nom);
            continue;
        }

        num_properties := abc_input_compound_property_get_num_properties(arb_geom_params);
        si num_properties == 0 {
            imprimeln("aucune propriété pour '%'", nom);
            continue;
        }

        prop_header := abc_input_compound_property_get_property_header(arb_geom_params, 0);
        saufsi abc_input_float_geom_param_matches(prop_header) {
            imprimeln("le premier attribut n'est pas float pour '%'", nom);
            continue;
        }

        prop_name: Abc_String;
        abc_property_header_get_name(prop_header, *prop_name);

        geom_param := abc_input_float_geom_param_get(arb_geom_params, prop_name);
        num_samples_geom_params := abc_input_float_geom_param_get_num_samples(geom_param);
        imprimeln("%:", nom);
        num_schema_samples := donne_num_samples_schema(it);
        imprimeln("    num_schema_samples      : %", num_schema_samples);
        imprimeln("    num_samples_geom_params : %", num_samples_geom_params);
    }
}

donne_full_name :: fonc (objet: Abc_Generic_Input_Object) -> chaine
{
    nom: Abc_String;
    abc_input_object_get_full_name(objet, *nom);
    retourne vers_kuri(nom);
}

donne_arb_geom_params :: fonc (objet: Abc_Generic_Input_Object) -> *Abc_Input_Compound_Property
{
    résultat: *Abc_Input_Compound_Property;

    header := abc_input_object_get_header(objet);
    si abc_input_object_is_instance_root(objet.object) {
        /* Pas de .arbGeomParams. */
    }
    sinon si abc_object_header_matches_camera(header) {
        schema := abc_input_camera_get_schema(objet.camera);
        résultat = abc_input_camera_schema_get_arb_geom_params(schema);
    }
    sinon si abc_object_header_matches_curves(header) {
        schema := abc_input_curves_get_schema(objet.curves);
        résultat = abc_input_curves_schema_get_arb_geom_params(schema);
    }
    sinon si abc_object_header_matches_light(header) {
        /* À FAIRE. */
    }
    sinon si abc_object_header_matches_material(header) {
        /* Pas de arbGeomParams. */
    }
    sinon si abc_object_header_matches_nupatch(header) {
        /* À FAIRE. */
    }
    sinon si abc_object_header_matches_points(header) {
        schema := abc_input_points_get_schema(objet.points);
        résultat = abc_input_points_schema_get_arb_geom_params(schema);
    }
    sinon si abc_object_header_matches_polymesh(header) {
        schema := abc_input_polymesh_get_schema(objet.polymesh);
        résultat = abc_input_polymesh_schema_get_arb_geom_params(schema);
    }
    sinon si abc_object_header_matches_subd(header) {
        schema := abc_input_subd_get_schema(objet.subd);
        résultat = abc_input_subd_schema_get_arb_geom_params(schema);
    }
    sinon si abc_object_header_matches_xform(header) {
        /* À FAIRE. */
    }

    retourne résultat;
}

donne_user_properties :: fonc (objet: Abc_Generic_Input_Object) -> *Abc_Input_Compound_Property
{
    résultat: *Abc_Input_Compound_Property;

    header := abc_input_object_get_header(objet);
    si abc_input_object_is_instance_root(objet.object) {
        /* Pas de .arbGeomParams. */
    }
    sinon si abc_object_header_matches_camera(header) {
        schema := abc_input_camera_get_schema(objet.camera);
        résultat = abc_input_camera_schema_get_user_properties(schema);
    }
    sinon si abc_object_header_matches_curves(header) {
        schema := abc_input_curves_get_schema(objet.curves);
        résultat = abc_input_curves_schema_get_user_properties(schema);
    }
    sinon si abc_object_header_matches_light(header) {
        /* À FAIRE. */
    }
    sinon si abc_object_header_matches_material(header) {
        /* Pas de userProperties. */
    }
    sinon si abc_object_header_matches_nupatch(header) {
        /* À FAIRE. */
    }
    sinon si abc_object_header_matches_points(header) {
        schema := abc_input_points_get_schema(objet.points);
        résultat = abc_input_points_schema_get_user_properties(schema);
    }
    sinon si abc_object_header_matches_polymesh(header) {
        schema := abc_input_polymesh_get_schema(objet.polymesh);
        résultat = abc_input_polymesh_schema_get_user_properties(schema);
    }
    sinon si abc_object_header_matches_subd(header) {
        schema := abc_input_subd_get_schema(objet.subd);
        résultat = abc_input_subd_schema_get_user_properties(schema);
    }
    sinon si abc_object_header_matches_xform(header) {
        /* À FAIRE. */
    }

    retourne résultat;
}

donne_num_samples_schema :: fonc (objet: Abc_Generic_Input_Object) -> n64
{
    résultat: n64;

    header := abc_input_object_get_header(objet);
    si abc_object_header_matches_points(header) {
        schema := abc_input_points_get_schema(objet.points);
        résultat = abc_input_points_schema_get_num_samples(schema);
    }
    sinon si abc_object_header_matches_polymesh(header) {
        schema := abc_input_polymesh_get_schema(objet.polymesh);
        résultat = abc_input_polymesh_schema_get_num_samples(schema);
    }
    sinon si abc_object_header_matches_curves(header) {
        schema := abc_input_curves_get_schema(objet.curves);
        résultat = abc_input_curves_schema_get_num_samples(schema);
    }

    retourne résultat;
}

imprime_animation_attributs :: fonc (chemin: chaine)
{
    iarchive := abc_input_archive_create(chemin);
    saufsi iarchive {
        imprimeln("Impossible d'ouvrir l'archive '%'", chemin);
        retourne;
    }
    diffère abc_input_archive_destroy(iarchive);

    top := abc_input_archive_get_top(iarchive);
    saufsi abc_input_object_valid(top) {
        imprimeln("L'object top n'est pas valide");
        retourne;
    }

    // ----------- PolyMesh
    meshes: [..]*Abc_Input_PolyMesh;

    pour abc_input_object_get_num_children(top) {
        header := abc_input_object_get_child_header(top, it);
        rassemble_polymesh(top, header, *meshes);
    }

    saufsi meshes {
        imprimeln("Aucun maillage");
        retourne;
    }

    imprimeln("Trouvé % polymesh", meshes.taille);

    polymesh := meshes[0];

    schema := abc_input_polymesh_get_schema(polymesh);
    arb_geom_params := abc_input_polymesh_schema_get_arb_geom_params(schema);

    // ----------- Curves
    // curves: [..]*Abc_Input_Curves;

    // pour abc_input_object_get_num_children(top) {
    //     header := abc_input_object_get_child_header(top, it);
    //     rassemble_curves(top, header, *curves);
    // }

    // saufsi curves {
    //     imprimeln("Aucune courbe");
    //     retourne;
    // }

    // imprimeln("Trouvé % curves", curves.taille);

    // curve := curves[0];

    // arb_geom_params := abc_input_curves_get_arb_geom_params(curve);

    // ----------- Points
    // points: [..]*Abc_Input_Points;

    // pour abc_input_object_get_num_children(top) {
    //     header := abc_input_object_get_child_header(top, it);
    //     rassemble_points(top, header, *points);
    // }

    // saufsi points {
    //     imprimeln("Aucune courbe");
    //     retourne;
    // }

    // imprimeln("Trouvé % points", points.taille);

    // point := points[0];

    // arb_geom_params := abc_input_points_get_arb_geom_params(point);

    saufsi abc_input_compound_property_valid(arb_geom_params) {
        retourne;
    }

    num_properties := abc_input_compound_property_get_num_properties(arb_geom_params);
    si num_properties == 0 {
        retourne;
    }

    prop_header := abc_input_compound_property_get_property_header(arb_geom_params, 0);
    saufsi abc_input_float_geom_param_matches(prop_header) {
        retourne;
    }

    prop_name: Abc_String;
    abc_property_header_get_name(prop_header, *prop_name);

    geom_param := abc_input_float_geom_param_get(arb_geom_params, prop_name);
    num_samples_geom_params := abc_input_float_geom_param_get_num_samples(geom_param);
    imprimeln("num_samples_geom_params : %", num_samples_geom_params);

    ts := abc_input_float_geom_param_get_time_sampling(geom_param);

    start_frame, end_frame, ips := calcule_limites_animation_en_image(iarchive, ts);

    pour start_frame ... end_frame {
        time := indice_it comme r64 / ips;
        imprimeln("sample at time : % (frame %)", time, it);

        selector: Abc_Sample_Selector;
        selector.requested_time = time;
        selector.requested_index = -1;

        geom_param_sample: Abc_Input_Float_Geom_Param_Sample;
        abc_input_float_geom_param_get_expanded(geom_param, *geom_param_sample, selector);

        tranche: []r32;
        tranche.données = geom_param_sample.values.values;
        tranche.taille = geom_param_sample.values.num_values comme z64;

        imprimeln("% (% valeur(s))", vers_kuri(prop_name), tranche.taille);

        pour value dans tranche {
            imprimeln("--  %", value);
        }
    }
}

calcule_limites_animation_en_image :: fonc (iarchive: *Abc_Input_Archive, ts: *Abc_Time_Sampling, ips_défaut: r64 = 24.0) -> (début: z64, fin: z64, ips: r64)
{
    num_stored_times := abc_time_sampling_get_num_stored_times(ts);
    imprimeln("num_stored_times : %", num_stored_times);

    stored_times: [..]r64;
    diffère déloge(*stored_times);
    tableau_redimensionne(*stored_times, num_stored_times comme z64);

    abc_time_sampling_get_stored_times(ts, *stored_times.données, *stored_times.taille comme *n64);

    pour stored_times {
        imprimeln("-- %", it);
    }

    start_time: r64;
    end_time: r64;
    abc_input_archive_get_start_and_end_time(iarchive, *start_time, *end_time);

    imprimeln("start %, end %", start_time, end_time);

    si num_stored_times == 1 && stored_times[0] != 0.0 {
        ips = 1.0 / stored_times[0];
    }
    sinon {
        ips = ips_défaut;
    }

    imprimeln("ps : %", ips);

    début = (start_time * ips) comme z64;
    fin = (end_time * ips) comme z64;

    imprimeln("image début : %, fin : %", début, fin);

    retourne début, fin, ips;
}

rassemble_polymesh :: fonc (parent: Abc_Generic_Input_Object, header: *Abc_Object_Header, meshes: *[..]*Abc_Input_PolyMesh)
{
    nom: Abc_String;
    abc_object_header_get_name(header, *nom);
    next_object: Abc_Generic_Input_Object;
    
    si abc_object_header_matches_polymesh(header) {
        polymesh := abc_input_polymesh_get(parent, nom);
        next_object = polymesh;

        tableau_ajoute(meshes, polymesh);
    }
    sinon {
        next_object = abc_input_object_get_child(parent, nom);
    }

    si abc_input_object_valid(next_object) {
        pour abc_input_object_get_num_children(next_object) {
            header = abc_input_object_get_child_header(next_object, it);
            rassemble_polymesh(next_object, header, meshes);
        }
    }
}

rassemble_curves :: fonc (parent: Abc_Generic_Input_Object, header: *Abc_Object_Header, meshes: *[..]*Abc_Input_Curves)
{
    nom: Abc_String;
    abc_object_header_get_name(header, *nom);
    next_object: Abc_Generic_Input_Object;
    
    si abc_object_header_matches_curves(header) {
        curves := abc_input_curves_get(parent, nom);
        next_object = curves;

        tableau_ajoute(meshes, curves);
    }
    sinon {
        next_object = abc_input_object_get_child(parent, nom);
    }

    si abc_input_object_valid(next_object) {
        pour abc_input_object_get_num_children(next_object) {
            header = abc_input_object_get_child_header(next_object, it);
            rassemble_curves(next_object, header, meshes);
        }
    }
}

rassemble_points :: fonc (parent: Abc_Generic_Input_Object, header: *Abc_Object_Header, meshes: *[..]*Abc_Input_Points)
{
    nom: Abc_String;
    abc_object_header_get_name(header, *nom);
    next_object: Abc_Generic_Input_Object;
    
    si abc_object_header_matches_points(header) {
        points := abc_input_points_get(parent, nom);
        next_object = points;

        tableau_ajoute(meshes, points);
    }
    sinon {
        next_object = abc_input_object_get_child(parent, nom);
    }

    si abc_input_object_valid(next_object) {
        pour abc_input_object_get_num_children(next_object) {
            header = abc_input_object_get_child_header(next_object, it);
            rassemble_points(next_object, header, meshes);
        }
    }
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Infos attributs
 * \{ */

imprime_infos_attributs :: fonc (chemin: chaine)
{
    iarchive := abc_input_archive_create(chemin);
    saufsi iarchive {
        imprimeln("Impossible d'ouvrir l'archive '%'", chemin);
        retourne;
    }
    diffère abc_input_archive_destroy(iarchive);

    top := abc_input_archive_get_top(iarchive);
    saufsi abc_input_object_valid(top) {
        imprimeln("L'object top n'est pas valide");
        retourne;
    }

    objets: [..]Abc_Generic_Input_Object;
    filtre := Filtre_Objet.ALL;

    pour abc_input_object_get_num_children(top) {
        header := abc_input_object_get_child_header(top, it);
        rassemble_objets(top, header, *objets, filtre);
    }

    pour objets {
        user_properties := donne_user_properties(it);
        si user_properties {
            imprime_infos_properties(user_properties, donne_full_name(it), "User Properties");
        }
        arb_geom_params := donne_arb_geom_params(it);
        si arb_geom_params {
            imprime_infos_properties(arb_geom_params, donne_full_name(it), "Arb Geom Params");
        }
    }
}

imprime_infos_properties :: fonc (props: *Abc_Input_Compound_Property, nom_objet: chaine, message: chaine)
{
    saufsi abc_input_compound_property_valid(props) {
       retourne;
    }

    num := abc_input_compound_property_get_num_properties(props);
    si num == 0 {
        retourne;
    }

    première := vrai;

    pour prop_index dans num {
        prop_header := abc_input_compound_property_get_property_header(props, prop_index);
        prop_type := abc_property_header_get_property_type(prop_header);

        si prop_type == Abc_Property_Type.SCALAR {
            imprime_infos_objet(props, prop_header, nom_objet, message, première);
            première = faux;
        }
        // sinon si prop_type == Abc_Property_Type.ARRAY {
        //     imprime_infos_objet(props, prop_header, nom_objet, message, première);
        //     première = faux;
        // }
    }
}

imprime_infos_objet :: fonc (props: *Abc_Input_Compound_Property, prop_header: *Abc_Property_Header, nom_objet: chaine, message: chaine, première: bool)
{
    imprime_chemin_archive_courante();
    si première {
        imprimeln("   % on '%'", message, nom_objet);
    }

    // prop_name: Abc_String;
    // abc_property_header_get_name(prop_header, *prop_name);

    // imprimeln("       %", vers_kuri(prop_name));

    imprime_propriété_scalaire(props, prop_header);
}

/** \} */
