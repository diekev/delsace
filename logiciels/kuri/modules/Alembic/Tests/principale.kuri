importe Alembic;
importe Chaine;
importe Fondation;
importe LigneDeCommande;
importe SysFichier;
importe Triage;

// -----------------------------------

Application_Et_Description :: struct {
    application: chaine;
    description: chaine;
}

tri_par_application :: fonc (a: Application_Et_Description, b: Application_Et_Description) -> z32
{
    retourne compare_chaine(a.application, b.application);
}

principale :: fonc ()
{
    chemin := parse_argument_chemin();
    saufsi chemin {
        exit(1);
    }

    nom_test := "hiérarchie";

    si est_un_dossier(CheminFichier(chemin)) {
        chemins: [..]chaine;
        diffère déloge_tableau_et_ses_éléments(*chemins);

        donne_chemins_du_dossier_récursif(chemin, *chemins, ".abc");

        // applications_et_descriptions: [..]Application_Et_Description;

        pour chemins {
            chemin_archive_courante = it;
            archive_courante_fut_imprimée = faux;

            fais_test_archive(it, nom_test);
        }
    }
    sinon {
        chemin_archive_courante = chemin;
        archive_courante_fut_imprimée = faux;

        fais_test_archive(chemin, nom_test);
    }

    // imprime_métadonnées_archives(chemin);
}

chemin_archive_courante: chaine;
archive_courante_fut_imprimée: bool;

imprime_chemin_archive_courante :: fonc (avec_taille := faux)
{
    saufsi archive_courante_fut_imprimée {
        si avec_taille {
            taille := détermine_taille_fichier(chemin_archive_courante);
            imprimeln("% (% octets)", chemin_archive_courante, taille);
        }
        sinon {
            imprimeln("%", chemin_archive_courante);
        }
        archive_courante_fut_imprimée = vrai;
    }
}

fais_test_archive :: fonc (chemin: chaine, nom_test: chaine)
{
    si nom_test == "temps-archive" {
        imprime_temps_archive(chemin);
    }
    sinon si nom_test == "métadonnées" {
        imprime_métadonnées_archives(chemin);
    }
    sinon si nom_test == "hiérarchie" {
        imprime_hiérarchie_archive(chemin);
    }
    sinon si nom_test == "subd" {
        imprime_informations_subd(chemin);
    }
    sinon si nom_test == "points" {
        imprime_informations_points(chemin);
    }
    sinon si nom_test == "données-manquantes-blender" {
        test_données_manquantes_blender(chemin);
    }
    sinon si nom_test == "animation-attributs" {
        imprime_animation_attributs(chemin);
    }
    sinon si nom_test == "infos-attributs" {
        imprime_infos_attributs(chemin);
    }
    sinon {
        imprimeln("Test '%' inconnu", nom_test);
        exit(1);
    }
}

imprime_temps_archive :: fonc (chemin: chaine)
{
    iarchive := abc_input_archive_create(chemin);
    saufsi iarchive {
        imprimeln("Impossible d'ouvrir l'archive '%'", chemin);
        retourne;
    }
    diffère abc_input_archive_destroy(iarchive);

    start_time: r64;
    end_time: r64;
    abc_input_archive_get_start_and_end_time(iarchive, *start_time, *end_time);

    imprimeln("% % %", chemin, start_time, end_time);
}

imprime_métadonnées_archives :: fonc (chemin: chaine)
{
    chemins: [..]chaine;
    diffère déloge_tableau_et_ses_éléments(*chemins);

    donne_chemins_du_dossier_récursif(chemin, *chemins, ".abc");

    applications_et_descriptions: [..]Application_Et_Description;

    pour chemins {
        iarchive := abc_input_archive_create(it);
        saufsi iarchive {
            imprimeln("Impossible d'ouvrir l'archive '%'", it);
            continue;
        }
        diffère abc_input_archive_destroy(iarchive);

        metadata := abc_input_archive_get_metadata(iarchive);
        diffère abc_metadata_destroy(metadata);

        iterator := abc_metadata_get_iterator(metadata);

        application: chaine;
        description: chaine;

        boucle {
            clé: Abc_String;
            valeur: Abc_String;

            saufsi abc_metadata_iterator_next(iterator, *clé, *valeur) {
                arrête;
            }

            si vers_kuri(clé) == "_ai_Application" {
                application = copie_chaine(vers_kuri(valeur));
            }
            sinon si vers_kuri(clé) == "_ai_Description" {
                description = copie_chaine(vers_kuri(valeur));
            }
        }

        si application || description {
            données := tableau_ajoute_élément(*applications_et_descriptions);
            données.application = application;
            données.description = description;
        }
    }

    tri_rapide(applications_et_descriptions, tri_par_application);

    application_courante := "";
    pour applications_et_descriptions {
        si application_courante != it.application {
            imprimeln("%", it.application);
            application_courante = it.application;
        }
        imprimeln("    %", it.description);
    }
}

imprime_hiérarchie_archive :: fonc (chemin: chaine)
{
    iarchive := abc_input_archive_create(chemin);
    saufsi iarchive {
        imprimeln("Impossible d'ouvrir l'archive '%'", chemin);
        retourne;
    }
    diffère abc_input_archive_destroy(iarchive);

    top := abc_input_archive_get_top(iarchive);
    saufsi abc_input_object_valid(top) {
        imprimeln("L'object top n'est pas valide");
        retourne;
    }

    metadata := abc_input_archive_get_metadata(iarchive);
    diffère abc_metadata_destroy(metadata);

    imprime_metadata(metadata);

    pour abc_input_object_get_num_children(top) {
        header := abc_input_object_get_child_header(top, it);
        traverse_hiérarchie(top, header);
    }
}

traverse_hiérarchie :: fonc (parent: Abc_Generic_Input_Object, header: *Abc_Object_Header)
{
    nom: Abc_String;
    abc_object_header_get_name(header, *nom);
    next_object: Abc_Generic_Input_Object;
    
    si abc_object_header_matches_camera(header) {
        camera := abc_input_camera_get(parent, nom);
        next_object = camera;
    }
    sinon si abc_object_header_matches_curves(header) {
        curves := abc_input_curves_get(parent, nom);
        next_object = curves;
    }
    sinon si abc_object_header_matches_faceset(header) {
        /* Les FaceSet sont gérés via les PolyMesh et SubD. */
    }
    sinon si abc_object_header_matches_light(header) {
        light := abc_input_light_get(parent, nom);
        next_object = light;
    }
    sinon si abc_object_header_matches_material(header) {
        material := abc_input_material_get(parent, nom);
        next_object = material;
    }
    sinon si abc_object_header_matches_nupatch(header) {
        nupatch := abc_input_nupatch_get(parent, nom);
        next_object = nupatch;
    }
    sinon si abc_object_header_matches_points(header) {
        points := abc_input_points_get(parent, nom);
        next_object = points;
    }
    sinon si abc_object_header_matches_polymesh(header) {
        polymesh := abc_input_polymesh_get(parent, nom);
        next_object = polymesh;
    }
    sinon si abc_object_header_matches_subd(header) {
        subd := abc_input_subd_get(parent, nom);
        next_object = subd;
    }
    sinon si abc_object_header_matches_xform(header) {
        xform := abc_input_xform_get(parent, nom);
        next_object = xform;
    }
    sinon {
        next_object = abc_input_object_get_child(parent, nom);

        si abc_input_object_is_instance_root(next_object.object) {
            abc_input_object_get_full_name(next_object, *nom);
            imprimeln("%", vers_kuri(nom));
        }
    }

    si abc_input_object_valid(next_object) {
        abc_input_object_get_full_name(next_object, *nom);
        imprimeln("%", vers_kuri(nom));

        metadata := abc_object_header_get_metadata(header);
        diffère abc_metadata_destroy(metadata);
        imprime_metadata(metadata);

        visibility_prop := abc_input_object_get_visibility_property(next_object);
        si abc_input_scalar_property_valid(visibility_prop) {
            visibility := abc_input_visibility_property_get(visibility_prop, Abc_Sample_Selector());
            imprimeln("    visibility : %", visibility);
        }

        user_properties := donne_user_properties(next_object);
        si user_properties {
            imprime_properties(user_properties, "User Properties");
        }
        arb_geom_params := donne_arb_geom_params(next_object);
        si arb_geom_params {
            imprime_properties(arb_geom_params, "Arb Geom Params");
        }

        pour abc_input_object_get_num_children(next_object) {
            header = abc_input_object_get_child_header(next_object, it);
            traverse_hiérarchie(next_object, header);
        }
    }
}

Filtre_Objet :: énum_drapeau {
    CAMERA;
    CURVES;
    LIGHT;
    MATERIAL;
    NUPATCH;
    POLYMESH;
    POINTS;
    SUBD;
    XFORM;
    INSTANCE_ROOT;

    ALL :: CAMERA | CURVES | LIGHT | MATERIAL | NUPATCH | POLYMESH | POINTS | SUBD | XFORM | INSTANCE_ROOT;
}

rassemble_objets :: fonc (parent: Abc_Generic_Input_Object, header: *Abc_Object_Header, résultat: *[..]Abc_Generic_Input_Object, filtre: Filtre_Objet)
{
    nom: Abc_String;
    abc_object_header_get_name(header, *nom);
    next_object: Abc_Generic_Input_Object;
    
    si abc_object_header_matches_camera(header) {
        camera := abc_input_camera_get(parent, nom);
        next_object = camera;

        si filtre.CAMERA {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon si abc_object_header_matches_curves(header) {
        curves := abc_input_curves_get(parent, nom);
        next_object = curves;

        si filtre.CURVES {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon si abc_object_header_matches_faceset(header) {
        /* Les FaceSet sont gérés via les PolyMesh et SubD. */
    }
    sinon si abc_object_header_matches_light(header) {
        light := abc_input_light_get(parent, nom);
        next_object = light;

        si filtre.LIGHT {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon si abc_object_header_matches_material(header) {
        material := abc_input_material_get(parent, nom);
        next_object = material;

        si filtre.MATERIAL {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon si abc_object_header_matches_nupatch(header) {
        nupatch := abc_input_nupatch_get(parent, nom);
        next_object = nupatch;

        si filtre.NUPATCH {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon si abc_object_header_matches_points(header) {
        points := abc_input_points_get(parent, nom);
        next_object = points;

        si filtre.POINTS {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon si abc_object_header_matches_polymesh(header) {
        polymesh := abc_input_polymesh_get(parent, nom);
        next_object = polymesh;

        si filtre.POLYMESH {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon si abc_object_header_matches_subd(header) {
        subd := abc_input_subd_get(parent, nom);
        next_object = subd;

        si filtre.SUBD {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon si abc_object_header_matches_xform(header) {
        xform := abc_input_xform_get(parent, nom);
        next_object = xform;

        si filtre.XFORM {
            tableau_ajoute(résultat, next_object);
        }
    }
    sinon {
        next_object = abc_input_object_get_child(parent, nom);

        si abc_input_object_is_instance_root(next_object.object) && filtre.INSTANCE_ROOT {
            tableau_ajoute(résultat, next_object);
        }
    }

    si abc_input_object_valid(next_object) {
        pour abc_input_object_get_num_children(next_object) {
            header = abc_input_object_get_child_header(next_object, it);
            rassemble_objets(next_object, header, résultat, filtre);
        }
    }
}

imprime_metadata :: fonc (metadata: *Abc_MetaData)
{
    iterator := abc_metadata_get_iterator(metadata);
    boucle {
        clé: Abc_String;
        valeur: Abc_String;

        saufsi abc_metadata_iterator_next(iterator, *clé, *valeur) {
            arrête;
        }

        imprimeln("    % : %", vers_kuri(clé), vers_kuri(valeur));
    }
}

imprime_properties :: fonc (props: *Abc_Input_Compound_Property, nom: chaine)
{
    saufsi abc_input_compound_property_valid(props) {
       retourne;
    }

    imprimeln("    %", nom);
    num := abc_input_compound_property_get_num_properties(props);
    si num == 0 {
        imprimeln("        No properties");
        retourne;
    }

    // imprime_chemin_archive_courante();

    pour prop_index dans num {
        prop_header := abc_input_compound_property_get_property_header(props, prop_index);
        prop_type := abc_property_header_get_property_type(prop_header);

        si prop_type == Abc_Property_Type.SCALAR {
            imprime_propriété_scalaire(props, prop_header);
        }
        sinon si prop_type == Abc_Property_Type.ARRAY {
            imprime_propriété_array(props, prop_header);
        }

        metadata := abc_property_header_get_metadata(prop_header);
        diffère abc_metadata_destroy(metadata);

        imprime_metadata(metadata);
    }
}

imprime_propriété_scalaire :: fonc (props: *Abc_Input_Compound_Property, prop_header: *Abc_Property_Header)
{
    prop_name: Abc_String;
    abc_property_header_get_name(prop_header, *prop_name);

    prop_type := abc_property_header_get_property_type(prop_header);

    data_type: Abc_Data_Type;
    abc_property_header_get_data_type(prop_header, *data_type);

    imprimeln("        % (%, %, %)", vers_kuri(prop_name), prop_type, data_type.pod_type, data_type.extent);

    assert(data_type.extent <= 16);

    discr data_type.pod_type {
        BOOLEAN {
            prop := abc_input_bool_property(props, prop_name);
            valeurs: [16]bool;
            abc_input_bool_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        UINT8 {
            prop := abc_input_uchar_property(props, prop_name);
            valeurs: [16]n8;
            abc_input_uchar_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        INT8 {
            prop := abc_input_char_property(props, prop_name);
            valeurs: [16]z8;
            abc_input_char_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        UINT16 {
            prop := abc_input_uint16_property(props, prop_name);
            valeurs: [16]n16;
            abc_input_uint16_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        INT16 {
            prop := abc_input_int16_property(props, prop_name);
            valeurs: [16]z16;
            abc_input_int16_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        UINT32 {
            prop := abc_input_uint32_property(props, prop_name);
            valeurs: [16]n32;
            abc_input_uint32_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        INT32 {
            prop := abc_input_int32_property(props, prop_name);
            valeurs: [16]z32;
            abc_input_int32_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        UINT64 {
            prop := abc_input_uint64_property(props, prop_name);
            valeurs: [16]n64;
            abc_input_uint64_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        INT64 {
            prop := abc_input_int64_property(props, prop_name);
            valeurs: [16]z64;
            abc_input_int64_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        FLOAT16 {
            prop := abc_input_half_property(props, prop_name);
            valeurs: [16]Abc_Half;
            abc_input_half_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", vers_r16(valeurs[it]));
            }
            imprime("\n");
        }
        FLOAT32 {
            prop := abc_input_float_property(props, prop_name);
            valeurs: [16]r32;
            abc_input_float_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        FLOAT64 {
            prop := abc_input_double_property(props, prop_name);
            valeurs: [16]r64;
            abc_input_double_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", valeurs[it]);
            }
            imprime("\n");
        }
        STRING {
            prop := abc_input_string_property(props, prop_name);
            valeurs: [16]Abc_String;
            abc_input_string_property_get(prop, *valeurs[0], Abc_Sample_Selector());
            imprime("           ");
            pour data_type.extent {
                imprime(" %", vers_kuri(valeurs[it]));
            }
            imprime("\n");
        }
        WSTRING {}
        UNKNOWN {}
    }
}

imprime_propriété_array :: fonc (props: *Abc_Input_Compound_Property, prop_header: *Abc_Property_Header)
{
    prop_name: Abc_String;
    abc_property_header_get_name(prop_header, *prop_name);

    prop_type := abc_property_header_get_property_type(prop_header);

    data_type: Abc_Data_Type;
    abc_property_header_get_data_type(prop_header, *data_type);

    imprimeln("        % (%, %, %)", vers_kuri(prop_name), prop_type, data_type.pod_type, data_type.extent);

    assert(data_type.extent <= 16);
}

imprime_informations_subd :: fonc (chemin: chaine)
{
    iarchive := abc_input_archive_create(chemin);
    saufsi iarchive {
        imprimeln("Impossible d'ouvrir l'archive '%'", chemin);
        retourne;
    }
    diffère abc_input_archive_destroy(iarchive);

    top := abc_input_archive_get_top(iarchive);
    saufsi abc_input_object_valid(top) {
        imprimeln("L'object top n'est pas valide");
        retourne;
    }

    pour abc_input_object_get_num_children(top) {
        header := abc_input_object_get_child_header(top, it);
        traverse_hiérarchie_pour_subd(top, header);
    }
}

traverse_hiérarchie_pour_subd :: fonc (parent: Abc_Generic_Input_Object, header: *Abc_Object_Header)
{
    nom: Abc_String;
    abc_object_header_get_name(header, *nom);
    next_object: Abc_Generic_Input_Object;
    
    si abc_object_header_matches_subd(header) {
        subd := abc_input_subd_get(parent, nom);
        next_object = subd;

        imprime_chemin_archive_courante();

        abc_input_object_get_full_name(next_object, *nom);
        imprimeln("    %", vers_kuri(nom));

        selector: Abc_Sample_Selector;
        selector.requested_index = 0;

        schema := abc_input_subd_get_schema(subd);
        subd_sample := abc_input_subd_schema_get(schema, selector);
        diffère abc_input_subd_schema_sample_destroy(subd_sample);

        face_varying_interpolate_boundary : = abc_input_subd_schema_sample_get_face_varying_interpolate_boundary(subd_sample);
        face_varying_propagate_corners : = abc_input_subd_schema_sample_get_face_varying_propagate_corners(subd_sample);
        interpolate_boundary : = abc_input_subd_schema_sample_get_interpolate_boundary(subd_sample);
        subdivision_scheme : = abc_input_subd_schema_sample_get_subdivision_scheme(subd_sample);

        imprimeln("    face_varying_interpolate_boundary : %", face_varying_interpolate_boundary);
        imprimeln("    face_varying_propagate_corners    : %", face_varying_propagate_corners);
        imprimeln("    interpolate_boundary              : %", interpolate_boundary);
        imprimeln("    subdivision_scheme                : %", vers_kuri(subdivision_scheme));
    }
    sinon {
        next_object = abc_input_object_get_child(parent, nom);
    }

    si abc_input_object_valid(next_object) {
        pour abc_input_object_get_num_children(next_object) {
            header = abc_input_object_get_child_header(next_object, it);
            traverse_hiérarchie_pour_subd(next_object, header);
        }
    }
}

