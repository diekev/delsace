importe Compilatrice;

#exécute {
    {
        options: OptionsDeCompilation;
        options.nom_sortie = "alemprime";
        espace := démarre_un_espace_de_travail("alemprime", *options);
        ajoute_fichier_à_la_compilation(espace, "alemprime.kuri");
    }
    {
        options: OptionsDeCompilation;
        options.nom_sortie = "polymesh2subd";
        espace := démarre_un_espace_de_travail("polymesh2subd", *options);
        ajoute_fichier_à_la_compilation(espace, "polymesh2subd.kuri");
    }
    {
        options: OptionsDeCompilation;
        options.nom_sortie = "test_export";
        espace := démarre_un_espace_de_travail("test_export", *options);
        ajoute_fichier_à_la_compilation(espace, "test_export.kuri");
    }
    {
        options := compilatrice_donne_options();
        options.résultat = RésultatCompilation.RIEN;
        compilatrice_ajourne_options(options);
    }
}