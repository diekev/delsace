importe Alembic;
importe Ensemble;
importe Fondation;
importe LigneDeCommande;
importe SysFichier;

principale :: fonc ()
{
    chemin := parse_argument_chemin();
    saufsi chemin {
        exit(1);
    }

    si est_un_dossier(CheminFichier(chemin)) {
        chemins: [..]chaine;
        diffère déloge_tableau_et_ses_éléments(*chemins);

        donne_chemins_du_dossier_récursif(chemin, *chemins, ".abc");

        pour chemins {
            polymesh2subd(it);
        }
    }
    sinon {
        polymesh2subd(chemin);
    }
}

polymesh2subd :: fonc (chemin: chaine)
{
    iarchive := abc_input_archive_create(chemin);
    saufsi iarchive {
        imprimeln("Impossible d'ouvrir l'archive '%'", chemin);
        retourne;
    }
    diffère destroy(iarchive);

    top := get_top(iarchive);
    saufsi abc_input_object_valid(top) {
        imprimeln("L'object top n'est pas valide");
        retourne;
    }

    polymeshes: [..]*Abc_Input_PolyMesh;

    pour abc_input_object_get_num_children(top) {
        header := abc_input_object_get_child_header(top, it);
        traverse_hiérarchie(top, header, *polymeshes);
    }

    /* Sortie. */
    saufsi polymeshes {
        retourne;
    }

    tampon_chemin_sortie: TamponChemin;
    _ := ajoute(*tampon_chemin_sortie, "/tmp/");
    _ := ajoute(*tampon_chemin_sortie, nom_fichier(CheminFichier(chemin)));
    _ := ajoute(*tampon_chemin_sortie, "-subd.abc");

    chemin_sortie := donne_chaine_statique(*tampon_chemin_sortie);

    imprimeln("Écriture de %...", chemin_sortie);

    metadata: Abc_Output_Archive_Metadata;
    metadata.application_name = "Jorjala";
    metadata.fps = 24.0;

    oarchive := abc_output_archive_create(chemin_sortie, *metadata);
    diffère destroy(oarchive);

    ts_défaut := default_time_sampling(oarchive);

    racine := root_object_get(oarchive);

    pour polymeshes {
        convertis_polymesh(oarchive, racine, it, ts_défaut);
    }
}

traverse_hiérarchie :: fonc (parent: Abc_Generic_Input_Object, header: *Abc_Object_Header, résultat: *[..]*Abc_Input_PolyMesh)
{
    nom: Abc_String;
    get_name(header, *nom);
    next_object: Abc_Generic_Input_Object;

    si matches_polymesh(header) {
        polymesh := abc_input_polymesh_get(parent, nom);
        tableau_ajoute(résultat, polymesh);
    }
    sinon si matches_xform(header) {
        xform := abc_input_xform_get(parent, nom);
        next_object = xform;
    }
    sinon {
        /* Ignore. */
    }

    si abc_input_object_valid(next_object) {
        pour abc_input_object_get_num_children(next_object) {
            header = abc_input_object_get_child_header(next_object, it);
            traverse_hiérarchie(next_object, header, résultat);
        }
    }
}

convertis_polymesh :: fonc (archive: *Abc_Output_Archive, racine: *Abc_Output_Xform, polymesh: *Abc_Input_PolyMesh, ts_parent: Abc_Time_Sample_Index)
{
    nom := abc_input_object_get_full_name(polymesh);

    schema := get_schema(polymesh);
    time_sampling := get_time_sampling(schema);

    num_samples := get_num_samples(schema);

    chaine_chemin_polymesh := nom;
    chemin_polymesh := CheminFichier(chaine_chemin_polymesh);

    chemin_parent_polymesh := chemin_parent(chemin_polymesh);

    nom_polymesh := nom_fichier(chemin_polymesh);
    nom_parent := nom_fichier(chemin_parent_polymesh);

    ts_subd := create_time_sampling(archive, time_sampling);
    matrice_subd := crée_xform_neutre_pour_objet(racine, nom_parent, ts_parent);
    subd := abc_output_subd_create(matrice_subd, nom_polymesh, ts_subd);

    uvs_param := get_uvs_param(schema);
    si valid(uvs_param) {
        metadata := get_metadata(uvs_param);
        abc_source_name := abc_get_source_name(metadata);
        diffère destroy(*abc_source_name);

        source_name := vers_kuri(abc_source_name);
        set_uv_source_name(subd, source_name);
    }

    pour num_samples {
        sample_time := get_sample_time(time_sampling, it comme z64);

        selector: Abc_Sample_Selector;
        selector.requested_index = -1;
        selector.requested_time = sample_time;

        sample := get(schema, selector);
        diffère destroy(sample);

        points := get_positions(sample);
        velocities := get_velocities(sample);
        face_indices := get_face_indices(sample);
        face_counts := get_face_counts(sample);

        subd_sample := sample_create(subd);
        diffère destroy(subd_sample);

        set_positions(subd_sample, points);
        set_face_indices(subd_sample, face_indices);
        set_face_counts(subd_sample, face_counts);

        si velocities.values {
            set_velocities(subd_sample, velocities);
        }

        si valid(uvs_param) {
            input_uvs: Abc_Input_V2f_Geom_Param_Sample;

            si is_indexed(uvs_param) {
                get_indexed(uvs_param, *input_uvs, selector);
            }
            sinon {
                get_expanded(uvs_param, *input_uvs, selector);
            }

            output_uvs: Abc_Output_V2f_Geom_Param_Sample;
            output_uvs.values = input_uvs.values;
            output_uvs.indices = input_uvs.indices;
            output_uvs.scope = input_uvs.scope;
            set_uvs(subd_sample, output_uvs);
        }

        sample_set(subd, subd_sample);
    }

    faceset_names := get_faceset_names(schema);

    pour faceset_names {
        input_faceset := get_faceset(schema, it);
        faceset_schema := get_schema(input_faceset);

        ts_faceset := get_time_sampling(faceset_schema);
        ts_output_facest := create_time_sampling(archive, ts_faceset);

        num_samples_faceset := get_num_samples(faceset_schema);

        output_faceset := create_faceset(subd, it);
        schema_set_time_sampling(output_faceset, ts_output_facest);

        exclusivity := get_face_exclusivity(faceset_schema);
        schema_set_face_exclusivity(output_faceset, exclusivity);

        output_sample := sample_create(output_faceset);
        diffère destroy(output_sample);

        pour sample_index dans num_samples_faceset {
            reset(output_sample);

            selector: Abc_Sample_Selector;
            selector.requested_index = sample_index comme z64;

            faceset_sample := get(faceset_schema, selector);
            diffère destroy(faceset_sample);

            faces := get_faces(faceset_sample);
            set_faces(output_sample, faces);

            self_bounds := get_self_bounds(faceset_sample);
            abc_output_faceset_schema_sample_set_self_bounds(output_sample, *self_bounds);

            sample_set(output_faceset, output_sample);
        }
    }
}

get_faceset_names :: fonc (schema: *Abc_Input_PolyMesh_Schema) -> []Abc_String
{
    résultat: []Abc_String;
    get_faceset_names(schema, *résultat.données, *résultat.taille comme *n64);
    retourne résultat;
}

imprime_time_sampling :: fonc (time_sampling: *Abc_Time_Sampling)
{
    num_stored_times := get_num_stored_times(time_sampling);

    times: [..]r64;
    tableau_redimensionne(*times, num_stored_times comme z64);

    get_stored_times(time_sampling, *times.données, *times.taille comme *n64);

    imprimeln("% times", times.taille);
    pour times {
        imprimeln("-- %", it);
    }

    time_sampling_type: Abc_Time_Sampling_Type;
    get_time_sampling_type(time_sampling, *time_sampling_type);

    imprimeln("%", time_sampling_type);
}

create_time_sampling :: fonc (archive: *Abc_Output_Archive, time_sampling: *Abc_Time_Sampling) -> Abc_Time_Sample_Index
{
    times: *r64;
    num_times: n64;
    get_stored_times(time_sampling, *times, *num_times);

    time_sampling_type: Abc_Time_Sampling_Type;
    get_time_sampling_type(time_sampling, *time_sampling_type);

    retourne create_time_sampling(archive, times, num_times, time_sampling_type.time_per_cycle);
}

valide_sample :: fonc (sample: *Abc_Input_PolyMesh_Schema_Sample)
{
    donne_tranche :: fonc (sample: Abc_Int32_Array_Sample) -> []z32
    {
        résultat: []z32 = ---;
        résultat.données = sample.values;
        résultat.taille = sample.num_values comme z64;
        retourne résultat;
    }

    face_indices := sample_get_face_indices(sample);
    face_counts := sample_get_face_counts(sample);

    vertex_vues: [..]z32;
    diffère déloge(*vertex_vues);

    tranche_face_counts := donne_tranche(face_counts);
    tranche_face_indices := donne_tranche(face_indices);

    indice_face_index := 0;

    pour compte, indice_compte dans tranche_face_counts {
        si compte == 0 {
            imprimeln("Un polygone a zéro vertex !\n");
            arrête;
        }

        vertex_vues.taille = 0;

        duplication := faux;

        pour nombre_de_coins dans compte {
            vertex_index := tranche_face_indices[indice_face_index];

            si ensemble_possède(vertex_vues, vertex_index) {
                duplication = vrai;
            }
            ensemble_ajoute(*vertex_vues, vertex_index);
            indice_face_index += 1;
        }

        si duplication {
            indice_face_index -= compte;

            imprimeln("-- face % contient des vertex en double", indice_compte);

            pour nombre_de_coins dans compte {
                imprime("   %", tranche_face_indices[indice_face_index]);
                indice_face_index += 1;
            }
            imprime("\n");
        }
    }
}
