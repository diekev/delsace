importe Fondation;
importe Math;

/* La bibliothèque Alembic. */
libabc :: #bibliothèque "Alembic";

/* La bibliothèque de notre interface. */

#dépendance_bibliothèque libalembic libabc;

charge "interface_alembic";

ABC_crée_lectrice_cache :: fonc (ctx_kuri: *ContexteKuri, archive: *ArchiveCache, chemin: chaine) -> *LectriceCache
{
    retourne ABC_cree_lectrice_cache(ctx_kuri, archive, chemin.caractères, chemin.taille comme n64);
}

vers_abc_string :: fonc (chn: chaine) -> Abc_String
{
    retourne Abc_String(chn.caractères, chn.taille comme n64);
}

vers_kuri :: fonc (chn: Abc_String) -> chaine
{
    retourne chaine(chn.characters, chn.size comme z64);
}

opérateur == :: (a: Abc_String, b: chaine) -> bool
{
    retourne vers_kuri(a) == b;
}

vers_abc_half :: fonc (v: r16) -> Abc_Half
{
    résultat: Abc_Half = ---;
    copie_mem_nonsur(src = *v, dst = *résultat.value, taille = 2);
    retourne résultat;
}

vers_abc_half :: fonc (v: r32) -> Abc_Half
{
    retourne vers_abc_half(v comme r16);
}

vers_r16 :: fonc (v: Abc_Half) -> r16
{
    résultat: r16 = ---;
    copie_mem_nonsur(dst = *résultat, src = *v.value, taille = 2);
    retourne résultat;
}

/* ------------------------------------------------------------------------- */
/** \nom Contexte Kuri pour Alembic
 * \{ */

ctx_kuri_pour_alembic := initialise_contexte_kuri();

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Création et destruction d'autrices d'archives.
 * \{ */

crée_autrice_archive :: fonc (ctx: *ContexteCreationArchive, ctx_ecriture: *ContexteEcritureCache) -> Optionnel(*AutriceArchive)
{
    résultat := ABC_cree_autrice_archive(*ctx_kuri_pour_alembic, ctx, ctx_ecriture);
    saufsi résultat {
        retourne;
    }

    retourne résultat;
}

/* Écris les données de tous les écrivains dans l'archive. */
écris_données :: fonc (autrice: *AutriceArchive)
{
    ABC_ecris_donnees(autrice);
}

/* Ferme et détruit l'archive. Si l'archive fut ouverte pour écriture, les
 * données y seront alors écrites. */
détruit_autrice :: fonc (autrice: *AutriceArchive)
{
    ABC_detruit_autrice(*ctx_kuri_pour_alembic, autrice);
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Création d'objets pour l'export.
 * \{ */

crée_écrivain_objet :: fonc (autrice: *AutriceArchive, parent: *EcrivainCache, nom: chaine, type_objet: eTypeObjetAbc, données: *rien) -> Optionnel(*EcrivainCache)
{
    résultat := ABC_cree_ecrivain_cache(*ctx_kuri_pour_alembic, autrice, parent, nom.caractères, nom.taille comme n64, données, type_objet);
    saufsi résultat {
        retourne;
    }

    retourne résultat;
}

crée_écrivain_objet_racine :: fonc (autrice: *AutriceArchive, nom: chaine, type_objet: eTypeObjetAbc, données: *rien) -> Optionnel(*EcrivainCache)
{
    retourne crée_écrivain_objet(autrice, nul, nom, type_objet, données);
}

crée_écrivain_instance :: fonc (autrice: *AutriceArchive, parent: *EcrivainCache, origine: *EcrivainCache, nom: chaine) -> Optionnel(*EcrivainCache)
{
    résultat := ABC_cree_instance(*ctx_kuri_pour_alembic, autrice, parent, origine, nom.caractères, nom.taille comme n64);
    saufsi résultat {
        retourne;
    }
    retourne résultat;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Import.
 * \{ */

abc_input_archive_create :: fonc (chemin: chaine) -> *Abc_Input_Archive
{
    chemin_abc := vers_abc_string(chemin);
    retourne abc_input_archive_create(*ctx_kuri_pour_alembic, *chemin_abc, 1);
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Export.
 * \{ */

abc_output_archive_create :: fonc (chemin: chaine) -> *Abc_Output_Archive
{
    metadata: Abc_Output_Archive_Metadata;
    retourne abc_output_archive_create(chemin, *metadata);
}

abc_output_archive_create :: fonc (chemin: chaine, metadata: *Abc_Output_Archive_Metadata) -> *Abc_Output_Archive
{
    ctx_kuri := *ctx_kuri_pour_alembic;
    retourne abc_output_archive_create(ctx_kuri, vers_abc_string(chemin), metadata);
}

abc_output_archive_create_time_sampling :: fonc (archive: *Abc_Output_Archive, échantillons: []r64, temps_par_cycle: r64) -> Abc_Time_Sample_Index
{
    retourne abc_output_archive_create_time_sampling(archive, échantillons.données, échantillons.taille comme n64, temps_par_cycle);
}

abc_output_xform_create :: fonc (parent: *Abc_Output_Xform, nom: chaine, ts: Abc_Time_Sample_Index) -> *Abc_Output_Xform
{
    retourne abc_output_xform_create(parent, vers_abc_string(nom), ts);
}

abc_output_points_create :: fonc (parent: *Abc_Output_Xform, nom: chaine, ts: Abc_Time_Sample_Index) -> *Abc_Output_Points
{
    retourne abc_output_points_create(parent, vers_abc_string(nom), ts);
}

abc_output_points_sample_positions_set :: fonc (sample: *Abc_Output_Points_Sample, positions: []Vec3)
{
    array_sample: Abc_P3f_Array_Sample = ---;
    array_sample.values = positions.données comme *Abc_V3f;
    array_sample.num_values = positions.taille comme n64;
    abc_output_points_sample_positions_set(sample, array_sample);
}

abc_output_points_sample_ids_set :: fonc (sample: *Abc_Output_Points_Sample, ids: []n64)
{
    array_sample: Abc_UInt64_Array_Sample = ---;
    array_sample.values = ids.données;
    array_sample.num_values = ids.taille comme n64;
    abc_output_points_sample_ids_set(sample, array_sample);
}

