}

set_widths :: fonc (sample: *Abc_Output_Curves_Schema_Sample, values: []r32, scope: Abc_Geometry_Scope)
{
    geom_param: Abc_Output_Float_Geom_Param_Sample;
    geom_param.values.values = values.données;
    geom_param.values.num_values = values.taille comme n64;
    geom_param.scope = scope;
    set_widths(sample, geom_param);
}

