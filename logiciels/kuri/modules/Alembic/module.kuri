importe Fondation;
importe Math;

/* La bibliothèque Alembic. */
libabc :: #bibliothèque "Alembic";

/* La bibliothèque de notre interface. */

#dépendance_bibliothèque libalembic libabc;

charge "interface_alembic";

vers_kuri :: fonc (chn: Abc_New_String) -> chaine
{
    retourne chaine(chn.characters, chn.size comme z64);
}

vers_abc_half :: fonc (v: r16) -> Abc_Half
{
    résultat: Abc_Half = ---;
    copie_mem_nonsur(src = *v, dst = *résultat.value, taille = 2);
    retourne résultat;
}

vers_abc_half :: fonc (v: r32) -> Abc_Half
{
    retourne vers_abc_half(v comme r16);
}

vers_r16 :: fonc (v: Abc_Half) -> r16
{
    résultat: r16 = ---;
    copie_mem_nonsur(dst = *résultat, src = *v.value, taille = 2);
    retourne résultat;
}

/* ------------------------------------------------------------------------- */
/** \nom Contexte Kuri pour Alembic
 * \{ */

ctx_kuri_pour_alembic := initialise_contexte_kuri();

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Import.
 * \{ */

abc_input_archive_create :: fonc (chemin: chaine) -> *Abc_Input_Archive
{
    chemin_abc := chemin;
    retourne abc_input_archive_create(*ctx_kuri_pour_alembic, *chemin_abc, 1);
}

get_full_name :: fonc (object: Abc_Generic_Input_Object) -> chaine
{
    retourne abc_input_object_get_full_name(object);
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Export.
 * \{ */

abc_output_archive_create :: fonc (chemin: chaine) -> *Abc_Output_Archive
{
    metadata: Abc_Output_Archive_Metadata;
    retourne abc_output_archive_create(chemin, *metadata);
}

abc_output_archive_create :: fonc (chemin: chaine, metadata: *Abc_Output_Archive_Metadata) -> *Abc_Output_Archive
{
    ctx_kuri := *ctx_kuri_pour_alembic;
    retourne abc_output_archive_create(ctx_kuri, chemin, metadata);
}

create_time_sampling :: fonc (archive: *Abc_Output_Archive, échantillons: []r64, temps_par_cycle: r64) -> Abc_Time_Sample_Index
{
    retourne create_time_sampling(archive, échantillons.données, échantillons.taille comme n64, temps_par_cycle);
}

set_positions :: fonc (sample: *Abc_Output_Points_Schema_Sample, positions: []Vec3)
{
    array_sample: Abc_P3f_Array_Sample = ---;
    array_sample.values = positions.données comme *Abc_V3f;
    array_sample.num_values = positions.taille comme n64;
    set_positions(sample, array_sample);
}

set_ids :: fonc (sample: *Abc_Output_Points_Schema_Sample, ids: []n64)
{
    array_sample: Abc_UInt64_Array_Sample = ---;
    array_sample.values = ids.données;
    array_sample.num_values = ids.taille comme n64;
    set_ids(sample, array_sample);
}

set_positions :: fonc (sample: *Abc_Output_Curves_Schema_Sample, positions: []Vec3)
