crée_xform_neutre_pour_objet :: fonc (parent: *Abc_Output_Xform, nom: chaine, ts: Abc_Time_Sample_Index) -> *Abc_Output_Xform
{
    résultat := abc_output_xform_create(parent, nom, ts);

    matrix_sample := abc_output_xform_sample_create(résultat);
    diffère abc_output_xform_sample_destroy(matrix_sample);

    matrix: Abc_M44d;
    matrix.x[0][0] = 1.0;
    matrix.x[1][1] = 1.0;
    matrix.x[2][2] = 1.0;
    matrix.x[3][3] = 1.0;

    abc_output_xform_sample_set_matrix(matrix_sample, *matrix);

    abc_output_xform_sample_set(résultat, matrix_sample);

    retourne résultat;
}

/** \} */
