
Syntaxeuse :: struct {
    lexèmes: []Lexème;
    assembleuse: AssembleuseArbre;

    position := 0;

    erreurs: [..]chaine;

    est_extension := faux;
    fichier_étendu := "";

    inclusions: [..]*NoeudSyntaxique;
}

construis_syntaxeuse :: fonc (lexèmes: []Lexème) -> Syntaxeuse
{
    syntaxeuse: Syntaxeuse;
    syntaxeuse.lexèmes = lexèmes;
    syntaxeuse.assembleuse = construis_assembleuse();

    retourne syntaxeuse;
}

détruit_syntaxeuse :: fonc (syntaxeuse: *Syntaxeuse)
{
    déloge(*syntaxeuse.erreurs);
    déloge(*syntaxeuse.inclusions);
}

lexème_courant :: fonc (syntaxeuse: *Syntaxeuse) -> TypeLexème
{
    retourne syntaxeuse.lexèmes[syntaxeuse.position].type_lexème;
}

avance :: fonc (syntaxeuse: *Syntaxeuse) -> rien
{
    syntaxeuse.position += 1;
}

recule :: fonc (syntaxeuse: *Syntaxeuse) -> rien
{
    syntaxeuse.position -= 1;
}

consomme :: fonc (syntaxeuse: *Syntaxeuse, type: TypeLexème) -> bool
{
    t := lexème_courant(syntaxeuse);
    avance(syntaxeuse);
    retourne t == type;
}

apparie :: fonc (syntaxeuse: *Syntaxeuse, type: TypeLexème) -> bool
{
    retourne lexème_courant(syntaxeuse) == type;
}

données :: fonc (syntaxeuse: *Syntaxeuse) -> *Lexème
{
    retourne *syntaxeuse.lexèmes[syntaxeuse.position - 1];
}

position :: fonc (syntaxeuse: *Syntaxeuse) -> z32
{
    retourne syntaxeuse.position - 1;
}

fini :: fonc (syntaxeuse: *Syntaxeuse) -> bool
{
    retourne syntaxeuse.position >= syntaxeuse.lexèmes.taille || possède_erreurs(syntaxeuse);
}

possède_erreurs :: fonc (syntaxeuse: *Syntaxeuse) -> bool
{
    retourne syntaxeuse.erreurs.taille != 0;
}

performe_syntaxage :: fonc (syntaxeuse: *Syntaxeuse) -> rien
{
    saufsi syntaxeuse.lexèmes {
        retourne;
    }

    syntaxeuse.position = 0;

    données_lexème: Lexème;
    _ := empile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC, *données_lexème);

    analyse_page(syntaxeuse);

    attends_type(*syntaxeuse.assembleuse, TypeNoeud.BLOC);
}

analyse_page :: fonc (syntaxeuse: *Syntaxeuse) -> rien
{
    tantque !fini(syntaxeuse) {
        si apparie(syntaxeuse, TypeLexème.CHAINE_CARACTÈRE) {
            avance(syntaxeuse);
            ajoute_noeud(*syntaxeuse.assembleuse, TypeNoeud.CHAINE_CARACTÈRE, données(syntaxeuse));
        }
        sinon si apparie(syntaxeuse, TypeLexème.DÉBUT_CONTROLE) {
            analyse_controle(syntaxeuse);
        }
        sinon si apparie(syntaxeuse, TypeLexème.DÉBUT_VARIABLE) {
            avance(syntaxeuse);

            si !apparie_expression(syntaxeuse) {
                rapporte_erreur(syntaxeuse, "attendu une expression après '{{'");
                retourne;
            }

            expr := analyse_expression(syntaxeuse);
            ajoute_noeud(*syntaxeuse.assembleuse, expr);

            si !consomme(syntaxeuse, TypeLexème.FIN_VARIABLE) {
                rapporte_erreur(syntaxeuse, "Attendu '}}' à la fin de la déclaration d'une variable");
                retourne;
            }
        }
        sinon {
            rapporte_erreur(syntaxeuse, "Lexème inattendu");
            retourne;
        }
    }
}

analyse_controle :: fonc (syntaxeuse: *Syntaxeuse) -> rien
{
    si !consomme(syntaxeuse, TypeLexème.DÉBUT_CONTROLE) {
        rapporte_erreur(syntaxeuse, "Attendu '{%'");
        retourne;
    }

    si apparie(syntaxeuse, TypeLexème.SI) {
        analyse_si(syntaxeuse);
    }
    sinon si apparie(syntaxeuse, TypeLexème.POUR) {
        analyse_pour(syntaxeuse);
    }
    sinon si apparie(syntaxeuse, TypeLexème.ÉTEND) {
        avance(syntaxeuse);

        si !consomme(syntaxeuse, TypeLexème.CHAINE_CARACTÈRE) {
            rapporte_erreur(syntaxeuse, "Attendu une chaîne de caractère après 'étend'");
            retourne;
        }

        nom_fichier := données(syntaxeuse).chn;

        syntaxeuse.est_extension = vrai;
        syntaxeuse.fichier_étendu = nom_fichier;

        si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
            rapporte_erreur(syntaxeuse, "Attendu '%}'");
            retourne;
        }
    }
    sinon si apparie(syntaxeuse, TypeLexème.INCLUS) {
        avance(syntaxeuse);

        si !consomme(syntaxeuse, TypeLexème.CHAINE_CARACTÈRE) {
            rapporte_erreur(syntaxeuse, "Attendu une chaîne de caractère après 'inclus'");
            retourne;
        }

        noeud := empile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC, données(syntaxeuse));
        dépile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC);

        nom_fichier := données(syntaxeuse).chn;
        noeud.nom = nom_fichier;

        tableau_ajoute(*syntaxeuse.inclusions, noeud);

        si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
            rapporte_erreur(syntaxeuse, "Attendu '%}'");
            retourne;
        }
    }
    sinon si apparie(syntaxeuse, TypeLexème.BLOC) {
        avance(syntaxeuse);
        noeud := empile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC, données(syntaxeuse));

        si !consomme(syntaxeuse, TypeLexème.CHAINE_CARACTÈRE) {
            rapporte_erreur(syntaxeuse, "Attendu une chaîne de caractère après 'bloc'");
            retourne;
        }

        nom_bloc := données(syntaxeuse).chn;
        noeud.nom = nom_bloc;

        si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
            rapporte_erreur(syntaxeuse, "Attendu '%}'");
            retourne;
        }
    }
    sinon si apparie(syntaxeuse, TypeLexème.SINON) {
        //assert(noeud_courant(*syntaxeuse.assembleuse) == "SI")
        avance(syntaxeuse);

        si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
            rapporte_erreur(syntaxeuse, "Attendu '%}'");
            retourne;
        }

        dépile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC);

        attends_type(*syntaxeuse.assembleuse, TypeNoeud.SI);

        _ := empile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC, données(syntaxeuse));

        analyse_page(syntaxeuse);
    }
    sinon si apparie(syntaxeuse, TypeLexème.FINSI) {
        avance(syntaxeuse);

        dépile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC);

        dépile_noeud(*syntaxeuse.assembleuse, TypeNoeud.SI);

        si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
            rapporte_erreur(syntaxeuse, "Attendu '%}'");
            retourne;
        }
    }
    sinon si apparie(syntaxeuse, TypeLexème.FINPOUR) {
        avance(syntaxeuse);

        dépile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC);

        dépile_noeud(*syntaxeuse.assembleuse, TypeNoeud.POUR);

        si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
            rapporte_erreur(syntaxeuse, "Attendu '%}'");
            retourne;
        }
    }
    sinon si apparie(syntaxeuse, TypeLexème.FINBLOC) {
        avance(syntaxeuse);

        dépile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC);

        si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
            rapporte_erreur(syntaxeuse, "Attendu '%}'");
            retourne;
        }
    }
    sinon {
        rapporte_erreur(syntaxeuse, "Identifiant inconnu");
        retourne;
    }
}

analyse_si :: fonc (syntaxeuse: *Syntaxeuse) -> rien
{
    si !consomme(syntaxeuse, TypeLexème.SI) {
        rapporte_erreur(syntaxeuse, "Attendu 'si'");
        retourne;
    }

    _ := empile_noeud(*syntaxeuse.assembleuse, TypeNoeud.SI, données(syntaxeuse));

    expr_variable := analyse_expression(syntaxeuse);
    ajoute_noeud(*syntaxeuse.assembleuse, expr_variable);

    si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
        rapporte_erreur(syntaxeuse, "Attendu '%}'");
        retourne;
    }

    _ := empile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC, données(syntaxeuse));

    analyse_page(syntaxeuse);
}

analyse_pour :: fonc (syntaxeuse: *Syntaxeuse) -> rien
{
    si !consomme(syntaxeuse, TypeLexème.POUR) {
        rapporte_erreur(syntaxeuse, "Attendu 'pour'");
        retourne;
    }

    _ := empile_noeud(*syntaxeuse.assembleuse, TypeNoeud.POUR, données(syntaxeuse));

    expr_variable := analyse_expression(syntaxeuse);
    ajoute_noeud(*syntaxeuse.assembleuse, expr_variable);

    si !consomme(syntaxeuse, TypeLexème.DANS) {
        rapporte_erreur(syntaxeuse, "Attendu 'dans'");
        retourne;
    }

    expr_dans := analyse_expression(syntaxeuse);
    ajoute_noeud(*syntaxeuse.assembleuse, expr_dans);

    si !consomme(syntaxeuse, TypeLexème.FIN_CONTROLE) {
        rapporte_erreur(syntaxeuse, "Attendu '%}'");
        retourne;
    }

    _ := empile_noeud(*syntaxeuse.assembleuse, TypeNoeud.BLOC, données(syntaxeuse));

    analyse_page(syntaxeuse);
}

rapporte_erreur :: fonc (syntaxeuse: *Syntaxeuse, message: chaine)
{
    avance(syntaxeuse);

    enchaineuse: Enchaineuse;
    initialise_enchaineuse(*enchaineuse);

    lexème := données(syntaxeuse);

    imprime_dans_enchaineuse(*enchaineuse, "ligne %, % : %", lexème.ligne, message, lexème.chn);

    message_erreur := chaine_depuis_enchaineuse(*enchaineuse);

    tableau_ajoute(*syntaxeuse.erreurs, message_erreur);
}

apparie_expression :: fonc (syntaxeuse: *Syntaxeuse) -> bool
{
    lexème := lexème_courant(syntaxeuse);

    si lexème == TypeLexème.CHAINE_CARACTÈRE {
        retourne vrai;
    }

    retourne faux;
}

apparie_expression_secondaire :: fonc (syntaxeuse: *Syntaxeuse) -> bool
{
    lexème := lexème_courant(syntaxeuse);

    si lexème == TypeLexème.POINT {
        retourne vrai;
    }

    retourne faux;
}

analyse_expression :: fonc (syntaxeuse: *Syntaxeuse, précédence : z32 = 0) -> *NoeudSyntaxique
{
    expr := analyse_expression_primaire(syntaxeuse);

    tantque apparie_expression_secondaire(syntaxeuse) {
        si précédence == 1 {
            arrête;
        }

        expr = analyse_expression_secondaire(syntaxeuse, expr);
    }

    retourne expr;
}

analyse_expression_primaire :: fonc (syntaxeuse: *Syntaxeuse) -> *NoeudSyntaxique
{
    lexème := lexème_courant(syntaxeuse);

    si lexème == TypeLexème.CHAINE_CARACTÈRE {
        avance(syntaxeuse);

        noeud := crée_noeud(*syntaxeuse.assembleuse, TypeNoeud.VARIABLE, données(syntaxeuse));

        retourne noeud;
    }

    retourne nul;
}

analyse_expression_secondaire :: fonc (syntaxeuse: *Syntaxeuse, gauche: *NoeudSyntaxique) -> *NoeudSyntaxique
{
    lexème := lexème_courant(syntaxeuse);

    si lexème == TypeLexème.POINT {
        avance(syntaxeuse);

        noeud := crée_noeud(*syntaxeuse.assembleuse, TypeNoeud.ACCÈS_RUBRIQUE, données(syntaxeuse));
        droite := analyse_expression(syntaxeuse, 1);

        ajoute_noeud(noeud, gauche);
        ajoute_noeud(noeud, droite);

        retourne noeud;
    }

    retourne nul;
}
