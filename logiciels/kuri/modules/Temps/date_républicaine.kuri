temps_millis_depuis_époque :: fonc (date: Date) -> z64
{
    millis_jours := days_from_civil(date) * Constantes(z64).MILLISECONDES_PAR_JOUR;
    retourne millis_jours + date.heure * 60 * 60 * 1000 + date.minute * 60 * 1000 + date.seconde * 1000;
}

// https://gist.github.com/jamesgdahl/1ef2a458fa6fb9d54b437f5d816792b2
donne_date_républicaine :: fonc (moment: Date) -> Date
{
    raisin := Date(jour = 22, mois = 9, année = 1792);

    moment_relatif := temps_millis_depuis_époque(moment) - temps_millis_depuis_époque(raisin);

    millisecondes_par_jour :: Constantes(z64).MILLISECONDES_PAR_JOUR;
    QUANTITÉ_INTERCALÉE :: 20925216;
    DÉBUT_ÉQUINOXE :: 34284216;

    résultat: Date;

    maintenant := (moment_relatif % millisecondes_par_jour) comme z32;
    résultat.heure = maintenant / (60 * 60 * 1000);
    résultat.minute = (maintenant - résultat.heure * (60 * 60 * 1000)) / (60 * 1000);
    résultat.seconde = (maintenant - résultat.heure * (60 * 60 * 1000) - résultat.minute * (60 * 1000)) / 1000;

    jours := moment_relatif / millisecondes_par_jour;
    jours_passés := jours - 1;
    années_non_ajustées := jours / 365;
    années_bissextiles := ((QUANTITÉ_INTERCALÉE * années_non_ajustées) + DÉBUT_ÉQUINOXE) / millisecondes_par_jour;
    années_bissextiles_passées := ((QUANTITÉ_INTERCALÉE * jours_passés / 365) + DÉBUT_ÉQUINOXE) / millisecondes_par_jour;
    est_jour_intercalaire := années_bissextiles_passées != années_bissextiles;
    résultat.année = ((jours - années_bissextiles) / 365) comme z32;

    jours_année := (jours - années_bissextiles) % 365;
    si est_jour_intercalaire {
        jours_année += 1;
    }

    résultat.année += 1; // L'année démarre à l'an 1
    résultat.jour = ((jours_année % 30) + 1) comme z32; // Le calendrier commence au jour 1
    résultat.mois = (jours_année / 30) comme z32;

    retourne résultat;
}

chaine_chiffre_romain :: fonc (n: z32) -> chaine
{
    assert(n >= 0 && n < 1000);

    chn_unités := [ "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX" ];
    chn_dizaines := [ "X", "XX", "XXX", "XL", "L", "LX", "LXX", "LXXX", "XC" ];
    chn_centaines := [ "C", "CC", "CCC", "CD", "D", "DC", "DCC", "DCCC", "CM" ];

    unités := n % 10;
    dizaines := (n / 10) % 10;
    centaines := (n / 100) % 10;

    retourne enchaine(chn_centaines[centaines - 1], chn_dizaines[dizaines - 1], chn_unités[unités - 1]);
}

donne_chaine_date_républicaine :: fonc (date: Date) -> chaine
{
    chn_jour := [ "Primidi", "Duodi", "Tridi", "Quartidi", "Quintidi", "Sextidi", "Septidi", "Octidi", "Nonidi", "Décadi" ];
    chn_mois := [ "Vendémiaire", "Brumaire", "Frimaire", "Nivôse", "Pluviôse", "Ventôse", "Germinal", "Floréal", "Prairial", "Messidor", "Thermidor", "Fructidor" ];

    chaine_année := chaine_chiffre_romain(date.année);
    diffère déloge(*chaine_année);

    retourne imprime_chaine("% % % An %", chn_jour[(date.jour - 1) % 10], date.jour, chn_mois[date.mois], chaine_chiffre_romain(date.année));
}
