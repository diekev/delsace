/* ------------------------------------------------------------------------- */
/** \nom Évènement
 * \{ */

Type_Évènement :: énum {
    NON_INITIALISÉ;
    FERMETURE;
    ENTRÉE_FENÊTRE;
    SORTIE_FENÊTRE;
    SOURIS;
    CLAVIER;
    DÉPOSAGE;
    // Tablette
    // Window
    // Molette séparée de souris ?
    // Entrée texte séparée de clavier hors IME ?
}

Évènement :: struct {
    type: Type_Évènement;
    id_fenêtre: z32;

    /* Pour les évènements souris. */
    état_souris: État_Souris;
    action_souris: Action_Souris;
    bouton_souris: Bouton_Souris;
    /* Delta pour la molette. */
    delta_souris: z32;

    /* Pour les évènements clavier. */
    touche: Touche_Clavier;
    modificateurs: Modificateur_Clavier;
    touche_pressée: bool;
    est_répétée: bool;
    texte: chaine;
    compte: z32;
    code_scan_natif: n32;
    modificateurs_natifs: n32;
    clé_virtuelle_native: n32;

    /* Mimes pour un déposer. */
    mimes: [..]DonnéesMime;
}

donne_clic_souris :: fonc (empl évènement: *Évènement) -> Clic_Souris
{
    clic: Clic_Souris = ---;
    clic.état = état_souris;
    clic.action = action_souris;
    clic.bouton = bouton_souris;
    clic.delta = delta_souris;
    retourne clic;
}

initialise_depuis_clic :: fonc (évènement: *Évènement, clic: Clic_Souris)
{
    évènement.type = Type_Évènement.SOURIS;
    évènement.état_souris = clic.état;
    évènement.bouton_souris = clic.bouton;
    évènement.delta_souris = clic.delta;
    évènement.action_souris = clic.action;
}

donne_raccourci :: fonc (évènement: *Évènement) -> Raccourci_Clavier
{
    résultat: Raccourci_Clavier = ---;
    résultat.touche = évènement.touche;
    résultat.modificateur  = évènement.modificateurs;
    retourne résultat;
}

/** \} */
