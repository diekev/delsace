InstructionDéfinisLocale :: struct {
    empl inst: Instruction;
    type = #type_de_cette_structure;

    nom: ECMAString;

    indice_chaine_en_cache : z32 = -1;
}

donne_chaine_primitive :: fonc (instruction: *InstructionDéfinisLocale, realm: *Realm) -> *PrimitiveChaine
{
    si instruction.indice_chaine_en_cache == -1 {
        pour realm.chaines {
            si it.texte == instruction.nom {
                instruction.indice_chaine_en_cache = indice_it comme z32;
                retourne it;
            }
        }

        résultat := crée_chaine(realm, instruction.nom);
        instruction.indice_chaine_en_cache = realm.chaines.taille comme z32 - 1;
        retourne résultat;
    }

    retourne realm.chaines[instruction.indice_chaine_en_cache];
}

InstructionChargeLocale :: struct {
    empl inst: Instruction;
    type = #type_de_cette_structure;

    nom: ECMAString;

    indice_chaine_en_cache : z32 = -1;
}

donne_chaine_primitive :: fonc (instruction: *InstructionChargeLocale, realm: *Realm) -> *PrimitiveChaine
{
    si instruction.indice_chaine_en_cache == -1 {
        pour realm.chaines {
            si it.texte == instruction.nom {
                instruction.indice_chaine_en_cache = indice_it comme z32;
                retourne it;
            }
        }

        résultat := crée_chaine(realm, instruction.nom);
        instruction.indice_chaine_en_cache = realm.chaines.taille comme z32 - 1;
        retourne résultat;
    }

    retourne realm.chaines[instruction.indice_chaine_en_cache];
}

