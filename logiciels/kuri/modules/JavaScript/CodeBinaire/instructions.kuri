donne_arguments :: fonc (appel: *InstructionAppel) -> []Registre
{
    résultat: []Registre;
    résultat.données = ((appel + 1) comme *octet) comme *Registre;
    résultat.taille = appel.nombre_arguments;
    retourne résultat;
}

