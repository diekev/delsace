alloue_registre :: fonc (empl génératrice: *GénératriceCodeBinaire) -> Registre
{
    résultat := Registre(flux.registres);
    flux.registres += 1;
    retourne résultat;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Génération de code pour les noeuds.
 * \{ */

array_literal_sur_code_binaire :: fonc (noeud: *ArrayLiteral, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := crée_crée_array(génératrice);
    reg_array := crée_stocke(génératrice);

    pour noeud.éléments {
        _ := génère_code_binaire(génératrice, it);
        crée_propriété_array(génératrice, reg_array, indice_it comme z32);
    }

    _ := crée_charge(génératrice, Valeur(Number = noeud.éléments.taille comme r64));
    opt_reg := crée_stocke(génératrice);
    crée_charge_registre(génératrice, reg_array);

    // À FAIRE : appèle set directement
    // 2. Perform ? Set(array, "length", 𝔽(len), true).
    crée_définis_member(génératrice, STR_length, opt_reg);

    retourne Registre(0);
}

arrow_function_sur_code_binaire :: fonc (noeud: *ArrowFunction, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne crée_instancie_arrow_fonction(génératrice, noeud);
}

assignment_expression_sur_code_binaire :: fonc (noeud: *AssignmentExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    opt_reg: Optionnel(Registre);

    doit_lier_branche: bool;
    branche: IndiceBranche;

    discr noeud.opération {
        Assigne {
            opt_reg = compile_expression_assignée(noeud, génératrice);
            assert(possède_valeur(opt_reg));
        }
        EtLogique {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            branche = crée_branche_si_faux(génératrice);
            doit_lier_branche = vrai;

            opt_reg = compile_expression_assignée(noeud, génératrice);
            assert(possède_valeur(opt_reg));
        }
        OuLogique {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            branche = crée_branche_si_vrai(génératrice);
            doit_lier_branche = vrai;

            opt_reg = compile_expression_assignée(noeud, génératrice);
            assert(possède_valeur(opt_reg));
        }
        Coalesce {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            branche = crée_branche_saufsi_null_ou_undefined(génératrice);
            doit_lier_branche = vrai;

            opt_reg = compile_expression_assignée(noeud, génératrice);
            assert(possède_valeur(opt_reg));
        }
        Ajoute {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_ajoute(génératrice, reg_gauche);
        }
        Soustrait {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_soustrait(génératrice, reg_gauche);
        }
        Multiplie {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_multiplie(génératrice, reg_gauche);
        }
        Divise {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_divise(génératrice, reg_gauche);
        }
        Modulo {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_modulo(génératrice, reg_gauche);
        }
        DécalageGauche {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_décalage_gauche(génératrice, reg_gauche);
        }
        DécalageDroite {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_décalage_droite(génératrice, reg_gauche);
        }
        DécalageDroiteNaturel {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_décalage_droite_naturel(génératrice, reg_gauche);
        }
        EtBinaire {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_et_binaire(génératrice, reg_gauche);
        }
        OuBinaire {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_ou_binaire(génératrice, reg_gauche);
        }
        OuExBinaire {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_ou_exclusif(génératrice, reg_gauche);
        }
        Exponentiation {
            _ := génère_code_binaire(génératrice, noeud.gauche);
            reg_gauche := crée_stocke(génératrice);

            opt_reg = génère_code_binaire(génératrice, noeud.droite);
            assert(possède_valeur(opt_reg));

            opt_reg = crée_exponentiation(génératrice, reg_gauche);
        }
        sinon {
            panique("opération d'assignement non-implémenté pour %", noeud.opération);
        }
    }

    si noeud.gauche.type == Identifier {
        nom := (noeud.gauche comme *Identifier).nom;
        crée_définis_locale(génératrice, nom);
    }
    sinon si noeud.gauche.type == MemberExpression {
        member := noeud.gauche comme *MemberExpression;

        opt_reg = crée_stocke(génératrice);

        opt_reg_objet := génère_code_binaire(génératrice, member.objet);
        assert(possède_valeur(opt_reg_objet));

        saufsi member.calculé {
            assert(member.propriété.type == Identifier);
            identifier := member.propriété comme *Identifier;

            crée_définis_member(génératrice, identifier.nom, opt_reg.Quelque);
        }
        sinon {
            opt_reg_objet = crée_stocke(génératrice);
            _ := génère_code_binaire(génératrice, member.propriété);
            crée_définis_index(génératrice, opt_reg_objet.Quelque, opt_reg.Quelque);
        }

        /* Nous devons retourner la valeur assignée. */
        si opt_reg.Quelque comme n32 != 0 {
            crée_charge_registre(génératrice, opt_reg.Quelque);
            opt_reg = Registre(0);
        }
    }
    sinon {
        panique("non-implémenté");
    }


    si doit_lier_branche {
        définis_décalage_branche(génératrice, branche);
    }

    retourne opt_reg;
}

compile_expression_assignée :: fonc (noeud: *AssignmentExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    si is_anonymous_function_definition(noeud.droite) && is_identifier_ref(noeud.gauche) {
        assert(noeud.gauche.type == Identifier);
        lhs := (noeud.gauche comme *Identifier).nom;
        retourne crée_named_evaluation(génératrice, noeud.droite, lhs);
    }
    retourne génère_code_binaire(génératrice, noeud.droite);
}

binary_expression_sur_code_binaire :: fonc (expression: *BinaryExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    opt_reg_gauche := génère_code_binaire(génératrice, expression.gauche);
    assert(possède_valeur(opt_reg_gauche));
    gauche := crée_stocke(génératrice);
    opt_reg_droite := génère_code_binaire(génératrice, expression.droite);
    assert(possède_valeur(opt_reg_droite));

    discr expression.opération {
        Plus {
            retourne crée_ajoute(génératrice, gauche);
        }
        Moins {
            retourne crée_soustrait(génératrice, gauche);
        }
        Multiplie {
            retourne crée_multiplie(génératrice, gauche);
        }
        Divise {
            retourne crée_divise(génératrice, gauche);
        }
        Modulo {
            retourne crée_modulo(génératrice, gauche);
        }
        EtBinaire {
            retourne crée_et_binaire(génératrice, gauche);
        }
        OuBinaire {
            retourne crée_ou_binaire(génératrice, gauche);
        }
        OuExclusif {
            retourne crée_ou_exclusif(génératrice, gauche);
        }
        DécalageGauche {
            retourne crée_décalage_gauche(génératrice, gauche);
        }
        DécalageDroite {
            retourne crée_décalage_droite(génératrice, gauche);
        }
        DécalageDroiteNaturel {
            retourne crée_décalage_droite_naturel(génératrice, gauche);
        }
        Exponentiation {
            retourne crée_exponentiation(génératrice, gauche);
        }
    }

    panique("opérateur binaire non-implémenté pour %", expression.opération);
}

binary_not_sur_code_binaire :: fonc (noeud: *BinaryNot, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, noeud.argument);
    retourne crée_binary_not(génératrice);
}

block_statement_sur_code_binaire :: fonc (block: *BlockStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    résultat: Optionnel(Registre);
    pour block.enfants {
        résultat = génère_code_binaire(génératrice, it);
    }
    retourne résultat;
}

boolean_literal_sur_code_binaire :: fonc (noeud: *BooleanLiteral, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne crée_charge(génératrice, Valeur(Boolean = noeud.valeur));
}

break_statement_sur_code_binaire :: fonc (statement: *BreakStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    assert(statement.target == nul);
    label := donne_labels_boucle_courante(génératrice).id_label_break;
    branche := crée_branche(génératrice);
    ajoute_patch_label_branche(génératrice, label, branche);
}

call_expression_sur_code_binaire :: fonc (noeud: *CallExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    assert(noeud.appelé.type != CallExpression);

    reg_opt_func := génère_code_binaire(génératrice, noeud.appelé);
    assert(possède_valeur(reg_opt_func));
    reg_opt_func = crée_stocke(génératrice);

    this_value := crée_this_value_appel(génératrice, noeud.appelé);
    this_value = crée_stocke(génératrice);

    registres_arguments: [..]Registre;
    diffère déloge(*registres_arguments);

    pour noeud.arguments {
        reg_opt_arg := génère_code_binaire(génératrice, it);
        assert(possède_valeur(reg_opt_arg));
        reg_arg := crée_stocke(génératrice);
        tableau_ajoute(*registres_arguments, reg_arg);
    }

    si noeud.appelé.type == Identifier && (noeud.appelé comme *Identifier).nom == STR_eval {
        retourne crée_appel_eval(génératrice, reg_opt_func.Quelque, this_value, registres_arguments);
    }

    retourne crée_appel(génératrice, reg_opt_func.Quelque, this_value, registres_arguments);
}

catch_clause_sur_code_binaire :: fonc (catch: *CatchClause, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    saufsi catch.param {
        retourne génère_code_binaire(génératrice, catch.body);
    }

    assert(catch.param.type == Identifier);
    identifier := catch.param comme *Identifier;

    crée_entrée_bloc_catch(génératrice, identifier.nom);

    résultat := génère_code_binaire(génératrice, catch.body);

    crée_sortie_bloc_catch(génératrice);
    retourne résultat;
}

coalesce_sur_code_binaire :: fonc (noeud: *Coalesce, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, noeud.left);
    branche_si_faux := crée_branche_saufsi_null_ou_undefined(génératrice);
    résultat := génère_code_binaire(génératrice, noeud.right);
    définis_décalage_branche(génératrice, branche_si_faux);
    retourne résultat;
}

comma_statement_sur_code_binaire :: fonc (comma: *CommaExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, comma.left);
    retourne génère_code_binaire(génératrice, comma.right);
}

concise_body_sur_code_binaire :: fonc (concise_body: *ConciseBody, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    // ExpressionBody : FunctionBody
    si concise_body.statement.type == BlockStatement {
        retourne génère_code_binaire(génératrice, concise_body.statement);
    }

    // ExpressionBody : AssignmentExpression
    // 1. Let exprRef be ? Evaluation of AssignmentExpression.
    // 2. Let exprValue be ? GetValue(exprRef).
    _ := génère_code_binaire(génératrice, concise_body.statement);

    // 3. Return ReturnCompletion(exprValue).
    crée_retour(génératrice);
    retourne;
}

conditional_expression_sur_code_binaire :: fonc (noeud: *ConditionalExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    reg_opt_test := génère_code_binaire(génératrice, noeud.test);
    assert(possède_valeur(reg_opt_test));

    branche_si_faux := crée_branche_si_faux(génératrice);

    _ := génère_code_binaire(génératrice, noeud.consequent);

    branche := crée_branche(génératrice);

    définis_décalage_branche(génératrice, branche_si_faux);
    _ := génère_code_binaire(génératrice, noeud.alternate);

    définis_décalage_branche(génératrice, branche);

    retourne Registre(0);
}

continue_statement_sur_code_binaire :: fonc (statement: *ContinueStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    assert(statement.target == nul);
    label := donne_labels_boucle_courante(génératrice).id_label_continue;
    branche := crée_branche(génératrice);
    ajoute_patch_label_branche(génératrice, label, branche);
}

do_while_statement_sur_code_binaire :: fonc (noeud: *DoWhileStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    décalage := donne_décalage(génératrice);
    label_continue := crée_label(génératrice);

    label_break := crée_label(génératrice);

    empile_labels_boucle(génératrice, label_continue, label_break);
    diffère dépile_labels_boucle(génératrice);

    _ := génère_code_binaire(génératrice, noeud.body);

    insère_label(génératrice, label_continue);

    reg_opt_test := génère_code_binaire(génératrice, noeud.test);
    assert(possède_valeur(reg_opt_test));

    branche_test := crée_branche_si_vrai(génératrice);
    définis_décalage_branche(génératrice, branche_test, décalage);
    insère_label(génératrice, label_break);

    retourne crée_charge(génératrice, js_undefined);
}

empty_statement_sur_code_binaire :: fonc (statement: *NoeudSyntaxique @inutilisée, génératrice: *GénératriceCodeBinaire @inutilisée) -> Optionnel(Registre)
{
    retourne;
}

equality_expression_sur_code_binaire :: fonc (noeud: *EqualityExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    opt_reg_gauche := génère_code_binaire(génératrice, noeud.gauche);
    assert(possède_valeur(opt_reg_gauche));
    gauche := crée_stocke(génératrice);
    opt_reg_droite := génère_code_binaire(génératrice, noeud.droite);
    assert(possède_valeur(opt_reg_droite));

    discr noeud.opération {
        Égal {
            retourne crée_comparaison_égal(génératrice, gauche);
        }
        Inégal {
            retourne crée_comparaison_inégal(génératrice, gauche);
        }
        ÉgalStrict {
            retourne crée_comparaison_égal_strict(génératrice, gauche);
        }
        InégalStrict {
            retourne crée_comparaison_inégal_strict(génératrice, gauche);
        }
        sinon {
            panique("noeud.opération non-initialisé");
        }
    }
}

expression_statement_sur_code_binaire :: fonc (statement: *ExpressionStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne génère_code_binaire(génératrice, statement.expression);
}

for_statement_sur_code_binaire :: fonc (for: *ForStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    si for.init {
        _ := génère_code_binaire(génératrice, for.init);
    }

    décalage_entrée_boucle := donne_décalage(génératrice);
    label_boucle := crée_label(génératrice);
    label_continue := crée_label(génératrice);
    label_break := crée_label(génératrice);

    insère_label(génératrice, label_boucle);

    branche_test: IndiceBranche;
    si for.test {
        _ := génère_code_binaire(génératrice, for.test);
        branche_test = crée_branche_si_faux(génératrice);
    }

    empile_labels_boucle(génératrice, label_continue, label_break);
    diffère dépile_labels_boucle(génératrice);

    _ := génère_code_binaire(génératrice, for.body);

    insère_label(génératrice, label_continue);
    si for.update {
        _ := génère_code_binaire(génératrice, for.update);
    }
    crée_branche(génératrice, décalage_entrée_boucle);

    décalage := donne_décalage(génératrice);
    définis_décalage_branche(génératrice, branche_test, décalage);
    insère_label(génératrice, label_break);
    
    retourne crée_charge(génératrice, js_undefined);
}

function_declaration_sur_code_binaire :: fonc (noeud: *FunctionDeclaration @inutilisée, génératrice: *GénératriceCodeBinaire @inutilisée) -> Optionnel(Registre)
{
    // 1. Return empty.
    retourne;
}

function_expression_sur_code_binaire :: fonc (noeud: *FunctionExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne crée_instancie_fonction(génératrice, noeud);
}

identifier_sur_code_binaire :: fonc (noeud: *Identifier, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne crée_charge_locale(génératrice, noeud.nom);
}

if_statement_sur_code_binaire :: fonc (noeud: *IfStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    reg_opt_test := génère_code_binaire(génératrice, noeud.test);
    assert(possède_valeur(reg_opt_test));

    branche_si_faux := crée_branche_si_faux(génératrice);

    _ := génère_code_binaire(génératrice, noeud.consequent);

    si noeud.alternate {
        branche := crée_branche(génératrice);

        définis_décalage_branche(génératrice, branche_si_faux);
        _ := génère_code_binaire(génératrice, noeud.alternate);

        définis_décalage_branche(génératrice, branche);
    }
    sinon {
        définis_décalage_branche(génératrice, branche_si_faux);
    }

    retourne crée_charge(génératrice, js_undefined);
}

logical_and_sur_code_binaire :: fonc (noeud: *LogicalAnd, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, noeud.left);
    branche_si_faux := crée_branche_si_faux(génératrice);
    résultat := génère_code_binaire(génératrice, noeud.right);
    définis_décalage_branche(génératrice, branche_si_faux);
    retourne résultat;
}

logical_not_sur_code_binaire :: fonc (noeud: *LogicalNot, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, noeud.argument);
    retourne crée_logical_not(génératrice);
}

logical_or_sur_code_binaire :: fonc (noeud: *LogicalAnd, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, noeud.left);
    branche_si_faux := crée_branche_si_vrai(génératrice);
    résultat := génère_code_binaire(génératrice, noeud.right);
    définis_décalage_branche(génératrice, branche_si_faux);
    retourne résultat;
}

member_expression_sur_code_binaire :: fonc (noeud: *MemberExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    opt_reg_objet := génère_code_binaire(génératrice, noeud.objet);

    saufsi noeud.calculé {
        assert(noeud.propriété.type == Identifier);
        identifier := noeud.propriété comme *Identifier;

        retourne crée_charge_member(génératrice, opt_reg_objet.Quelque, identifier.nom);
    }

    opt_reg_objet = crée_stocke(génératrice);
    _ := génère_code_binaire(génératrice, noeud.propriété);
    retourne crée_charge_index(génératrice, opt_reg_objet.Quelque);
}

new_expression_sur_code_binaire :: fonc (noeud: *NewExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    construct_expr: *NoeudSyntaxique;
    arguments: []*Expression;

    si noeud.argument.type == CallExpression {
        call := noeud.argument comme *CallExpression;
        construct_expr = call.appelé;
        arguments = call.arguments;
    }
    sinon {
        construct_expr = noeud.argument;
    }

    reg_opt_func := génère_code_binaire(génératrice, construct_expr);
    assert(possède_valeur(reg_opt_func));
    reg_opt_func = crée_stocke(génératrice);

    registres_arguments: [..]Registre;
    diffère déloge(*registres_arguments);

    pour arguments {
        reg_opt_arg := génère_code_binaire(génératrice, it);
        assert(possède_valeur(reg_opt_arg));
        reg_arg := crée_stocke(génératrice);
        tableau_ajoute(*registres_arguments, reg_arg);
    }

    retourne crée_new(génératrice, reg_opt_func.Quelque, registres_arguments);
}

noeud_script_body_sur_code_binaire :: fonc (noeud: *ScriptBody, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    résultat: Optionnel(Registre);

    pour noeud.enfants {
        résultat = génère_code_binaire(génératrice, it);
    }

    retourne résultat;
}

noeud_script_sur_code_binaire :: fonc (noeud: *NoeudScript, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne génère_code_binaire(génératrice, noeud.script_body);
}

null_literal_sur_code_binaire :: fonc (noeud: *NullLiteral @inutilisée, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne crée_charge(génératrice, js_null);
}

numeric_literal_sur_code_binaire :: fonc (noeud: *NumericLiteral, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne crée_charge(génératrice, Valeur(Number = noeud.valeur));
}

object_expression_sur_code_binaire :: fonc (noeud: *ObjectLiteral, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    reg_objet_src := crée_crée_objet(génératrice);
    si noeud.properties.taille == 0 {
        retourne reg_objet_src;
    }

    reg_objet := crée_stocke(génératrice);

    pour noeud.properties {
        assert(it.type == PropertyDefinition);
        property_definition := it comme *PropertyDefinition;

        nom_prop := donne_nom_propriété(property_definition.property_name);

        // À FAIRE : is_proto_setter

        si is_anonymous_function_definition(property_definition.expression) {
            _ := crée_named_evaluation(génératrice, property_definition.expression, nom_prop);
        }
        sinon {
            _ := génère_code_binaire(génératrice, property_definition.expression);
        }

        crée_data_property_or_throw(génératrice, reg_objet, nom_prop);
    }

    crée_charge_registre(génératrice, reg_objet);
    retourne Registre(0);
}

donne_nom_propriété :: fonc (prop_name: *NoeudSyntaxique) -> ECMAString
{
    si prop_name.type == StringLiteral {
        string := prop_name comme *StringLiteral;
        retourne string.valeur;
    }

    si prop_name.type == NumericLiteral {
        number := prop_name comme *NumericLiteral;
        chn := imprime_chaine("%", number.valeur);
        diffère déloge(*chn);
        retourne crée_chaine_utf16_unique(chn);
    }

    assert(prop_name.type == Identifier);
    ident := prop_name comme *Identifier;
    retourne ident.nom;
}

parenthesized_expression_sur_code_binaire :: fonc (noeud: *ParenthesizedExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    saufsi noeud.expression {
        retourne crée_charge(génératrice, js_undefined);
    }

    retourne génère_code_binaire(génératrice, noeud.expression);
}

relational_expression_sur_code_binaire :: fonc (noeud: *RelationalExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    opt_reg_gauche := génère_code_binaire(génératrice, noeud.gauche);
    assert(possède_valeur(opt_reg_gauche));
    gauche := crée_stocke(génératrice);
    opt_reg_droite := génère_code_binaire(génératrice, noeud.droite);
    assert(possède_valeur(opt_reg_droite));

    discr noeud.opération {
        Inférieur {
            retourne crée_relation_inférieure(génératrice, gauche);
        }
        Supérieur {
            retourne crée_relation_supérieure(génératrice, gauche);
        }
        InférieurÉgal {
            retourne crée_relation_inférieure_égale(génératrice, gauche);
        }
        SupérieurÉgal {
            retourne crée_relation_supérieure_égale(génératrice, gauche);
        }
        InstanceOf {
            retourne crée_instance_of(génératrice, gauche);
        }
        In {
            retourne crée_in(génératrice, gauche);
        }
        sinon {
            panique("relation non-implémentée : %", noeud.opération);
        }
    }
}

return_statement_sur_code_binaire :: fonc (noeud: *ReturnStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    si noeud.argument {
        _ := génère_code_binaire(génératrice, noeud.argument);
    }
    sinon {
        _ := crée_charge(génératrice, js_undefined);
    }

    crée_retour(génératrice);
}

string_literal_sur_code_binaire :: fonc (noeud: *StringLiteral, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne crée_crée_chaine(génératrice, noeud.valeur);
}

switch_statement_sur_code_binaire :: fonc (switch: *SwitchStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, switch.discriminant);

    crée_entrée_switch(génératrice);

    si switch.cases.taille == 0 {
        _ := crée_charge(génératrice, js_undefined);
    }
    sinon {
        reg_valeur_discriminant := crée_stocke(génératrice);

        index_branches_pour_cas: [..]IndiceBranche;
        diffère déloge(*index_branches_pour_cas);

        label_pour_break := crée_label(génératrice);

        empile_labels_boucle(génératrice, Label(-1 comme n32), label_pour_break);
        diffère dépile_labels_boucle(génératrice);

        /* Génère le code pour les tests. */
        pour switch.cases {
            si indice_it == switch.index_default_clause {
                tableau_ajoute(*index_branches_pour_cas, IndiceBranche(-1));
                continue;
            }

            assert(it.type == CaseClause);

            _ := génère_code_binaire(génératrice, it.test);
            _ := crée_comparaison_égal_strict(génératrice, reg_valeur_discriminant);
            branche := crée_branche_si_vrai(génératrice);
            tableau_ajoute(*index_branches_pour_cas, branche);
        }

        branche_si_faux := crée_branche(génératrice);
        si switch.index_default_clause != -1 {
            index_branches_pour_cas[switch.index_default_clause] = branche_si_faux;
        }

        pour switch.cases {
            définis_décalage_branche(génératrice, index_branches_pour_cas[indice_it]);

            si it.consequent == nul {
                continue;
            }

            _ := génère_code_binaire(génératrice, it.consequent);
        }

        si switch.index_default_clause == -1 {
            définis_décalage_branche(génératrice, branche_si_faux);
        }
        insère_label(génératrice, label_pour_break);
    }

    crée_sortie_switch(génératrice);
}

this_expression_sur_code_binaire :: fonc (noeud: *ThisExpression @inutilisée, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    retourne crée_this(génératrice);
}

throw_statement_sur_code_binaire :: fonc (noeud: *ThrowStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    reg_opt_valeur := génère_code_binaire(génératrice, noeud.argument);
    assert(possède_valeur(reg_opt_valeur));
    crée_throw(génératrice);
}

try_statement_sur_code_binaire :: fonc (try: *TryStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    exception_handler: ExceptionHandler;
    si try.handler != nul {
        exception_handler = empile_exception_handler(génératrice);
    }

    _ := génère_code_binaire(génératrice, try.block);

    /* Branche pour sauteur le catch si aucune exception n'est lancée. */
    branche := crée_branche(génératrice);

    si try.handler != nul {
        dépile_exception_handler(génératrice, exception_handler);
        _ := catch_clause_sur_code_binaire(try.handler, génératrice);
    }

    définis_décalage_branche(génératrice, branche);
    si try.finalizer != nul {
        _ := génère_code_binaire(génératrice, try.finalizer);
    }
}

typeof_operator_sur_code_binaire :: fonc (typeof: *TypeofOperator, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    // À FAIRE : 2. If val is a Reference Record, then
    _ := génère_code_binaire(génératrice, typeof.argument);
    retourne crée_typeof(génératrice);
}

unary_minus_operator_sur_code_binaire :: fonc (noeud: *UnaryMinusOperator, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, noeud.argument);
    retourne crée_unary_minus(génératrice);
}

unary_plus_operator_sur_code_binaire :: fonc (noeud: *UnaryPlusOperator, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, noeud.argument);
    retourne crée_unary_plus(génératrice);
}

update_expression_sur_code_binaire :: fonc (update: *UpdateExpression, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    argument := update.argument;

    reg_opt_old_value := génère_code_binaire(génératrice, argument);
    assert(possède_valeur(reg_opt_old_value));

    résultat := reg_opt_old_value;
    si update.operation == UpdateOperation.PostfixIncrement || update.operation == UpdateOperation.PostfixDecrement {
        résultat = crée_stocke(génératrice);
    }

    si update.operation == UpdateOperation.PostfixIncrement || update.operation == UpdateOperation.PrefixIncrement {
        crée_incrémente(génératrice);
    }
    sinon {
        crée_décrémente(génératrice);
    }

    si argument.type == Identifier {
        identifier := argument comme *Identifier;
        crée_définis_locale(génératrice, identifier.nom);
    }
    sinon si argument.type == MemberExpression {
        member := argument comme *MemberExpression;
        assert(!member.calculé);

        sauvegarde := crée_stocke(génératrice);

        opt_reg_objet := génère_code_binaire(génératrice, member.objet);
        assert(possède_valeur(opt_reg_objet));

        assert(member.propriété.type == Identifier);
        identifier := member.propriété comme *Identifier;

        crée_définis_member(génératrice, identifier.nom, sauvegarde);

        si update.operation == UpdateOperation.PrefixIncrement || update.operation == UpdateOperation.PrefixDecrement {
            résultat = sauvegarde;
        }
    }
    sinon {
        panique("non-implémenté");
    }

    si résultat.Quelque comme n32 != 0 {
        crée_charge_registre(génératrice, résultat.Quelque);
        résultat = Registre(0);
    }

    retourne résultat;
}

variable_declaration_sur_code_binaire :: fonc (noeud: *VariableDeclaration, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    dernière_valeur: Optionnel(Registre);

    si noeud.nature == VariableDeclarationKind.Var {
        pour noeud.expressions {
            dernière_valeur = variable_declarator_sur_code_binaire(it, génératrice);
        }
    }
    sinon {
        pour noeud.expressions {
            dernière_valeur = lexical_declarator_sur_code_binaire(it, génératrice);
        }
    }

    retourne dernière_valeur;
}

variable_declarator_sur_code_binaire :: fonc (noeud: *VariableDeclarator, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    assert(noeud.id.type == Identifier);
    identifier := noeud.id comme *Identifier;

    saufsi noeud.init {
        // 1. Return EMPTY
        retourne;
    }

    // 1. Let bindingId be the StringValue of BindingIdentifier.
    binding_id := identifier.nom;

    // 2. Let lhs be ? ResolveBinding(bindingId).
    // À FAIRE : nous pourrions avoir une exception ici.

    // 3. If IsAnonymousFunctionDefinition(Initializer) is true, then
    si is_anonymous_function_definition(noeud.init) {
        // a. Let value be ? NamedEvaluation of Initializer with argument bindingId.
        _ := crée_named_evaluation(génératrice, noeud.init, binding_id);
    }
    // 4. Else,
    sinon {
        // a. Let rhs be ? Evaluation of Initializer.
        // b. Let value be ? GetValue(rhs).
        _ := génère_code_binaire(génératrice, noeud.init);
    }

    // 5. Perform ? PutValue(lhs, value).
    crée_définis_locale(génératrice, binding_id);

    // 6. Return EMPTY.
    retourne;
}

lexical_declarator_sur_code_binaire :: fonc (noeud: *VariableDeclarator, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    assert(noeud.id.type == Identifier);
    binding_identifier := noeud.id comme *Identifier;

    saufsi noeud.init {
        // 1. Let lhs be ! ResolveBinding(StringValue of BindingIdentifier).
        binding_id := binding_identifier.nom;

        // 2. Perform ! InitializeReferencedBinding(lhs, undefined).
        _ := crée_charge(génératrice, js_undefined);
        crée_initialise_référence(génératrice, binding_id);

        // 3. Return empty.
        retourne;
    }

    // 1. Let bindingId be the StringValue of BindingIdentifier.
    binding_id := binding_identifier.nom;

    // 2. Let lhs be ! ResolveBinding(bindingId).

    // 3. If IsAnonymousFunctionDefinition(Initializer) is true, then
    si is_anonymous_function_definition(noeud.init) {
        // a. Let value be ? NamedEvaluation of Initializer with argument bindingId.
        _ := crée_named_evaluation(génératrice, noeud.init, binding_id);
    }
    // 4. Else,
    sinon {
        // a. Let rhs be ? Evaluation of Initializer.
        // b. Let value be ? GetValue(rhs).
        _ := génère_code_binaire(génératrice, noeud.init);
    }

    // 5. Perform ! InitializeReferencedBinding(lhs, value).
    crée_initialise_référence(génératrice, binding_id);

    // 6. Return empty.
    retourne;
}

void_operator_sur_code_binaire :: fonc (noeud: *VoidOperator, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    _ := génère_code_binaire(génératrice, noeud.argument);
    retourne crée_charge(génératrice, js_undefined);
}

while_statement_sur_code_binaire :: fonc (noeud: *WhileStatement, génératrice: *GénératriceCodeBinaire) -> Optionnel(Registre)
{
    décalage := donne_décalage(génératrice);
    label_continue := crée_label(génératrice);
    insère_label(génératrice, label_continue);

    label_break := crée_label(génératrice);

    empile_labels_boucle(génératrice, label_continue, label_break);
    diffère dépile_labels_boucle(génératrice);

    reg_opt_test := génère_code_binaire(génératrice, noeud.test);
    assert(possède_valeur(reg_opt_test));

    branche_test := crée_branche_si_faux(génératrice);

    _ := génère_code_binaire(génératrice, noeud.body);

    crée_branche(génératrice, décalage);

    décalage = donne_décalage(génératrice);
    définis_décalage_branche(génératrice, branche_test, décalage);
    insère_label(génératrice, label_break);

    retourne crée_charge(génératrice, js_undefined);
}

/** \} */
