/* ------------------------------------------------------------------------- */
/** \nom 10.1 Ordinary Object Internal Methods and Internal Slots
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinary-object-internal-methods-and-internal-slots
 * \{ */

/* 10.1.1.1 OrdinaryGetPrototypeOf ( O )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinarygetprototypeof */
ordinary_get_prototype_of :: fonc (object: *Object) -> *Object
{
    // Return O.[[Prototype]].
    retourne object.prototype;
}

/* 10.1.2.1 OrdinarySetPrototypeOf ( O, V )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinarysetprototypeof */
ordinary_set_prototype_of :: fonc (object: *Object, valeur: Valeur) -> bool
{
    // 1. Let current be O.[[Prototype]].
    current := object.prototype;

    // 2. If SameValue(V, current) is true, return true.
    si est_true(same_value(valeur, current)) {
        retourne vrai;
    }

    // 3. Let extensible be O.[[Extensible]].
    extensible := object.extensible;

    // 4. If extensible is false, return false.
    saufsi extensible {
        retourne faux;
    }

    // 5. Let p be V.
    p : *Object;
    saufsi est_nulle(valeur) {
        p = donne_objet(valeur);
    }

    // 6. Let done be false.
    done := faux;

    // 7. Repeat, while done is false,
    tantque done == faux {
        // a. If p is null, then
        si p == nul {
            // i. Set done to true.
            done = vrai;
        }
        // b. Else if SameValue(p, O) is true, then
        sinon si est_true(same_value(p, object)) {
            // i. Return false.
            retourne faux;
        }
        // c. Else,
        sinon {
            // i. If p.[[GetPrototypeOf]] is not the ordinary object internal method defined in 10.1.1, set done to true.
            si donne_table(p).sur_get_prototype_of != ordinary_get_prototype_of {
                done = vrai;
            }
            // ii. Else, set p to p.[[Prototype]].
            sinon {
                p = p.prototype;
            }
        }
    }

    // 8. Set O.[[Prototype]] to V.
    si est_nulle(valeur) {
        object.prototype = nul;
    }
    sinon {
        assert(est_object(valeur));
        object.prototype = donne_objet(valeur);
    }

    // 9. Return true.
    retourne vrai;
}

/* 10.1.5.1 OrdinaryGetOwnProperty ( O, P )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinarygetownproperty */
ordinary_get_own_property :: fonc (object: *Object, property_key: PropertyKey) -> Optionnel(PropertyDescriptor)
{
    propriété := trouve_propriété(object, property_key);

    // 1. If O does not have an own property with key P, return undefined.
    saufsi propriété {
        retourne;
    }

    // 2. Let D be a newly created Property Descriptor with no fields.
    D: PropertyDescriptor;

    // 3. Let X be O's own property whose key is P.
    X := mémoire(propriété);

    // 4. If X is a data property, then
    si is_data_propery(*X) {
        // a. Set D.[[Value]] to the value of X's [[Value]] attribute.
        D.value = propriété.valeur;

        // b. Set D.[[Writable]] to the value of X's [[Writable]] attribute.
        D.writable = propriété.drapeaux.WRITABLE == vrai;
    }
    // 5. Else,
    sinon {
        // a. Assert: X is an accessor property.
        assert(is_accessor_propery(*X));

        // b. Set D.[[Get]] to the value of X's [[Get]] attribute.
        si propriété.get {
            D.get = propriété.get;
        }

        // c. Set D.[[Set]] to the value of X's [[Set]] attribute.
        si propriété.set {
            D.set = propriété.set;
        }
    }

    // 6. Set D.[[Enumerable]] to the value of X's [[Enumerable]] attribute.
    D.enumerable = propriété.drapeaux.ENUMERABLE == vrai;

    // 7. Set D.[[Configurable]] to the value of X's [[Configurable]] attribute.
    D.configurable = propriété.drapeaux.CONFIGURABLE == vrai;

    // 8. Return D.
    retourne D;
}

/* 10.1.6.1 [[DefineOwnProperty]] ( P, Desc )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinarydefineownproperty */
ordinary_define_own_property :: fonc (object: *Object, property_key: PropertyKey, desc: *PropertyDescriptor) -> bool
{
    // 1. Let current be ? O.[[GetOwnProperty]](P).
    current := internal_get_own_property(object, property_key);
    si possède_exception(object) {
        retourne faux;
    }

    // 2. Let extensible be ? IsExtensible(O).
    extensible := is_extensible(object);
    si possède_exception(object) {
        retourne faux;
    }

    // 3. Return ValidateAndApplyPropertyDescriptor(O, P, extensible, Desc, current).
    retourne validate_and_apply_property_descriptor(object, property_key, extensible, desc, current);
}

/* 10.1.6.3 ValidateAndApplyPropertyDescriptor ( O, P, extensible, Desc, current )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-validateandapplypropertydescriptor */
validate_and_apply_property_descriptor :: fonc (object: *Object, property_key: PropertyKey, extensible: bool, desc: *PropertyDescriptor, opt_current: Optionnel(PropertyDescriptor)) -> bool
{
    // 1. Assert: P is a property key.

    // 2. If current is undefined, then
    saufsi possède_valeur(opt_current) {
        // a. If extensible is false, return false.
        saufsi extensible {
            retourne faux;
        }

        // b. If O is undefined, return true.
        saufsi object {
            retourne vrai;
        }

        // c. If IsAccessorDescriptor(Desc) is true, then
        si is_accessor_descriptor(desc) {
            // i. Create an own accessor property named P of object O whose [[Get]], [[Set]], [[Enumerable]], and [[Configurable]] attributes are set to the value of the corresponding field in Desc if Desc has that field, or to the attribute's default value otherwise.
            get: *Object;
            si possède_valeur(desc.get) {
                get = desc.get.Quelque;
            }

            set: *Object;
            si possède_valeur(desc.set) {
                set = desc.set.Quelque;
            }

            drapeaux := donne_drapeaux_propriétés(desc);

            ajoute_propriété(object, property_key, get, set, drapeaux);
        }
        // d. Else,
        sinon {
            // i. Create an own data property named P of object O whose [[Value]], [[Writable]], [[Enumerable]], and [[Configurable]] attributes are set to the value of the corresponding field in Desc if Desc has that field, or to the attribute's default value otherwise.
            valeur := js_undefined;
            si possède_valeur(desc.value) {
                valeur = desc.value.Quelque;
            }
            drapeaux := donne_drapeaux_propriétés(desc);
            ajoute_propriété(object, property_key, valeur, drapeaux);
        }

        // e. Return true.
        retourne vrai;
    }

    // 3. Assert: current is a fully populated Property Descriptor.
    current := opt_current.Quelque;

    // 4. If Desc does not have any fields, return true.
    si est_vide(desc) {
        retourne vrai;
    }

    // 5. If current.[[Configurable]] is false, then
    si current.configurable.Quelque == faux {
        // a. If Desc has a [[Configurable]] field and Desc.[[Configurable]] is true, return false.
        si possède_valeur(desc.configurable) && desc.configurable.Quelque == vrai {
            retourne faux;
        }

        // b. If Desc has an [[Enumerable]] field and Desc.[[Enumerable]] is not current.[[Enumerable]], return false.
        si possède_valeur(desc.enumerable) && desc.enumerable.Quelque != current.enumerable.Quelque {
            retourne faux;
        }

        // c. If IsGenericDescriptor(Desc) is false and IsAccessorDescriptor(Desc) is not IsAccessorDescriptor(current), return false.
        si is_generic_descriptor(desc) == faux && is_accessor_descriptor(desc) != is_accessor_descriptor(*current) {
            retourne faux;
        }

        // d. If IsAccessorDescriptor(current) is true, then
        si is_accessor_descriptor(*current) {
            // i. If Desc has a [[Get]] field and SameValue(Desc.[[Get]], current.[[Get]]) is false, return false.
            si possède_valeur(desc.get) && est_false(same_value(desc.get.Quelque, current.get.Quelque)) {
                retourne faux;
            }

            // ii. If Desc has a [[Set]] field and SameValue(Desc.[[Set]], current.[[Set]]) is false, return false.
            si possède_valeur(desc.set) && est_false(same_value(desc.set.Quelque, current.set.Quelque)) {
                retourne faux;
            }
        }
        // e. Else if current.[[Writable]] is false, then
        sinon si current.writable.Quelque == faux {
            // i. If Desc has a [[Writable]] field and Desc.[[Writable]] is true, return false.
            si possède_valeur(desc.writable) && desc.writable.Quelque == vrai {
                retourne faux;
            }

            // ii. NOTE: SameValue returns true for NaN values which may be distinguishable by other means. Returning here ensures that any existing property of O remains unmodified.

            // iii. If Desc has a [[Value]] field, return SameValue(Desc.[[Value]], current.[[Value]]).
            si possède_valeur(desc.value) {
                retourne est_true(same_value(desc.value.Quelque, current.value.Quelque));
            }
        }
    }

    // 6. If O is not undefined, then
    si object {
        // a. If IsDataDescriptor(current) is true and IsAccessorDescriptor(Desc) is true, then
        si is_data_descriptor(*current) && is_accessor_descriptor(desc) {
            // i. If Desc has a [[Configurable]] field, let configurable be Desc.[[Configurable]];
            //    else let configurable be current.[[Configurable]].
            configurable := si possède_valeur(desc.configurable) {
                desc.configurable.Quelque;
            }
            sinon {
                current.configurable.Quelque;
            };

            // ii. If Desc has a [[Enumerable]] field, let enumerable be Desc.[[Enumerable]];
            //     else let enumerable be current.[[Enumerable]].
            enumerable := si possède_valeur(desc.enumerable) {
                desc.enumerable.Quelque;
            }
            sinon {
                current.enumerable.Quelque;
            };

            // iii. Replace the property named P of object O with an accessor property whose [[Configurable]]
            //      and [[Enumerable]] attributes are set to configurable and enumerable, respectively,
            //      and whose [[Get]] and [[Set]] attributes are set to the value of the corresponding field
            //      in Desc if Desc has that field, or to the attribute's default value otherwise.
            propriété := trouve_propriété(object, property_key);
            mémoire(propriété) = Object.Propriété();
            si possède_valeur(desc.get) {
                propriété.get = desc.get.Quelque;
            }
            si possède_valeur(desc.set) {
                propriété.set = desc.set.Quelque;
            }
            propriété.drapeaux.CONFIGURABLE = configurable;
            propriété.drapeaux.ENUMERABLE = enumerable;
        }
        // b. Else if IsAccessorDescriptor(current) is true and IsDataDescriptor(Desc) is true, then
        sinon si is_accessor_descriptor(*current) && is_data_descriptor(desc) {
            // i. If Desc has a [[Configurable]] field, let configurable be Desc.[[Configurable]];
            //    else let configurable be current.[[Configurable]].
            configurable := si possède_valeur(desc.configurable) {
                desc.configurable.Quelque;
            }
            sinon {
                current.configurable.Quelque;
            };

            // ii. If Desc has a [[Enumerable]] field, let enumerable be Desc.[[Enumerable]];
            //     else let enumerable be current.[[Enumerable]].
            enumerable := si possède_valeur(desc.enumerable) {
                desc.enumerable.Quelque;
            }
            sinon {
                current.enumerable.Quelque;
            };

            // iii. Replace the property named P of object O with a data property whose [[Configurable]]
            //      and [[Enumerable]] attributes are set to configurable and enumerable, respectively,
            //      and whose [[Value]] and [[Writable]] attributes are set to the value of the corresponding
            //      field in Desc if Desc has that field, or to the attribute's default value otherwise.
            propriété := trouve_propriété(object, property_key);
            mémoire(propriété) = Object.Propriété();
            si possède_valeur(desc.value) {
                propriété.valeur = desc.value.Quelque;
            }
            si possède_valeur(desc.writable) {
                propriété.drapeaux.WRITABLE = desc.writable.Quelque;
            }
            propriété.drapeaux.CONFIGURABLE = configurable;
            propriété.drapeaux.ENUMERABLE = enumerable;
        }
        // c. Else,
        sinon {
            // i. For each field of Desc, set the corresponding attribute of the property named P
            // of object O to the value of the field.
            propriété := trouve_propriété(object, property_key);
            // mémoire(propriété) = Object.Propriété()
            si possède_valeur(desc.value) {
                propriété.valeur = desc.value.Quelque;
            }
            si possède_valeur(desc.get) {
                propriété.get = desc.get.Quelque;
            }
            si possède_valeur(desc.set) {
                propriété.set = desc.set.Quelque;
            }
            si possède_valeur(desc.writable) {
                propriété.drapeaux.WRITABLE = desc.writable.Quelque;
            }
            si possède_valeur(desc.enumerable) {
                propriété.drapeaux.ENUMERABLE = desc.enumerable.Quelque;
            }
            si possède_valeur(desc.configurable) {
                propriété.drapeaux.CONFIGURABLE = desc.configurable.Quelque;
            }
        }
    }
    
    // 7. Return true.
    retourne vrai;
}

/* 10.1.7.1 OrdinaryHasProperty ( O, P )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinaryhasproperty */
ordinary_has_property :: fonc (object: *Object, property_key: PropertyKey) -> bool
{
    // 1. Let hasOwn be ? O.[[GetOwnProperty]](P).
    has_own := internal_get_own_property(object, property_key);
    si possède_exception(object) {
        retourne faux;
    }

    // 2. If hasOwn is not undefined, return true.
    si possède_valeur(has_own) {
        retourne vrai;
    }

    // 3. Let parent be ? O.[[GetPrototypeOf]]().
    parent := internal_get_prototype_of(object);

    // 4. If parent is not null, then
    si parent {
        // a. Return ? parent.[[HasProperty]](P).
        retourne internal_has_property(parent, property_key);
    }

    // 5. Return false.
    retourne faux;
}

/* 10.1.8.1 OrdinaryGet ( O, P, Receiver )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinary-object-internal-methods-and-internal-slots-get-p-receiver */
ordinary_get :: fonc (object: *Object, property_key: PropertyKey, receiver: Valeur) -> Valeur
{
    // 1. Let desc be ? O.[[GetOwnProperty]](P).
    opt_desc := internal_get_own_property(object, property_key);
    si possède_exception(object) {
        retourne js_undefined;
    }

    // 2. If desc is undefined, then
    saufsi possède_valeur(opt_desc) {
        // a. Let parent be ? O.[[GetPrototypeOf]]().
        parent := internal_get_prototype_of(object);

        // b. If parent is null, return undefined.
        si parent == nul {
            retourne js_undefined;
        }

        // c. Return ? parent.[[Get]](P, Receiver).
        retourne internal_get(parent, property_key, receiver);
    }

    desc := opt_desc.Quelque;

    // 3. If IsDataDescriptor(desc) is true, return desc.[[Value]].
    si is_data_descriptor(*desc) {
        retourne desc.value;
    }

    // 4. Assert: IsAccessorDescriptor(desc) is true.
    assert(is_accessor_descriptor(*desc));

    // 5. Let getter be desc.[[Get]].
    getter := desc.get;

    // 6. If getter is undefined, return undefined.
    saufsi possède_valeur(getter) {
        retourne js_undefined;
    }

    // 7. Return ? Call(getter, Receiver).
    mv := donne_mv(donne_tas_de_mémoire(donne_objet(receiver)));
    retourne call(mv, getter.Quelque, receiver);
}

/* 10.1.9.1 OrdinarySet ( O, P, V, Receiver )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinaryset */
ordinary_set :: fonc (object: *Object, property_key: PropertyKey, valeur: Valeur, receiver: Valeur) -> bool
{
    // 1. Let ownDesc be ? O.[[GetOwnProperty]](P).
    own_desc := internal_get_own_property(object, property_key);
    si possède_exception(object) {
        retourne faux;
    }

    // 2. Return ? OrdinarySetWithOwnDescriptor(O, P, V, Receiver, ownDesc).
    retourne ordinary_set_with_own_descriptor(object, property_key, valeur, receiver, own_desc);
}

/* 10.1.9.2 OrdinarySetWithOwnDescriptor ( O, P, V, Receiver, ownDesc )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinarysetwithowndescriptor */
ordinary_set_with_own_descriptor :: fonc (object: *Object, property_key: PropertyKey, valeur: Valeur, receiver: Valeur, opt_own_desc: Optionnel(PropertyDescriptor)) -> bool
{
    own_desc: PropertyDescriptor;

    // 1. If ownDesc is undefined, then
    saufsi possède_valeur(opt_own_desc) {
        // a. Let parent be ? O.[[GetPrototypeOf]]().
        parent := internal_get_prototype_of(object);

        // b. If parent is not null, then
        si parent {
            // i. Return ? parent.[[Set]](P, V, Receiver).
            retourne internal_set(parent, property_key, valeur, receiver);
        }
        // c. Else,
        sinon {
            // i. Set ownDesc to the PropertyDescriptor { [[Value]]: undefined, [[Writable]]: true, [[Enumerable]]: true, [[Configurable]]: true }.
            own_desc = PropertyDescriptor(value = js_undefined, writable = vrai, enumerable = vrai, configurable = vrai);
        }
    }
    sinon {
        own_desc = opt_own_desc.Quelque;
    }

    // 2. If IsDataDescriptor(ownDesc) is true, then
    si is_data_descriptor(*own_desc) {
        // a. If ownDesc.[[Writable]] is false, return false.
        si own_desc.writable == faux {
            retourne faux;
        }

        // b. If Receiver is not an Object, return false.
        saufsi est_object(receiver) {
            retourne faux;
        }

        // c. Let existingDescriptor be ? Receiver.[[GetOwnProperty]](P).
        opt_existing_descriptor := internal_get_own_property(donne_objet(receiver), property_key);
        si possède_exception(donne_objet(receiver)) {
            retourne faux;
        }

        // d. If existingDescriptor is not undefined, then
        si possède_valeur(opt_existing_descriptor) {
            existing_descriptor := opt_existing_descriptor.Quelque;

            // i. If IsAccessorDescriptor(existingDescriptor) is true, return false.
            si is_accessor_descriptor(*existing_descriptor) {
                retourne faux;
            }

            // ii. If existingDescriptor.[[Writable]] is false, return false.
            si existing_descriptor.writable == faux {
                retourne faux;
            }

            // iii. Let valueDesc be the PropertyDescriptor { [[Value]]: V }.
            value_desc := PropertyDescriptor(value = valeur);

            // iv. Return ? Receiver.[[DefineOwnProperty]](P, valueDesc).
            retourne internal_define_own_property(donne_objet(receiver), property_key, *value_desc);
        }
        // e. Else,
        sinon {
            // À FAIRE : i. Assert: Receiver does not currently have a property P.

            // ii. Return ? CreateDataProperty(Receiver, P, V).
            retourne create_data_property(donne_objet(receiver), property_key, valeur);
        }
    }

    // 3. Assert: IsAccessorDescriptor(ownDesc) is true.
    assert(is_accessor_descriptor(*own_desc));

    // 4. Let setter be ownDesc.[[Set]].
    setter := own_desc.set;

    // 5. If setter is undefined, return false.
    saufsi possède_valeur(setter) {
        retourne faux;
    }

    // 6. Perform ? Call(setter, Receiver, « V »).
    mv := donne_mv(donne_tas_de_mémoire(donne_objet(receiver)));

    arguments: []Valeur;
    arguments.données = *valeur;
    arguments.taille = 1;

    _ := call(mv, setter.Quelque, receiver, arguments);
    si possède_exception(mv.interpréteuse) {
        retourne faux;
    }

    // 7. Return true.
    retourne vrai;
}

/* 10.1.10.1 OrdinaryDelete ( O, P )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinarydelete */
ordinary_delete :: fonc (O: *Object, P: PropertyKey) -> bool
{
    // 1. Let desc be ? O.[[GetOwnProperty]](P).
    opt_desc := internal_get_own_property(O, P);
    si possède_exception(O) {
        retourne faux;
    }

    // 2. If desc is undefined, return true.
    saufsi possède_valeur(opt_desc) {
        retourne vrai;
    }

    desc := opt_desc.Quelque;

    // 3. If desc.[[Configurable]] is true, then
    configurable := desc.configurable;
    si possède_valeur(configurable) && configurable.Quelque == vrai {
        // a. Remove the own property with name P from O.
        supprime_propriété(O, P);

        // b. Return true.
        retourne vrai;
    }

    // 4. Return false.
    retourne faux;
}

/* 10.1.11.1 OrdinaryOwnPropertyKeys ( O )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinaryownpropertykeys */
ordinary_own_property_keys :: fonc (object: *Object) -> [..]PropertyKey
{
    // 1. Let keys be a new empty List.
    keys: [..]PropertyKey;

    propriétés := object.propriétés;

    // À FAIRE : ascending numeric index order
    // 2. For each own property key P of O such that P is an array index, in ascending numeric index order, do
    pour propriétés {
        si is_array_index(it.nom) {
            // a. Append P to keys.
            tableau_ajoute(*keys, it.nom);
        }
    }

    // À FAIRE : ascending chronological order of property creation
    // 3. For each own property key P of O such that P is a String and P is not an array index, in ascending chronological order of property creation, do
    pour propriétés {
        si is_array_index(it.nom) || est_symbol(it.nom) {
            continue;
        }

        // a. Append P to keys.
        tableau_ajoute(*keys, it.nom);
    }

    // 4. For each own property key P of O such that P is a Symbol, in ascending chronological order of property creation, do
    pour propriétés {
        saufsi est_symbol(it.nom) {
            continue;
        }

        // a. Append P to keys.
        tableau_ajoute(*keys, it.nom);
    }

    // 5. Return keys.
    retourne keys;
}

/* 10.1.12 OrdinaryObjectCreate ( proto [ , additionalInternalSlotsList ] )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinaryobjectcreate */
ordinary_object_create :: fonc (realm: *Realm, prototype: *Object, rappel_allocation_objet: TypeFonctionAllocationObjet) -> *Object
{
    // 1. Let internalSlotsList be « [[Prototype]], [[Extensible]] ».
    // 2. If additionalInternalSlotsList is present, set internalSlotsList to the list-concatenation of internalSlotsList and additionalInternalSlotsList.

    // 3. Let O be MakeBasicObject(internalSlotsList).
    O := make_basic_object(realm, rappel_allocation_objet);

    // 4. Set O.[[Prototype]] to proto.
    O.prototype = prototype;

    // 5. Return O.
    retourne O;
}

/* 10.1.13 OrdinaryCreateFromConstructor ( constructor, intrinsicDefaultProto [ , internalSlotsList ] )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-ordinaryobjectcreate */
ordinary_create_from_constructor :: fonc (realm: *Realm, constructor: *Function, intrinsic_default_proto: *Object, rappel_allocation_objet: TypeFonctionAllocationObjet) -> *Object
{
    // 1. Assert: intrinsicDefaultProto is this specification's name of an intrinsic object.
    //    The corresponding object must be an intrinsic that is intended to be used as the
    //    [[Prototype]] value of an object.
    assert(est_intrinsics(realm, intrinsic_default_proto));

    // 2. Let proto be ? GetPrototypeFromConstructor(constructor, intrinsicDefaultProto).
    proto := get_prototype_from_constructor(realm, constructor, intrinsic_default_proto);
    si possède_exception(realm) {
        retourne nul;
    }

    // 3. If internalSlotsList is present, let slotsList be internalSlotsList.
    // 4. Else, let slotsList be a new empty List.

    // 5. Return OrdinaryObjectCreate(proto, slotsList).
    retourne ordinary_object_create(realm, proto, rappel_allocation_objet);
}

/* 10.1.14 GetPrototypeFromConstructor ( constructor, intrinsicDefaultProto )
 * https://tc39.es/ecma262/multipage/ordinary-and-exotic-objects-behaviours.html#sec-getprototypefromconstructor */
get_prototype_from_constructor :: fonc (realm: *Realm, constructor: *Function, intrinsic_default_proto: *Object) -> *Object
{
    // 1. Assert: intrinsicDefaultProto is this specification's name of an intrinsic object.
    //    The corresponding object must be an intrinsic that is intended to be used as the
    //    [[Prototype]] value of an object.
    assert(est_intrinsics(realm, intrinsic_default_proto));

    // 2. Let proto be ? Get(constructor, "prototype").
    proto := get(constructor, STR_prototype);
    si possède_exception(realm) {
        retourne nul;
    }

    // 3. If proto is not an Object, then
    saufsi est_object(proto) {
        // À FAIRE : a. Let realm be ? GetFunctionRealm(constructor).
        // b. Set proto to realm's intrinsic object named intrinsicDefaultProto.
        proto.Object = intrinsic_default_proto;
    }

    // 4. Return proto.
    retourne donne_objet(proto);
}

/** \} */
