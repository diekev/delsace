importe Chaine;
importe ÉditionTexte;
importe Math;
importe Périphériques;
importe Typographie;
importe Unicode;

/* ------------------------------------------------------------------------- */
/** \nom Guetteuse.
 *
 * Les guetteuses servent à traquer les évènements survenant sur un élément
 * d'une interface graphique (panneau, bouton, etc.).
 * Quant un élément veut traquer les évènements conséquents à un évènement donné,
 * il peut créer une guetteuse locale pour les suivre sans quitter la fonction
 * où la guetteuse fut créée.
 *
 * Les applications clientes sont responsable de créer les conditions nécessaires
 * au guettage via Plateforme_Guettage.
 * \{ */

Plateforme_Guettage :: struct {
    sur_commence_guettage: fonc (plateforme: *Plateforme_Guettage, guetteuse: *Guetteuse);
    sur_termine_guettage: fonc (plateforme: *Plateforme_Guettage);
}

Guetteuse :: struct {
    plateforme: *Plateforme_Guettage;
    sur_termine_guettage: fonc (guetteuse: *Guetteuse);
    sur_clic: fonc (guetteuse: *Guetteuse, clic: Clic_Souris) -> État_Évènement;
    sur_roulement_souris: fonc (guetteuse: *Guetteuse, clic: Clic_Souris) -> État_Évènement;
    sur_déplacement_souris: fonc (guetteuse: *Guetteuse, état: État_Souris) -> État_Évènement;
    sur_touche_clavier: fonc (guetteuse: *Guetteuse, info: Info_Touche_Clavier) -> État_Évènement;
    sur_destruction: fonc (guetteuse: *Guetteuse);
}

commence_guettage :: fonc (guetteuse: *Guetteuse, plateforme: *Plateforme_Guettage)
{
    guetteuse.plateforme = plateforme;
    plateforme.sur_commence_guettage(plateforme, guetteuse);
}

termine_guettage :: fonc (guetteuse: *Guetteuse)
{
    si guetteuse.sur_termine_guettage {
        guetteuse.sur_termine_guettage(guetteuse);
    }

    si guetteuse.plateforme && guetteuse.plateforme.sur_termine_guettage {
        guetteuse.plateforme.sur_termine_guettage(guetteuse.plateforme);
    }

    si guetteuse.sur_destruction {
        guetteuse.sur_destruction(guetteuse);
    }    
}

État_Évènement :: énum {
    CONSOMMÉ;
    PASSE_AU_PARENT;
}

gère_évènement :: fonc (guetteuse: *Guetteuse, évènement: *Évènement) -> État_Évènement
{
    si évènement.type == Type_Évènement.SOURIS {
        si guetteuse.sur_clic && (évènement.action_souris == Action_Souris.PRESSÉE || évènement.action_souris == Action_Souris.RELACHÉE) {
            retourne guetteuse.sur_clic(guetteuse, donne_clic_souris(évènement));
        }

        si guetteuse.sur_déplacement_souris && (évènement.action_souris == Action_Souris.DÉPLACÉE) {
            retourne guetteuse.sur_déplacement_souris(guetteuse, évènement.état_souris);
        }

        si guetteuse.sur_roulement_souris && (évènement.action_souris == Action_Souris.ROULEMENT) {
            retourne guetteuse.sur_roulement_souris(guetteuse, donne_clic_souris(évènement));
        }

        retourne État_Évènement.PASSE_AU_PARENT;
    }

    si évènement.type == Type_Évènement.CLAVIER {
        si guetteuse.sur_touche_clavier && évènement.touche_pressée {
            retourne guetteuse.sur_touche_clavier(guetteuse, donne_info_touche(évènement));
        }
        retourne État_Évènement.PASSE_AU_PARENT;
    }

    retourne État_Évènement.PASSE_AU_PARENT;
}

initialise_guetteuse_pour_tout_consommer :: fonc (guetteuse: *Guetteuse)
{
    guetteuse.sur_clic = guetteuse_consomme_clic_souris;
    guetteuse.sur_roulement_souris = guetteuse_consomme_roulement_souris;
    guetteuse.sur_déplacement_souris = guetteuse_consomme_déplacement_souris;
    guetteuse.sur_touche_clavier = guetteuse_consomme_touche_clavier;
}

guetteuse_consomme_clic_souris :: fonc (guetteuse: *Guetteuse @inutilisée, clic: Clic_Souris @inutilisée) -> État_Évènement
{
    retourne État_Évènement.CONSOMMÉ;
}

guetteuse_consomme_roulement_souris :: fonc (guetteuse: *Guetteuse @inutilisée, clic: Clic_Souris @inutilisée) -> État_Évènement
{
    retourne État_Évènement.CONSOMMÉ;
}

guetteuse_consomme_déplacement_souris :: fonc (guetteuse: *Guetteuse @inutilisée, état: État_Souris @inutilisée) -> État_Évènement
{
    retourne État_Évènement.CONSOMMÉ;
}

guetteuse_consomme_touche_clavier :: fonc (guetteuse: *Guetteuse @inutilisée, info: Info_Touche_Clavier @inutilisée) -> État_Évènement
{
    retourne État_Évènement.CONSOMMÉ;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Guetteuse_Édition_Texte.
 * \{ */

État_Guettage_Édition_Texte :: énum {
    /* La guetteuse est lancée lorsque la souris est pressée dans le rect du texte.
     * Nous attendons le relâchement pour voir si l'édition doit commencer
     * (relâchement dans le rect) ou être avortée (relâchement hors du rect).  */
    ATTENTE_RELÂCHEMENT_CLIC;
    EN_ÉDITION;
    EN_SÉLECTION;
}

Guetteuse_Édition_Texte :: struct {
    empl base: Guetteuse;

    éditrice: *Éditrice_Texte;
    rect: RectanglePosDim(z32);
    rect_texte: RectanglePosDim(z32);

    état: État_Guettage_Édition_Texte;
    fin_guettage_fut_causé_par_touche_entrée: bool;

    sur_termine_guettage = guetteuse_édition_texte_sur_termine_guettage;
    sur_déplacement_souris = guetteuse_édition_texte_sur_déplacement_souris;
    sur_clic = guetteuse_édition_texte_sur_clic;
    sur_touche_clavier = guetteuse_édition_texte_sur_touche_clavier;
}

initialise_guetteuse_édition_texte :: fonc (guetteuse: *Guetteuse_Édition_Texte, éditrice: *Éditrice_Texte, rect: RectanglePosDim(z32), rect_texte: RectanglePosDim(z32))
{
    guetteuse.éditrice = éditrice;
    guetteuse.rect = rect;
    guetteuse.rect_texte = rect_texte;
}

guetteuse_édition_texte_sur_termine_guettage :: fonc (base: *Guetteuse)
{
    empl guetteuse := base comme *Guetteuse_Édition_Texte;
    termine_édition(éditrice, fin_guettage_fut_causé_par_touche_entrée);
}

guetteuse_édition_texte_sur_déplacement_souris :: fonc (base: *Guetteuse, souris: État_Souris) -> État_Évènement
{
    empl guetteuse := base comme *Guetteuse_Édition_Texte;

    saufsi état == État_Guettage_Édition_Texte.EN_SÉLECTION {
        retourne État_Évènement.PASSE_AU_PARENT;
    }

    indice := donne_position_curseur_pour_souris(guetteuse, souris);
    déplace_vers(*éditrice.curseur, Mode_Déplacement_Curseur.GARDE_ANCRE, indice);
    retourne État_Évènement.CONSOMMÉ;
}

guetteuse_édition_texte_sur_touche_clavier :: fonc (base: *Guetteuse, touche: Info_Touche_Clavier) -> État_Évènement
{
    empl guetteuse := base comme *Guetteuse_Édition_Texte;

    si état != État_Guettage_Édition_Texte.EN_ÉDITION {
        retourne État_Évènement.PASSE_AU_PARENT;
    }

    si touche.type == Touche_Clavier.ENTRÉE {
        si éditrice.mode == Mode_Édition_Texte.UNE_SEULE_LIGNE {
            guetteuse.fin_guettage_fut_causé_par_touche_entrée = vrai;
            termine_guettage(guetteuse);
        }
        sinon {
            ajoute_ligne(éditrice);
        }
        retourne État_Évènement.CONSOMMÉ;
    }

    sur_touche_clavier(éditrice, touche);
    retourne État_Évènement.CONSOMMÉ;
}

guetteuse_édition_texte_sur_clic :: fonc (base: *Guetteuse, clic: Clic_Souris) -> État_Évènement
{
    empl guetteuse := base comme *Guetteuse_Édition_Texte;

    résultat := État_Évènement.CONSOMMÉ;

    si clic.action == Action_Souris.PRESSÉE {
        si contient(rect, clic.état.où) {
            définis_position_curseur_pour_clic(guetteuse, clic.état);
            état = État_Guettage_Édition_Texte.EN_SÉLECTION;
        }
        sinon {
            termine_guettage(guetteuse);
            résultat = État_Évènement.PASSE_AU_PARENT;
        }
    }
    sinon si clic.action == Action_Souris.RELACHÉE {
        si contient(rect, clic.état.où) {
            si état == État_Guettage_Édition_Texte.ATTENTE_RELÂCHEMENT_CLIC {
                état = État_Guettage_Édition_Texte.EN_ÉDITION;
                démarre_édition(éditrice);
                définis_position_curseur_pour_clic(guetteuse, clic.état);
            }
            sinon si état == État_Guettage_Édition_Texte.EN_SÉLECTION {
                état = État_Guettage_Édition_Texte.EN_ÉDITION;
            }
        }
        sinon si état == État_Guettage_Édition_Texte.ATTENTE_RELÂCHEMENT_CLIC {
            termine_guettage(guetteuse);
            résultat = État_Évènement.PASSE_AU_PARENT;
        }
        sinon si état == État_Guettage_Édition_Texte.EN_SÉLECTION {
            état = État_Guettage_Édition_Texte.EN_ÉDITION;
        }
    }

    retourne résultat;
}

définis_position_curseur_pour_clic :: fonc (empl guetteuse: *Guetteuse_Édition_Texte, souris: État_Souris)
{
    position := donne_position_curseur_pour_souris(guetteuse, souris);
    définis_position(*éditrice.curseur, Mode_Déplacement_Curseur.DÉPLACE_ANCRE, position);
}

donne_position_curseur_pour_souris :: fonc (empl guetteuse: *Guetteuse_Édition_Texte, souris: État_Souris) -> z64
{
    position_relative := souris.où.x - rect_texte.x;
    indice := donne_indice_caractère_pour_position(éditrice.fonte, éditrice.texte_à_éditer, position_relative comme r32);

    si indice != -1 {
        retourne indice;
    }

    retourne taille(éditrice.texte_à_éditer);
}

/** \} */
