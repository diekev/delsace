/* ------------------------------------------------------------------------- */
/** \nom Contexte.
 *
 * Le Contexte sers à définir des action à performer sur les différents
 * évènements survenant au cours de la vie d'une #Prise.
 *
 * Il n'y a pas de limites sur le nombre de Contexte qu'une application
 * client peut créer. Par exemple, pour un navigateur Web, nous pouvons
 * avoir un Contexte normal pour les connexions "http" et un ContexteSSL
 * pour les connexions "https".
 */
Contexte :: struct {
    boucle_prises: *Boucle;

    /* rappels */
    quand_ouverture_: fonc (prise: *Prise, est_client: bool);
    quand_données_reçues_: fonc (prise: *Prise, données: []octet);
    quand_écriture_: fonc (prise: *Prise);
    quand_fermeture_: fonc (prise: *Prise);
    quand_timeout_: fonc (prise: *Prise);
    quand_fin_: fonc (prise: *Prise);
    quand_erreur_connexion_: fonc (prise: *Prise, type: Type_Erreur_Connexion, détail: chaine);

    taille_mémoire: z64;
    info_utilisateur: *InfoType;

    /* serveuse : optionnel */
    serveuse_: *rien;
    info_serveuse: *InfoType;

    est_ssl_ := faux;
}

crée_contexte :: fonc (boucle_prises: *Boucle, options: *OptionsCréationContexteSSL, $TypeDonnées: type_de_données) -> *Contexte
{
    si options {
        retourne crée_contexte_ssl(boucle_prises, mémoire(options), TypeDonnées);
    }

    retourne crée_contexte_impl(boucle_prises, Contexte, TypeDonnées);
}

// Fonction auxilliaire pour créer un contexte valide, mais dont les rappels ne font rien
// utile pour les développements.
crée_contexte_vide :: fonc (boucle_évènements: *Boucle, options: *OptionsCréationContexteSSL, $T: type_de_données) -> *Contexte
{
    ctx := crée_contexte(boucle_évènements, options, T);
    initialise_rappels_pour_contexte_vide(ctx);
    retourne ctx;
}

crée_contexte_vide :: fonc (boucle_évènements: *Boucle, $T: type_de_données) -> *Contexte
{
    retourne crée_contexte_vide(boucle_évènements, nul, T);
}

/* Initialise les fonctions de rappels pour un contexte « vide », c'est-à-dire qui ne fait rien.
 * Ceci nous sers principalement pour nous assurer que les pointeurs de fonction du contexte sont
 * propremenet initialisés et nous évite de toujours les vérifier avant de les appeler. */
initialise_rappels_pour_contexte_vide :: fonc (ctx: *Contexte)
{
    rappel_vide_quand_ouverture :: fonc (prise: *Prise @inutilisée, est_client: bool @inutilisée)
    {
    }

    rappel_vide_quand_données_reçues :: fonc (prise: *Prise @inutilisée, données: []octet @inutilisée)
    {
    }

    rappel_vide_quand_écriture :: fonc (prise: *Prise @inutilisée)
    {
    }

    rappel_vide_quand_fermeture :: fonc (prise: *Prise @inutilisée)
    {
    }

    rappel_vide_quand_timeout :: fonc (prise: *Prise @inutilisée)
    {
    }

    rappel_vide_quand_fin :: fonc (prise: *Prise @inutilisée)
    {
    }

    rappel_vide_quand_erreur_connexion :: fonc (prise: *Prise @inutilisée, type: Type_Erreur_Connexion @inutilisée, détail: chaine @inutilisée)
    {
    }

    ctx.mute_quand_ouverture(rappel_vide_quand_ouverture);
    ctx.mute_quand_données_reçues(rappel_vide_quand_données_reçues);
    ctx.mute_quand_écriture(rappel_vide_quand_écriture);
    ctx.mute_quand_fermeture(rappel_vide_quand_fermeture);
    ctx.mute_quand_timeout(rappel_vide_quand_timeout);
    ctx.mute_quand_fin(rappel_vide_quand_fin);
    ctx.mute_quand_erreur_connexion(rappel_vide_quand_erreur_connexion);
}

détruit_contexte :: fonc (ctx: *Contexte)
{
    si ctx.est_ssl() {
        détruit_contexte_ssl(ctx comme *ContextePriseSSL);
        retourne;
    }

    déloge_mémoire(ctx.taille_mémoire, ctx, info_de(Contexte), #position_code_source);
}

est_ssl :: fonc (ctx: *Contexte) -> bool #enligne
{
    retourne ctx.est_ssl_;
}

mute_serveuse :: fonc (contexte_: *Contexte, serveuse: *$T)
{
    contexte_.serveuse_ = serveuse;
    contexte_.info_serveuse = info_de(T);
}

accède_serveuse :: fonc (contexte_: *Contexte, $T: type_de_données) -> *T
{
    si info_de(T) != contexte_.info_serveuse {
        retourne nul;
    }

    retourne contexte_.serveuse_ comme *T;
}

données_utilisateur :: fonc (contexte_: *Contexte, $TypeDonnées: type_de_données) -> *TypeDonnées
{
    si contexte_.taille_mémoire == 0 {
        retourne nul;
    }

    si contexte_.info_utilisateur != info_de(TypeDonnées) {
        retourne nul;
    }

    si contexte_.est_ssl() {
        retourne ((contexte_ comme *ContextePriseSSL) + 1) comme *TypeDonnées;
    }

    retourne (contexte_ + 1) comme *TypeDonnées;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Création de prises.
 * \{ */

crée_prise_pour_écoute :: fonc (contexte_: *Contexte, adresse_ip: AdresseIPv4, port: n16, connexions_max: z32, $TypeDonnées: type_de_données) -> *Prise
{
    saufsi contexte_ {
        retourne nul;
    }

    // imprime("crée_prise_pour_écoute\n")
    fichier := tente ouvre_connexion_pour_écoute(adresse_ip, port, connexions_max) piège _ {
        // imprime("erreur lors de l'ouverture d'une connexion pour écoute : %\n", err)
        retourne nul;
    };

    prise := crée_prise_interne(contexte_, fichier, info_de(TypeDonnées));
    prise.type = TypePrise.SEMI_PRISE;

    si !ajoute_prise(contexte_.boucle_prises, prise, EPOLL_EVENTS.EPOLLIN) {
        prise.ferme();
        retourne nul;
    }

    retourne prise;
}

crée_prise_connexion :: fonc (contexte_: *Contexte, uri: *URI, $Type_Données: type_de_données) -> *Prise
{
    port := port_pour_uri(uri);
    retourne crée_prise_connexion(contexte_, uri.hôte, port, Type_Données);
}

crée_prise_connexion :: fonc (contexte_: *Contexte, hôte: chaine, port: n16, $Type_Données: type_de_données) -> *Prise
{
    saufsi contexte_ {
        retourne nul;
    }

    prise := crée_prise_interne(contexte_, Fichier(), info_de(Type_Données));
    prise.type = TypePrise.SEMI_PRISE;

    prise.fichier = tente ouvre_connexion_serveur(hôte, port, vrai) piège err {
        discr err {
            RésolutionHôteImpossible {
                notifie_erreur(prise, Type_Erreur_Connexion.HÔTE_INTROUVABLE);
            }
            CréationPriseImpossible {
                notifie_erreur(prise, Type_Erreur_Connexion.INCONNUE);
            }
            ConnexionPriseImpossible {
                notifie_erreur(prise, Type_Erreur_Connexion.INCONNUE);
            }
            sinon {
                notifie_erreur(prise, Type_Erreur_Connexion.INCONNUE);
            }
        }

        prise.ferme_connexion_en_cours();
        retourne prise;
    };

    si !ajoute_prise(contexte_.boucle_prises, prise, EPOLL_EVENTS.EPOLLOUT) {
        prise.ferme();
        retourne prise;
    }

    retourne prise;
}

Fonction_De_Rappel :: struct {
    fonction: fonc (fonction: *Fonction_De_Rappel, ctx: *Contexte);
}

/* Crée un chronomètre dans le ctx passé.
 * La Fonction_De_Rappel doit être valide pour toute la durée du chronomètre.
 */
crée_chronomètre :: fonc (ctx: *Contexte, interval: z32, commence_dans: z32, rappel: *Fonction_De_Rappel) -> *Prise
{
    saufsi ctx {
        retourne nul;
    }

    fd := timerfd_create(CLOCK_REALTIME, TFD_NONBLOCK);

    si fd < 0 {
        // imprime("Impossible de créer le fd pour le chronomètre !\n")
        retourne nul;
    }

    nouvelle_valeur : itimerspec = ---;
    nouvelle_valeur.it_interval = timespec_depuis_ms(interval);
    nouvelle_valeur.it_value = timespec_depuis_ms(commence_dans);

    si timerfd_settime(fd, 0, *nouvelle_valeur, nul) == -1 {
        // imprime("Impossible de mettre en place timerfd_settime !\n")
        retourne nul;
    }

    résultat := crée_prise_pour_rappel(ctx, fd, rappel);
    retourne résultat;
}

/* Crée une prise pour être notifié par des évènements.
 * Pour être notifié, il faut d'abord écrire dans la prise ou appeler #notifie_nouvel_évènement.
 */
crée_prise_évènements :: fonc (ctx: *Contexte, rappel: *Fonction_De_Rappel) -> *Prise
{
    saufsi ctx {
        retourne nul;
    }

    fd := eventfd(0, 0);
    si fd == -1 {
        imprimeln("[%] impossible de créer un descripteur pour eventfd", #nom_de_cette_fonction);
        retourne nul;
    }

    résultat := crée_prise_pour_rappel(ctx, fd, rappel);
    retourne résultat;
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Définition des rappels pour un Contexte.
 * \{ */

mute_quand_ouverture :: fonc (ctx: *Contexte, rappel: fonc (prise: *Prise, est_client: bool))
{
    ctx.quand_ouverture_ = si ctx.est_ssl() {
        contexte_ssl_parasite_quand_ouverture(ctx comme *ContextePriseSSL, rappel);
    }
    sinon {
        rappel;
    };
}

mute_quand_données_reçues :: fonc (ctx: *Contexte, rappel: fonc (prise: *Prise, données: []octet))
{
    ctx.quand_données_reçues_ = si ctx.est_ssl() {
        contexte_ssl_parasite_quand_données_reçues(ctx comme *ContextePriseSSL, rappel);
    }
    sinon {
        rappel;
    };
}

mute_quand_écriture :: fonc (ctx: *Contexte, rappel: fonc (prise: *Prise))
{
    ctx.quand_écriture_ = si ctx.est_ssl() {
        contexte_ssl_parasite_quand_écriture(ctx comme *ContextePriseSSL, rappel);
    }
    sinon {
        rappel;
    };
}

mute_quand_fermeture :: fonc (ctx: *Contexte, rappel: fonc (prise: *Prise))
{
    ctx.quand_fermeture_ = si ctx.est_ssl() {
        contexte_ssl_parasite_quand_fermeture(ctx comme *ContextePriseSSL, rappel);
    }
    sinon {
        rappel;
    };
}

mute_quand_timeout :: fonc (ctx: *Contexte, rappel: fonc (prise: *Prise))
{
    ctx.quand_timeout_ = si ctx.est_ssl() {
        contexte_ssl_parasite_quand_timeout(ctx comme *ContextePriseSSL, rappel);
    }
    sinon {
        rappel;
    };
}

mute_quand_fin :: fonc (ctx: *Contexte, rappel: fonc (prise: *Prise))
{
    ctx.quand_fin_ = si ctx.est_ssl() {
        contexte_ssl_parasite_quand_fin(ctx comme *ContextePriseSSL, rappel);
    }
    sinon {
        rappel;
    };
}

mute_quand_erreur_connexion :: fonc (ctx: *Contexte, rappel: fonc (prise: *Prise, type: Type_Erreur_Connexion, détail: chaine))
{
    ctx.quand_erreur_connexion_ = si ctx.est_ssl() {
        contexte_ssl_parasite_quand_erreur_connexion(ctx comme *ContextePriseSSL, rappel);
    }
    sinon {
        rappel;
    };
}

/** \} */

/* ------------------------------------------------------------------------- */
/** \nom Fonctions auxiliaires pour la création de prises et de contextes.
 * \{ */

#portée_module

/* Fonction de création d'un contexte selon son type (Contexte ou ContextePriseSSL)
 * Ceci allouera une quantité suffisante de mémoire pour tenir le contexte et une instance des TypeDeDonnéesUtilisateur. */
crée_contexte_impl :: fonc (boucle_prises: *Boucle, $TypeDuContexte: type_de_données, $TypeDeDonnéesUtilisateur: type_de_données) -> *TypeDuContexte
{
    taille_à_loger := (taille_de(TypeDuContexte) + taille_de(TypeDeDonnéesUtilisateur)) comme z64;
    mém_contexte_ := loge_mémoire(taille_à_loger, info_de(TypeDuContexte), #position_code_source);

    contexte_ := mém_contexte_ comme *TypeDuContexte;
    init_de(TypeDuContexte)(contexte_);

    contexte_.boucle_prises = boucle_prises;
    contexte_.taille_mémoire = taille_à_loger;
    contexte_.info_utilisateur = info_de(TypeDeDonnéesUtilisateur);

    retourne contexte_;
}

crée_prise_impl :: fonc (contexte_: *Contexte, fichier: Fichier, info_données_externes: *InfoType, $TypePrise: type_de_données) -> *Prise
{
    taille_à_loger := (taille_de(TypePrise) + info_données_externes.taille_en_octet) comme z64;
    mém_prise := loge_mémoire(taille_à_loger, info_de(TypePrise), #position_code_source);

    prise := mém_prise comme *TypePrise;
    init_de(TypePrise)(prise);

    prise.fichier = fichier;
    prise.contexte_ = contexte_;
    prise.taille_mémoire = taille_à_loger;
    prise.info_utilisateur = info_données_externes;
    retourne prise;
}

crée_prise_interne :: fonc (contexte_: *Contexte, fichier: Fichier, info_données_externes: *InfoType) -> *Prise
{
    si contexte_.est_ssl() {
        prise := crée_prise_impl(contexte_, fichier, info_données_externes, PriseSSL);
        prise.est_ssl_ = vrai;
        retourne prise;
    }

    retourne crée_prise_impl(contexte_, fichier, info_données_externes, Prise);
}

crée_prise_pour_rappel :: fonc (ctx: *Contexte, fd: z32, rappel: *Fonction_De_Rappel) -> *Prise
{
    fichier := Fichier(TypePoignéeFichier(fd));
    prise := crée_prise_interne(ctx, fichier, info_de(*Fonction_De_Rappel));
    prise.type = TypePrise.RAPPEL;
    ptr_fonc := prise.données_utilisateur(*Fonction_De_Rappel);
    mémoire(ptr_fonc) = rappel;

    si !ajoute_prise(ctx.boucle_prises, prise, EPOLL_EVENTS.EPOLLIN) {
        // imprime("Impossible d'ajouter la prise !\n")
        détruit_prise(prise);
        retourne nul;
    }

    retourne prise;
}

/** \} */
