/* Génération du code Kuri à partir des données du module. */

/* Retourne vrai si le type peut avoir des accesseurs ou mutateurs. */
type_supporte_getset :: fonc (type: *TypePython) -> bool
{
    si type.confidentialité == ConfidentialitéType.OPAQUE {
        retourne faux;
    }

    si type.drapeaux.TYPE_EST_ÉNUM || type.drapeaux.TYPE_EST_TABLEAU || type.drapeaux.TYPE_EST_ITÉRATEUR {
        retourne faux;
    }

    si type.rubriques.taille == 0 {
        /* Inutile de générer du code pour types n'ayant pas de rubriques. */
        retourne faux;
    }

    retourne vrai;
}

/* Génère les méthodes pour accéder et muter les rubriques du type. Retourne la globales où les méthodes sont initialisés. */
génère_méthodes_getset_pour_type :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    saufsi type_supporte_getset(type) {
        retourne copie_chaine("");
    }

    /* Déclare les fonctions get/set. */
    pour type.rubriques {
        type_rubrique := it.type;
        // get : fonc (object: *PyObject, data: *rien) -> *PyObject

        ajoute_au_tampon(enchaineuse, "get_", type.nom_sauf, "_", it.nom, " :: fonc (instance: *PyObject, closure: *rien @inutilisée) -> *PyObject\n");
        ajoute_au_tampon(enchaineuse, "{\n");
        ajoute_au_tampon(enchaineuse, "    notre_instance := (instance comme *", type.nom_sauf, "PourPython).notre_instance;\n");

        si type_rubrique.drapeaux.TYPE_EST_UNION {
            ajoute_au_tampon(enchaineuse, "    discr notre_instance {\n");
            ajoute_au_tampon(enchaineuse, "        ", it.nom, " {\n");
            ajoute_au_tampon(enchaineuse, "            rubrique := notre_instance.", it.nom, ";\n");
            ajoute_au_tampon(enchaineuse, "            retourne ", type_rubrique.fonctions.pour_construction, "(rubrique);\n");
            ajoute_au_tampon(enchaineuse, "        }\n");
            ajoute_au_tampon(enchaineuse, "        sinon {\n");
            ajoute_au_tampon(enchaineuse, "            retourne python_retourne_rien();\n");
            ajoute_au_tampon(enchaineuse, "        }\n");
            ajoute_au_tampon(enchaineuse, "    }\n");
        }
        sinon {
            ajoute_au_tampon(enchaineuse, "    rubrique := notre_instance.", it.nom, ";\n");
            ajoute_au_tampon(enchaineuse, "    retourne ", type_rubrique.fonctions.pour_construction, "(rubrique);\n");
        }
        ajoute_au_tampon(enchaineuse, "}\n");

        si it.confidentialité == ConfidentialitéType.MUTABLE {
            // set : fonc (instance: *PyObject, valeur: *PyObject, data: *rien) -> z32
            // retourne 0 pour un succès
            // retourne -1 pour une erreur
            ajoute_au_tampon(enchaineuse, "set_", type.nom_sauf, "_", it.nom, " :: fonc (instance: *PyObject, valeur: *PyObject, closure: *rien@inutilisée) -> z32\n");
            ajoute_au_tampon(enchaineuse, "{\n");

            ajoute_au_tampon(enchaineuse, "    si ", type_rubrique.fonctions.pour_discrimination, "(valeur) {\n");
            ajoute_au_tampon(enchaineuse, "    notre_instance := *(instance comme *", type.nom_sauf, "PourPython).notre_instance;\n");
            si it.type.drapeaux.TYPE_EST_ÉNUM {
                ajoute_au_tampon(enchaineuse, "    si PyUnicode_Check(valeur) {\n");
                ajoute_au_tampon(enchaineuse, "        notre_instance.", it.nom, " = ", type_rubrique.fonctions.pour_valeur_unicode_enum, "(valeur, info_de(", it.type.nom, ")) comme ", it.type.nom, ";\n");
                ajoute_au_tampon(enchaineuse, "    }\n");
                ajoute_au_tampon(enchaineuse, "    sinon {\n");
                ajoute_au_tampon(enchaineuse, "        notre_instance.", it.nom, " = ", type_rubrique.fonctions.pour_extraction_valeur, "(valeur).notre_instance;\n");
                ajoute_au_tampon(enchaineuse, "    }\n");
            }
            sinon si it.type.est_basique {
                ajoute_au_tampon(enchaineuse, "    notre_instance.", it.nom, " = ", type_rubrique.fonctions.pour_extraction_valeur, "(valeur);\n");
            }
            sinon {
                ajoute_au_tampon(enchaineuse, "    notre_instance.", it.nom, " = ", type_rubrique.fonctions.pour_extraction_valeur, "(valeur).notre_instance;\n");
            }
            ajoute_au_tampon(enchaineuse, "    retourne 0;\n");
            ajoute_au_tampon(enchaineuse, "    }\n");

            si it.type.drapeaux.TYPE_EST_ÉNUM {
                assigne_énum_depuis_chaine := «
    si PyUnicode_Check(valeur) {
        valeur_chaine := PyUnicode_AsChaine(valeur);
        retourne Py_AssigneChaineÉnum(*(instance comme *%PourPython).notre_instance.%, valeur_chaine);
    }
»;

                imprime_dans_enchaineuse(enchaineuse, assigne_énum_depuis_chaine, type.nom_sauf, it.nom);
            }

            ajoute_au_tampon(enchaineuse, "    retourne PyErr_MauvaisTypeAssignement(valeur, \"", it.type.nom, "\");\n");
            ajoute_au_tampon(enchaineuse, "}\n");
        }
    }

    nom_globale := enchaine("getset_", type.nom_sauf);

    /* Déclare la globale, nous devons ajouter un élément supplémentaire à la fin. */
    imprime_dans_enchaineuse(enchaineuse, "% := [\n", nom_globale);

    pour type.rubriques {
        imprime_dans_enchaineuse(enchaineuse, "    PyGetSetDef(name = ChaineC(\"%\".caractères), ", it.nom);
        imprime_dans_enchaineuse(enchaineuse, "get = get_%_%, ", type.nom_sauf, it.nom);
        si it.confidentialité == ConfidentialitéType.MUTABLE {
            imprime_dans_enchaineuse(enchaineuse, "set = set_%_%, ", type.nom_sauf, it.nom);
        }
        sinon {
            ajoute_au_tampon(enchaineuse, "set = nul, ");
        }
        imprime_dans_enchaineuse(enchaineuse, "doc = ChaineC(nul), ");
        imprime_dans_enchaineuse(enchaineuse, "closure = nul),\n");
    }
    imprime_dans_enchaineuse(enchaineuse, "    PyGetSetDef(name = ChaineC(nul), get = nul, set = nul, doc = ChaineC(nul), closure = nul)\n");
    ajoute_au_tampon(enchaineuse, "];\n");

    retourne nom_globale;
}

/* Retourne vrai si le type peut avoir être accéder via objet["clé"]. */
type_supporte_mapping :: fonc (type: *TypePython) -> bool
{
    /* Pour le moment la logique est la même que pour les accesseurs/mutateurs. */
    retourne type_supporte_getset(type);
}

génère_globale_as_mapping :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    saufsi type_supporte_mapping(type) {
        retourne copie_chaine("");
    }

    /* Génère la fonction pour PyMappingMethods.mp_length. */
    nom_fonction_mp_length := enchaine("mp_length_pour_", type.nom_sauf);
    diffère déloge(*nom_fonction_mp_length);

    ajoute_au_tampon(enchaineuse, nom_fonction_mp_length, " :: fonc (self: *PyObject @inutilisée) -> Py_ssize_t\n");
    imprime_dans_enchaineuse(enchaineuse, "{\nretourne %;\n}\n", type.rubriques.taille);

    /* Génère la fonction pour PyMappingMethods.mp_subscript. */
    nom_fonction_mp_subscript := enchaine("mp_subscript_pour_", type.nom_sauf);
    diffère déloge(*nom_fonction_mp_subscript);

    ajoute_au_tampon(enchaineuse, nom_fonction_mp_subscript, " :: fonc (self: *PyObject, key: *PyObject) -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n    nom_rubrique := PyUnicode_AsChaine(key);\n");

    possède_rubrique_mutable := faux;

    pour type.rubriques {
        ajoute_au_tampon(enchaineuse, "    si nom_rubrique == \"", it.nom, "\" {\n");
        ajoute_au_tampon(enchaineuse, "         retourne get_", type.nom_sauf, "_", it.nom, "(self, nul);\n");
        ajoute_au_tampon(enchaineuse, "    }\n");

        si it.confidentialité == ConfidentialitéType.MUTABLE {
            possède_rubrique_mutable = vrai;
        }
    }

    ajoute_au_tampon(enchaineuse, "     retourne PyErr_CléInconnue(self, nom_rubrique);\n");
    ajoute_au_tampon(enchaineuse, "}\n");

    /* Génère la fonction pour PyMappingMethods.mp_ass_subscript. */
    nom_fonction_mp_ass_subscript := "nul";
    diffère si nom_fonction_mp_ass_subscript != "nul" { déloge(*nom_fonction_mp_ass_subscript); }

    si possède_rubrique_mutable {
        nom_fonction_mp_ass_subscript = enchaine("mp_ass_subscript_pour_", type.nom_sauf);

        ajoute_au_tampon(enchaineuse, nom_fonction_mp_ass_subscript, " :: fonc (self: *PyObject, key: *PyObject, v: *PyObject) -> z32\n");
        ajoute_au_tampon(enchaineuse, "{\n    nom_rubrique := PyUnicode_AsChaine(key);\n");
        ajoute_au_tampon(enchaineuse, "    si v == nul {\n");
        ajoute_au_tampon(enchaineuse, "        retourne PyErr_AttributNonSupprimable(self, nom_rubrique);\n");
        ajoute_au_tampon(enchaineuse, "    }\n");

        pour type.rubriques {
            ajoute_au_tampon(enchaineuse, "    si nom_rubrique == \"", it.nom, "\" {\n");
            si it.confidentialité == ConfidentialitéType.MUTABLE {
                ajoute_au_tampon(enchaineuse, "         retourne set_", type.nom_sauf, "_", it.nom, "(self, v, nul);\n");
            }
            sinon {
                ajoute_au_tampon(enchaineuse, "         retourne PyErr_AttributNonMutable(self, nom_rubrique);\n");
            }
            ajoute_au_tampon(enchaineuse, "    }\n");
        }
        ajoute_au_tampon(enchaineuse, "     _ := PyErr_CléInconnue(self, nom_rubrique);\n retourne -1;\n");
        ajoute_au_tampon(enchaineuse, "}\n");
    }

    /* Génère la globale. */
    nom_globale := enchaine("py_mapping_methods_pour_", type.nom_sauf);

    ajoute_au_tampon(enchaineuse, nom_globale, " := PyMappingMethods (", nom_fonction_mp_length, ", ", nom_fonction_mp_subscript, ", ", nom_fonction_mp_ass_subscript, ");\n");

    retourne nom_globale;
}

génère_fonction_new :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    méthode := *type.new;

    saufsi méthode.nom {
        retourne copie_chaine("");
    }

    nom_fonction_new := enchaine("new_", type.nom_sauf);

    args_inutilisés := "";
    saufsi méthode.paramètres_entrée {
        args_inutilisés = " @inutilisée";
    }

    ajoute_au_tampon(enchaineuse, nom_fonction_new, " :: fonc (subtype: *PyTypeObject, args: *PyObject", args_inutilisés, ", kwds: *PyObject @inutilisée) -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");

    /* Parse les arguments. */
    génère_parsage_args_tuple(enchaineuse, méthode, "nul");

    /* Appel la fonction d'initialisation. */
    génère_conversion_args_vers_kuri(enchaineuse, méthode);

    si type.drapeaux.TOUJOURS_COMME_POINTEUR {
        ajoute_au_tampon(enchaineuse, "    résultat := loge(", type.nom, ");\n");
        ajoute_au_tampon(enchaineuse, "    succès := ");
        génère_appel_méthode_kuri(enchaineuse, méthode, "résultat");
    }
    sinon {
        ajoute_au_tampon(enchaineuse, "    résultat :", type.nom, ";\n");
        ajoute_au_tampon(enchaineuse, "    succès := ");
        génère_appel_méthode_kuri(enchaineuse, méthode, "*résultat");
    }

    ajoute_au_tampon(enchaineuse, "    saufsi succès {\n");
    ajoute_au_tampon(enchaineuse, "        retourne nul;\n");
    ajoute_au_tampon(enchaineuse, "    }\n");

    /* Crée un objet python correspondant, et retourne. */
    ajoute_au_tampon(enchaineuse, "    objet_résultat := subtype.tp_alloc(subtype, 0) comme *", type.nom_sauf, "PourPython;\n");
    ajoute_au_tampon(enchaineuse, "    objet_résultat.notre_instance = résultat;\n");
    ajoute_au_tampon(enchaineuse, "    retourne objet_résultat;\n");
    ajoute_au_tampon(enchaineuse, "}\n");

    retourne nom_fonction_new;
}

génère_fonction_str :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    méthode := type.str;

    saufsi méthode.nom || type.drapeaux.TYPE_EST_ÉNUM {
        retourne copie_chaine("");
    }

    nom_fonction_str := enchaine("str_", type.nom_sauf);

    // doit retourner un PyUnicodeObject
    ajoute_au_tampon(enchaineuse, nom_fonction_str, ":: fonc (self: *PyObject) -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    notre_instance := ", type.fonctions.pour_extraction_valeur, "(self).notre_instance;\n");
    si type.drapeaux.TYPE_EST_ÉNUM {
        ajoute_au_tampon(enchaineuse, "    info_énum := info_de(", type.nom, ");\n");

        type_énum_kuri := type.type_kuri comme *InfoTypeÉnum;
        ajoute_au_tampon(enchaineuse, "    résultat := donne_nom_énum_pour_valeur(info_énum, notre_instance comme ", donne_chaine_type_sousjacent(type_énum_kuri), ");\n");
    }
    sinon {
        ajoute_au_tampon(enchaineuse, "    résultat := ", méthode.nom, "(*notre_instance);\n");
    }
    ajoute_au_tampon(enchaineuse, "    retourne PyUnicode_FromChaine(résultat);\n");
    ajoute_au_tampon(enchaineuse, "}\n");

    retourne nom_fonction_str;
}

donne_chaine_type_sousjacent :: fonc (type_énum: *InfoTypeÉnum) -> chaine
{
    type_sous_jacent := type_énum.type_sous_jacent;
    si type_sous_jacent.est_signé {
        si type_sous_jacent.taille_en_octet == 1 {
            retourne "z8";
        }
        sinon si type_sous_jacent.taille_en_octet == 2 {
            retourne "z16";
        }
        sinon si type_sous_jacent.taille_en_octet == 4 {
            retourne "z32";
        }
        sinon si type_sous_jacent.taille_en_octet == 8 {
            retourne "z64";
        }
    }
    sinon {
        si type_sous_jacent.taille_en_octet == 1 {
            retourne "n8";
        }
        sinon si type_sous_jacent.taille_en_octet == 2 {
            retourne "n16";
        }
        sinon si type_sous_jacent.taille_en_octet == 4 {
            retourne "n32";
        }
        sinon si type_sous_jacent.taille_en_octet == 8 {
            retourne "n64";
        }
    }
    retourne "ERREUR TYPE SOUS JACENT";
}

/* https://docs.python.org/3/c-api/typeobj.html#c.PyTypeObject.tp_hash */
génère_fonction_hash :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    méthode := type.hash;

    si méthode.nom {
        nom_fonction_hash := enchaine("hash_", type.nom_sauf);

        ajoute_au_tampon(enchaineuse, nom_fonction_hash, ":: fonc (self: *PyObject) -> Py_hash_t\n");
        ajoute_au_tampon(enchaineuse, "{\n");
        ajoute_au_tampon(enchaineuse, "    notre_instance := ", type.fonctions.pour_extraction_valeur, "(self).notre_instance;\n");
        ajoute_au_tampon(enchaineuse, "    résultat := ", méthode.nom, "(*notre_instance);\n");
        ajoute_au_tampon(enchaineuse, "    retourne résultat;\n");
        ajoute_au_tampon(enchaineuse, "}\n");

        retourne nom_fonction_hash;
    }

    /* Pour les énums, nous retournons simplement la valeur, qui est sensée être unique. */
    si type.drapeaux.TYPE_EST_ÉNUM {
        nom_fonction_hash := enchaine("hash_", type.nom_sauf);

        ajoute_au_tampon(enchaineuse, nom_fonction_hash, ":: fonc (self: *PyObject) -> Py_hash_t\n");
        ajoute_au_tampon(enchaineuse, "{\n");
        ajoute_au_tampon(enchaineuse, "    notre_instance := ", type.fonctions.pour_extraction_valeur, "(self).notre_instance;\n");
        type_énum_kuri := type.type_kuri comme *InfoTypeÉnum;
        ajoute_au_tampon(enchaineuse, "    retourne notre_instance comme ", donne_chaine_type_sousjacent(type_énum_kuri), " comme Py_hash_t;\n");
        ajoute_au_tampon(enchaineuse, "}\n");

        retourne nom_fonction_hash;
    }

    /* Pour les types étant toujours stockés par adresse, nous pouvons utilisé l'adresse comme empreinte. */
    si type.drapeaux.TOUJOURS_COMME_POINTEUR {
        nom_fonction_hash := enchaine("hash_", type.nom_sauf);

        ajoute_au_tampon(enchaineuse, nom_fonction_hash, ":: fonc (self: *PyObject) -> Py_hash_t\n");
        ajoute_au_tampon(enchaineuse, "{\n");
        ajoute_au_tampon(enchaineuse, "    notre_instance := ", type.fonctions.pour_extraction_valeur, "(self).notre_instance;\n");
        ajoute_au_tampon(enchaineuse, "    retourne notre_instance comme z64;\n");
        ajoute_au_tampon(enchaineuse, "}\n");

        retourne nom_fonction_hash;
    }

    /* PyObject_HashNotImplemented doit être utilisé afin de pouvoir bloquer l'héritage
     * de la fonction de hachage des parents, et permet d'utiliser correctement
     * isinstance(o, collections.Hashable).
     */
    retourne copie_chaine("PyObject_HashNotImplemented");
}

/* https://docs.python.org/3/c-api/typeobj.html#c.PyTypeObject.tp_richcompare */
génère_fonction_richcompare :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    saufsi type.drapeaux.TYPE_EST_ÉNUM {
        retourne copie_chaine("");
    }

    nom_fonction_richcompare := enchaine("richcompare_", type.nom_sauf);

    compare_énum_avec_chaine := «
    si PyUnicode_Check(other) {
        valeur_chaine := PyUnicode_AsChaine(other);
        valeur_énum := Py%_As%(self).notre_instance;
        retourne Py_compare_énum_chaine(valeur_énum, op, valeur_chaine);
    }
»;

    compare_énum_avec_énum := «
    si Py%_Check(other) {
        valeur1 := Py%_As%(self).notre_instance;
        valeur2 := Py%_As%(other).notre_instance;
        retourne Py_compare_énum_énum(valeur1, op, valeur2);
    }
»;

    ajoute_au_tampon(enchaineuse, nom_fonction_richcompare, ":: fonc (self: *PyObject, other: *PyObject, op: z32) -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");

    imprime_dans_enchaineuse(enchaineuse, compare_énum_avec_chaine, type.nom_sauf, type.nom_sauf);
    imprime_dans_enchaineuse(enchaineuse, compare_énum_avec_énum, type.nom_sauf, type.nom_sauf, type.nom_sauf, type.nom_sauf, type.nom_sauf);

    ajoute_au_tampon(enchaineuse, "    retourne PyErr_ComparaisonImpossible(other, \"", type.nom, "\");\n");
    ajoute_au_tampon(enchaineuse, "}\n");

    retourne nom_fonction_richcompare;
}

génère_fonction_repr :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    méthode := type.repr;

    saufsi méthode.nom {
        retourne copie_chaine("");
    }

    nom_fonction_repr := enchaine("repr_", type.nom_sauf);

    // doit retourner un PyUnicodeObject
    ajoute_au_tampon(enchaineuse, nom_fonction_repr, ":: fonc (self: *PyObject) -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    notre_instance := ", type.fonctions.pour_extraction_valeur, "(self).notre_instance;\n");
    ajoute_au_tampon(enchaineuse, "    résultat := ", méthode.nom, "(*notre_instance);\n");
    ajoute_au_tampon(enchaineuse, "    résultat = enchaine(\"", type.nom, "('\", résultat, \"')\");\n");
    ajoute_au_tampon(enchaineuse, "    retourne PyUnicode_FromChaine(résultat);\n");
    ajoute_au_tampon(enchaineuse, "}\n");

    retourne nom_fonction_repr;
}

génère_fonctions_protocole_tampons :: fonc (enchaineuse: *Enchaineuse, type: *TypePython)
{
    ajoute_au_tampon(enchaineuse, "remplis_champs_requis_py_buffer_pour_", type.nom_globale_type, ":: fonc (self: *BasePyBuffer, view: *Py_buffer)\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    notre_instance := ", type.fonctions.pour_extraction_valeur, "(self).notre_instance;\n");
    ajoute_au_tampon(enchaineuse, "    remplis_champs_requis_py_buffer_générique(view, notre_instance);\n");
    ajoute_au_tampon(enchaineuse, "}\n");
}

génère_fonctions_protocole_séquences :: fonc (enchaineuse: *Enchaineuse, type: *TypePython)
{
    ajoute_au_tampon(enchaineuse, "PySequenceMethodsPour", type.nom_sauf, ": PySequenceMethods;\n");

    /* sq_length */
    ajoute_au_tampon(enchaineuse, "sq_length_pour_", type.nom_sauf, " :: fonc (self: *PyObject) -> Py_ssize_t\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    notre_instance := ", type.fonctions.pour_extraction_valeur, "(self).notre_instance;\n");
    ajoute_au_tampon(enchaineuse, "    retourne notre_instance.taille;\n");
    ajoute_au_tampon(enchaineuse, "}\n");

    /* sq_item */
    ajoute_au_tampon(enchaineuse, "sq_item_pour_", type.nom_sauf, " :: fonc (self: *PyObject, indice: Py_ssize_t) -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    notre_instance := ", type.fonctions.pour_extraction_valeur, "(self).notre_instance;\n");
    // À FAIRE : erreur dépassement limites ?
    sous_type := type.type_élément;
    ajoute_au_tampon(enchaineuse, "    retourne ", sous_type.fonctions.pour_construction, "(notre_instance[indice]);\n");
    ajoute_au_tampon(enchaineuse, "}\n");

    /* init */
    ajoute_au_tampon(enchaineuse, "init_PySequenceMethodsPour", type.nom_sauf, " :: fonc () -> *PySequenceMethods\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    init_de(PySequenceMethods)(*PySequenceMethodsPour", type.nom_sauf, ");\n");
    /* À FAIRE : pour le moment nous n'implémentons que sq_item et sq_length. */
    ajoute_au_tampon(enchaineuse, "    PySequenceMethodsPour", type.nom_sauf, ".sq_item = sq_item_pour_", type.nom_sauf, ";\n");
    ajoute_au_tampon(enchaineuse, "    PySequenceMethodsPour", type.nom_sauf, ".sq_length = sq_length_pour_", type.nom_sauf, ";\n");
    ajoute_au_tampon(enchaineuse, "    retourne *PySequenceMethodsPour", type.nom_sauf, ";\n");
    ajoute_au_tampon(enchaineuse, "}\n");
}

génère_déclaration_type_python :: fonc (enchaineuse: *Enchaineuse, module: *ModulePython, type: *TypePython)
{
    /* Déclaration de la structure associée, dérivée de PyObject.
     * Pour une structure appelée « Structure », la version Python s'appelera « StructurePourPython ». */
    ajoute_au_tampon(enchaineuse, type.nom_sauf, "PourPython :: struct {\n");
    si type.drapeaux.TYPE_EST_TABLEAU {
        ajoute_au_tampon(enchaineuse, "    empl base_py_buffer: BasePyBuffer;\n");
    }
    sinon {
        ajoute_au_tampon(enchaineuse, "    empl base_py_object: PyObject;\n");
    }
    symbole_pointeur := "";
    si type.drapeaux.TOUJOURS_COMME_POINTEUR {
        symbole_pointeur = "*";
    }
    si type.drapeaux.TYPE_EST_ITÉRATEUR {
        ajoute_au_tampon(enchaineuse, "    notre_instance: ", type.type_itéré.nom_type_kuri, ";\n");
        ajoute_au_tampon(enchaineuse, "    index_courant: z64;\n");
    }
    sinon {
        ajoute_au_tampon(enchaineuse, "    notre_instance: ", symbole_pointeur, type.nom_type_kuri, ";\n");
    }
    ajoute_au_tampon(enchaineuse, "}\n");

    /* Déclaration des FonctionsTypePython. */
    génère_déclaration_fonctions_pour_python(enchaineuse, type, symbole_pointeur);

    /*
        À FAIRE : méthodes types
            __init__ pour les rubriques mutables

            NomDuType.tp_flags = Py_TPFLAGS_DEFAULT|Py_TPFLAGS_BASETYPE;

     */

    si type.méthodes {
        pour * type.méthodes {
            génère_interface_fonction(enchaineuse, it, type);
        }
        nom_tableau := enchaine("méthodes_", type.nom_sauf);
        diffère déloge(*nom_tableau);
        génère_tableaux_méthodes(enchaineuse, type.méthodes, nom_tableau);
    }

    globale_getset := génère_méthodes_getset_pour_type(enchaineuse, type);
    diffère déloge(*globale_getset);

    /* Afin de supporter les expressions de type : o[key] = v */
    globale_as_mapping := génère_globale_as_mapping(enchaineuse, type);
    diffère déloge(*globale_as_mapping);

    fonction_new := génère_fonction_new(enchaineuse, type);
    diffère déloge(*fonction_new);

    // À FAIRE __init__
    // fonction_init := génère_fonction_init(enchaineuse, type)
    // diffère déloge(*fonction_init)

    fonction_str := génère_fonction_str(enchaineuse, type);
    diffère déloge(*fonction_str);

    fonction_repr := génère_fonction_repr(enchaineuse, type);
    diffère déloge(*fonction_repr);

    fonction_richcompare := génère_fonction_richcompare(enchaineuse, type);
    diffère déloge(*fonction_richcompare);

    fonction_itérateur := génère_fonction_pour_créer_itérateur(enchaineuse, type);
    diffère déloge(*fonction_itérateur);

    fonction_itérateur_next := génère_fonction_itérateur_next(enchaineuse, type);
    diffère déloge(*fonction_itérateur_next);

    fonction_hash := génère_fonction_hash(enchaineuse, type);
    diffère déloge(*fonction_hash);

    si type.drapeaux.TYPE_EST_TABLEAU {
        génère_fonctions_protocole_tampons(enchaineuse, type);
        génère_fonctions_protocole_séquences(enchaineuse, type);
    }

    /* Déclaration de la globale qui servira pour contenir les données sur le type Python.
     * Cet objet s'appel « TypeStructurePourPython ». */
    nom_globale_type := type.nom_globale_type;
    ajoute_au_tampon(enchaineuse, nom_globale_type, ":= PyTypeObject(\n");

    /* Le nom requis pour Python, qui est de forme <module>.<nom>. */
    tp_name := enchaine(module.nom, ".", type.nom_sauf);
    diffère déloge(*tp_name);

    ajoute_au_tampon(enchaineuse, "    ob_refcnt = 1,\n");
    ajoute_au_tampon(enchaineuse, "    ob_size = 0,\n");
    ajoute_au_tampon(enchaineuse, "    tp_basicsize = taille_de(", type.nom_sauf, "PourPython) comme Py_ssize_t,\n");
    ajoute_au_tampon(enchaineuse, "    tp_name = ChaineC(\"", tp_name, "\".caractères),\n");
    ajoute_au_tampon(enchaineuse, "    tp_flags = 1 << 10 | 1 << 18,\n");

    si type.méthodes {
        ajoute_au_tampon(enchaineuse, "    tp_methods = méthodes_", type.nom_sauf, ".données,\n");
    }

    si fonction_new {
        ajoute_au_tampon(enchaineuse, "    tp_new = ", fonction_new, ",\n");
    }

    si fonction_str {
        ajoute_au_tampon(enchaineuse, "    tp_str = ", fonction_str, ",\n");
    }

    si fonction_repr {
        ajoute_au_tampon(enchaineuse, "    tp_repr = ", fonction_repr, ",\n");
    }

    si fonction_richcompare {
        ajoute_au_tampon(enchaineuse, "    tp_richcompare = ", fonction_richcompare, ",\n");
    }

    si fonction_itérateur {
        ajoute_au_tampon(enchaineuse, "    tp_iter = ", fonction_itérateur, ",\n");
    }

    si fonction_itérateur_next {
        ajoute_au_tampon(enchaineuse, "    tp_iter = iter_pour_type_itérateur,\n");
        ajoute_au_tampon(enchaineuse, "    tp_iternext = ", fonction_itérateur_next, ",\n");
    }

    si globale_getset {
        ajoute_au_tampon(enchaineuse, "    tp_getset = ", globale_getset, ".données,\n");
    }

    si type.base {
        ajoute_au_tampon(enchaineuse, "    tp_base = *", type.base.nom_globale_type, ",\n");
    }
    sinon {
        ajoute_au_tampon(enchaineuse, "    tp_base = *PyBaseObject_Type,\n");
    }

    si globale_as_mapping {
        ajoute_au_tampon(enchaineuse, "    tp_as_mapping = *", globale_as_mapping, ",\n");
    }

    si type.drapeaux.TYPE_EST_TABLEAU {
        ajoute_au_tampon(enchaineuse, "    tp_as_buffer = protocol_tampon_défaut(),\n");
        ajoute_au_tampon(enchaineuse, "    tp_as_sequence = init_PySequenceMethodsPour", type.nom_sauf, "(),\n");
    }

    ajoute_au_tampon(enchaineuse, "    tp_hash = ", fonction_hash, ");\n");
}

génère_déclaration_fonctions_pour_python :: fonc (enchaineuse: *Enchaineuse, type: *TypePython, symbole_pointeur: chaine)
{
    ajoute_au_tampon(enchaineuse, type.fonctions.pour_extraction_valeur, " :: fonc (self: *PyObject) -> *", type.nom_sauf, "PourPython\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    retourne self comme *", type.nom_sauf, "PourPython;\n");
    ajoute_au_tampon(enchaineuse, "}\n");

    si type.drapeaux.TYPE_EST_ITÉRATEUR {
        /* Les autres fonctions ne sont pas disponibles pour les itérateurs. */
        retourne;
    }

    ajoute_au_tampon(enchaineuse, type.fonctions.pour_discrimination, " :: fonc (self: *PyObject) -> bool\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    si PyObject_TypeCheck(self, *", type.nom_globale_type, ") {\n");
    ajoute_au_tampon(enchaineuse, "        retourne vrai;\n");
    ajoute_au_tampon(enchaineuse, "    }\n");
    si type.drapeaux.TYPE_EST_ÉNUM {
        ajoute_au_tampon(enchaineuse, "    si PyUnicodeEnum_Check(self, info_de(", type.nom, ")) {\n");
        ajoute_au_tampon(enchaineuse, "        retourne vrai;\n");
        ajoute_au_tampon(enchaineuse, "    }\n");
    }
    si type.drapeaux.TOUJOURS_COMME_POINTEUR {
        ajoute_au_tampon(enchaineuse, "    si self == Py_None {\n");
        ajoute_au_tampon(enchaineuse, "        retourne vrai;\n");
        ajoute_au_tampon(enchaineuse, "    }\n");
    }
    ajoute_au_tampon(enchaineuse, "    retourne faux;\n");
    ajoute_au_tampon(enchaineuse, "}\n");
    ajoute_au_tampon(enchaineuse, type.fonctions.pour_construction, " :: fonc (valeur: ", symbole_pointeur, type.nom_type_kuri, ") -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    génère_corps_fonction_construction_objet(enchaineuse, type);
    ajoute_au_tampon(enchaineuse, "}\n");

    /* Fonction générique de création d'objet. */
    ajoute_au_tampon(enchaineuse, type.fonctions.pour_construction, "_générique :: fonc (valeur: eini) -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    assert(valeur.info == info_de(", symbole_pointeur, type.nom_type_kuri, "));\n");
    ajoute_au_tampon(enchaineuse, "    retourne ", type.fonctions.pour_construction, "(mémoire(valeur.données comme *", symbole_pointeur, type.nom_type_kuri, "));\n");
    ajoute_au_tampon(enchaineuse, "}\n");
}

/* Corps des fonctions PyXXX_From_XXX */
génère_corps_fonction_construction_objet :: fonc (enchaineuse: *Enchaineuse, type: *TypePython)
{
    si type.drapeaux.TYPE_EST_RÉSULTAT {
        ajoute_au_tampon(enchaineuse, "    discr valeur {\n");
        ajoute_au_tampon(enchaineuse, "        Ok(r) {\n");
        ajoute_au_tampon(enchaineuse, "            retourne ", type.type_ok.fonctions.pour_construction, "(r);\n");
        ajoute_au_tampon(enchaineuse, "        }\n");
        ajoute_au_tampon(enchaineuse, "        Erreur(e) {\n");
        ajoute_au_tampon(enchaineuse, "            retourne PyErr_Raise_", type.type_erreur.nom, "(e);\n");
        ajoute_au_tampon(enchaineuse, "        }\n");
        ajoute_au_tampon(enchaineuse, "        sinon {\n");
        ajoute_au_tampon(enchaineuse, "            retourne PyErr_Raise_Generic(\"Erreur inconnue\");\n");
        ajoute_au_tampon(enchaineuse, "        }\n");
        ajoute_au_tampon(enchaineuse, "    }\n");
        retourne;
    }

    si type.drapeaux.TYPE_EST_OPTIONNEL {
        ajoute_au_tampon(enchaineuse, "    discr valeur {\n");
        ajoute_au_tampon(enchaineuse, "        Quelque(r) {\n");
        si type.type_quelque.nom == "ErreurPython" {
            /* Relance l'erreur. */
            ajoute_au_tampon(enchaineuse, "            retourne PyErr_Raise_Erreur(r);\n");
        }
        sinon {
            ajoute_au_tampon(enchaineuse, "            retourne ", type.type_quelque.fonctions.pour_construction, "(r);\n");
        }
        ajoute_au_tampon(enchaineuse, "        }\n");
        ajoute_au_tampon(enchaineuse, "        sinon {\n");
        ajoute_au_tampon(enchaineuse, "            retourne python_retourne_rien();\n");
        ajoute_au_tampon(enchaineuse, "        }\n");
        ajoute_au_tampon(enchaineuse, "    }\n");
        retourne;
    }

    si type.drapeaux.TOUJOURS_COMME_POINTEUR {
        ajoute_au_tampon(enchaineuse, "    saufsi valeur {\n");
        ajoute_au_tampon(enchaineuse, "        retourne python_retourne_rien() comme *", type.nom_sauf, "PourPython;\n");
        ajoute_au_tampon(enchaineuse, "    }\n");
    }

    si type.drapeaux.REQUIERS_RAFINAGE {
        ajoute_au_tampon(enchaineuse, "    ob_type := rafine_type_", type.nom_sauf, "(valeur);\n");
        ajoute_au_tampon(enchaineuse, "    résultat := ob_type.tp_alloc(ob_type, 1) comme *", type.nom_sauf, "PourPython;\n");
        ajoute_au_tampon(enchaineuse, "    résultat.ob_type = ob_type;\n");
    }
    sinon {
        ajoute_au_tampon(enchaineuse, "    résultat := ", type.nom_globale_type, ".tp_alloc(*", type.nom_globale_type, ", 1) comme *", type.nom_sauf, "PourPython;\n");
    }

    ajoute_au_tampon(enchaineuse, "    résultat.notre_instance = valeur;\n");
    si type.drapeaux.TYPE_EST_TABLEAU {
        ajoute_au_tampon(enchaineuse, "    résultat.exports = 0;\n");
        ajoute_au_tampon(enchaineuse, "    résultat.remplis_champs_requis_py_buffer = remplis_champs_requis_py_buffer_pour_", type.nom_globale_type, ";\n");
    }
    ajoute_au_tampon(enchaineuse, "    retourne résultat;\n");
}

type_supporte_itération :: fonc (type: *TypePython) -> bool
{
    si type.type_itérateur {
        retourne vrai;
    }

    si type_supporte_mapping(type) {
        /* Les types pouvant être "mappés" ont des itérateurs afin de pouvoir
         * supporter, par exemple, les expressions types 'if x in y'.
         * Ceci n'est pas supporté pour les unions. */
        retourne type.drapeaux.TYPE_EST_UNION == faux;
    }

    retourne faux;
}

génère_fonction_pour_créer_itérateur :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    saufsi type_supporte_itération(type) {
        retourne copie_chaine("");
    }

    nom_fonction := enchaine("itérateur_pour_", type.nom_sauf);

    corps_fonction_pour_type_itérateur := «
    type_itérateur := *%;
    py_itérateur_ := type_itérateur.tp_alloc(type_itérateur, 1);
    py_itérateur := %(py_itérateur_);
    py_itérateur.notre_instance = %(ob).notre_instance;
    py_itérateur.index_courant = 0;
    retourne py_itérateur comme *PyObject;
    »;

    corps_fonction_pour_info_type := «
    retourne itérateur_pour_infos_type(info_de(%));
    »;

    inutilisée := "";
    saufsi type.type_itérateur {
        inutilisée = " @inutilisée";
    }

    ajoute_au_tampon(enchaineuse, nom_fonction, " :: fonc (ob: *PyObject", inutilisée, ") -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    si type.type_itérateur {
        imprime_dans_enchaineuse(enchaineuse, corps_fonction_pour_type_itérateur, type.type_itérateur.nom_globale_type, type.type_itérateur.fonctions.pour_extraction_valeur, type.fonctions.pour_extraction_valeur);
    }
    sinon {
        imprime_dans_enchaineuse(enchaineuse, corps_fonction_pour_info_type, type.nom_type_kuri);
    }
    ajoute_au_tampon(enchaineuse, "}\n");

    retourne nom_fonction;
}

génère_fonction_itérateur_next :: fonc (enchaineuse: *Enchaineuse, type: *TypePython) -> chaine
{
    saufsi type.drapeaux.TYPE_EST_ITÉRATEUR {
        retourne copie_chaine("");
    }

    nom_fonction := enchaine("itérateur_pour_next_", type.nom_sauf);

    corps_fonction := «
    py_self := %(self);

    si py_self.index_courant >= py_self.notre_instance.taille {
        retourne nul;
    }

    valeur_courante := py_self.notre_instance[py_self.index_courant];

    py_valeur_courante := %(valeur_courante);

    py_self.index_courant += 1;
    retourne py_valeur_courante;
    »;

    ajoute_au_tampon(enchaineuse, nom_fonction, " :: fonc (self: *PyObject) -> *PyObject\n");
    ajoute_au_tampon(enchaineuse, "{\n");
    imprime_dans_enchaineuse(enchaineuse, corps_fonction, type.fonctions.pour_extraction_valeur, type.type_itéré.type_élément.fonctions.pour_construction);
    ajoute_au_tampon(enchaineuse, "}\n");

    retourne nom_fonction;
}

génère_création_valeur_défaut :: fonc (enchaineuse: *Enchaineuse, valeur_défaut: *NoeudCode)
{
    discr valeur_défaut.genre {
        EXPRESSION_LITTÉRALE_NUL {
            ajoute_au_tampon(enchaineuse, " := python_retourne_rien();\n");
        }
        EXPRESSION_LITTÉRALE_BOOLÉEN {
            littérale := valeur_défaut comme *NoeudCodeLittéraleBool;
            si littérale.valeur {
                ajoute_au_tampon(enchaineuse, " := python_retourne_true();\n");
            }
            sinon {
                ajoute_au_tampon(enchaineuse, " := python_retourne_faux();\n");
            }
        }
        EXPRESSION_LITTÉRALE_NOMBRE_ENTIER {
            littérale := valeur_défaut comme *NoeudCodeLittéraleEntier;
            imprime_dans_enchaineuse(enchaineuse, " := PyLong_FromLong(%);\n", littérale.valeur);
        }
        EXPRESSION_LITTÉRALE_NOMBRE_RÉEL {
            littérale := valeur_défaut comme *NoeudCodeLittéraleRéel;
            imprime_dans_enchaineuse(enchaineuse, " := PyLong_FromLong(%);\n", littérale.valeur);
        }
        EXPRESSION_LITTÉRALE_CHAINE {
            littérale := valeur_défaut comme *NoeudCodeLittéraleChaine;
            imprime_dans_enchaineuse(enchaineuse, " := PyUnicode_FromChaine(\"%\");\n", littérale.valeur);
        }
        EXPRESSION_LITTÉRALE_CARACTÈRE {
            littérale := valeur_défaut comme *NoeudCodeLittéraleCaractère;
            imprime_dans_enchaineuse(enchaineuse, " := PyLong_FromLong(%);\n", littérale.valeur);
        }
        sinon {}
    }
}

/* Extrait les paramètres des arguments passés à la fonction. Pour le moment ces arguments
 * ont des types conforment à Python. Le nom des arguments doit être "args". */
génère_parsage_args_tuple :: fonc (enchaineuse: *Enchaineuse, méthode: *MéthodePython, valeur_retour: chaine)
{
    saufsi méthode.paramètres_entrée {
        retourne;
    }

    pour méthode.paramètres_entrée {
        ajoute_au_tampon(enchaineuse, "    pyobject_", it.nom);
        si it.valeur_défaut {
            génère_création_valeur_défaut(enchaineuse, it.valeur_défaut);
        }
        sinon {
            ajoute_au_tampon(enchaineuse, ": *PyObject;\n");
        }
    }

    ajoute_au_tampon(enchaineuse, "    chn_objets := ChaineC(\"");
    séparateur_arguments_optionel_fut_ajouté := faux;
    pour méthode.paramètres_entrée {
        si it.valeur_défaut != nul && !séparateur_arguments_optionel_fut_ajouté {
            ajoute_au_tampon(enchaineuse, "|");
            séparateur_arguments_optionel_fut_ajouté = vrai;
        }
        ajoute_au_tampon(enchaineuse, "O");
    }
    ajoute_au_tampon(enchaineuse, "\".caractères);\n");

    ajoute_au_tampon(enchaineuse, "    saufsi PyArg_ParseTuple(args, chn_objets");
    virgule := ", ";
    pour méthode.paramètres_entrée {
        ajoute_au_tampon(enchaineuse, virgule, "*pyobject_", it.nom);
    }
    ajoute_au_tampon(enchaineuse, ") {\n");
    ajoute_au_tampon(enchaineuse, "        retourne ", valeur_retour, ";\n");
    ajoute_au_tampon(enchaineuse, "    }\n");

    /* Vérifie que les types sont ceux attendus. */
    pour méthode.paramètres_entrée {
        chn_erreur := imprime_chaine("Mauvais type pour l'argument % ! Attendu : %, obtenu : ", it.nom, it.type.nom);
        diffère déloge(*chn_erreur);

        ajoute_au_tampon(enchaineuse, "    saufsi ", it.type.fonctions.pour_discrimination, "(pyobject_", it.nom, ") {\n");
        ajoute_au_tampon(enchaineuse, "        retourne PyErr_MauvaisTypeArgument(pyobject_", it.nom, ", \"", it.nom, "\", \"", it.type.nom, "\");\n");
        ajoute_au_tampon(enchaineuse, "    }\n");
    }
}

/* Convertis les paramètres de fonction vers des objets de type Kuri natif (les types du programme). */
génère_conversion_args_vers_kuri :: fonc (enchaineuse: *Enchaineuse, méthode: *MéthodePython)
{
    chaine_pour_extraction_énum := «
    % : %;
    si PyUnicode_Check(pyobject_%) {
        % = %(pyobject_%, info_de(%)) comme (%);
    }
    sinon {
        % = %(pyobject_%).notre_instance;
    }
    »;

    pour méthode.paramètres_entrée {
        si it.type.drapeaux.TYPE_EST_ÉNUM {
            imprime_dans_enchaineuse(enchaineuse, chaine_pour_extraction_énum, it.nom, it.type.nom, it.nom, it.nom, it.type.fonctions.pour_valeur_unicode_enum, it.nom, it.type.nom, it.type.nom, it.nom, it.type.fonctions.pour_extraction_valeur, it.nom);
            continue;
        }
        ajoute_au_tampon(enchaineuse, "    ", it.nom, " := ", it.type.fonctions.pour_extraction_valeur, "(pyobject_", it.nom, ");\n");
    }
}

// Génère l'expression d'appel pour le code Kuri de la méthode. La fonction appelante doit gérer la potentielle valeur de retour (nom, assignation, etc.).
génère_appel_méthode_kuri :: fonc (enchaineuse: *Enchaineuse, méthode: *MéthodePython, premier_paramètre_implicite : chaine = "")
{
    ajoute_au_tampon(enchaineuse, méthode.nom);
    virgule := "(";
    si premier_paramètre_implicite {
        ajoute_au_tampon(enchaineuse, virgule, premier_paramètre_implicite);
        virgule = ", ";
    }
    sinon saufsi méthode.paramètres_entrée {
        ajoute_au_tampon(enchaineuse, virgule);
    }
    pour méthode.paramètres_entrée {
        ajoute_au_tampon(enchaineuse, virgule);
        si it.param_originel_est_pointeur && it.type.drapeaux.TOUJOURS_COMME_POINTEUR == faux {
            ajoute_au_tampon(enchaineuse, "*");
        }
        ajoute_au_tampon(enchaineuse, it.nom);
        saufsi it.type.est_basique || it.type.drapeaux.TYPE_EST_ÉNUM {
            ajoute_au_tampon(enchaineuse, ".notre_instance");
        }
        virgule = ", ";
    }
    ajoute_au_tampon(enchaineuse, ");\n");
}

génère_interface_fonction :: fonc (enchaineuse: *Enchaineuse, méthode: *MéthodePython, self : *TypePython = nul)
{
    // À FAIRE : initialisation des variables globales de kuri

    /* self, pour les méthodes de module, c'est la méthode, pour le reste, c'est l'objet */
    self_inutilisé := "";
    saufsi self {
        self_inutilisé = " @inutilisée";
    }
    args_inutilisés := "";
    saufsi méthode.paramètres_entrée {
        args_inutilisés = " @inutilisée";
    }

    imprime_dans_enchaineuse(enchaineuse, "% :: fonc (self: *PyObject%, args: *PyObject%) -> *PyObject\n", méthode.nom_enveloppe, self_inutilisé, args_inutilisés);
    ajoute_au_tampon(enchaineuse, "{\n");

    génère_parsage_args_tuple(enchaineuse, méthode, "nul");
    génère_conversion_args_vers_kuri(enchaineuse, méthode);

    si self {
        ajoute_au_tampon(enchaineuse, "    self_kuri := ", self.fonctions.pour_extraction_valeur, "(self);\n");
    }

    /* Appel la fonction. */
    possède_retour := !ne_retourne_rien(méthode);

    ajoute_au_tampon(enchaineuse, "    ");
    si possède_retour {
        ajoute_au_tampon(enchaineuse, "résultat := ");
    }

    arg_implicite := "";
    si self {
        si self.drapeaux.TOUJOURS_COMME_POINTEUR {
            si méthode.param_self_est_pointeur {
                arg_implicite = "self_kuri.notre_instance";
            }
            sinon {
                arg_implicite = "mémoire(self_kuri.notre_instance)";
            }
        }
        sinon {
            si méthode.param_self_est_pointeur {
                arg_implicite = "*self_kuri.notre_instance";
            }
            sinon {
                arg_implicite = "self_kuri.notre_instance";
            }
        }
    }

    génère_appel_méthode_kuri(enchaineuse, méthode, arg_implicite);

    si possède_retour {
        type_sortie := méthode.paramètres_sortie[0].type;
        ajoute_au_tampon(enchaineuse, "    retourne ", type_sortie.fonctions.pour_construction, "(résultat);\n");
    }
    sinon {
        ajoute_au_tampon(enchaineuse, "    retourne python_retourne_rien();\n");
    }

    ajoute_au_tampon(enchaineuse, "}\n");
}

génère_tableaux_méthodes :: fonc (enchaineuse: *Enchaineuse, méthodes: []MéthodePython, nom_tableau: chaine)
{
    /* Déclare le tableau de méthodes. Il y a une méthode supplémentaire nulle comme sentinelle. */
    imprime_dans_enchaineuse(enchaineuse, "% := [\n", nom_tableau);

    pour méthodes {
        drapeaux_méthode := si it.paramètres_entrée {
            "METH_VARARGS";
        }
        sinon {
            "METH_NOARGS";
        };

        imprime_dans_enchaineuse(enchaineuse, "    PyMethodDef(ml_name = ChaineC(\"%\".caractères), ml_meth = %, ml_flags = %, ml_doc = ChaineC(nul)),\n", it.nom, it.nom_enveloppe, drapeaux_méthode);
    }

    /* Sentinelle */
    imprime_dans_enchaineuse(enchaineuse, "    PyMethodDef(ml_name = ChaineC(nul), ml_meth = nul, ml_flags = 0, ml_doc = ChaineC(nul))\n");
    ajoute_au_tampon(enchaineuse, "];\n");
}

ajoute_type_à_la_liste :: fonc (enchaineuse: *Enchaineuse, type: *TypePython)
{
    si type.code_pour_init_module_fut_généré {
        retourne;
    }

    si type.base {
        ajoute_type_à_la_liste(enchaineuse, type.base);
    }

    ajoute_au_tampon(enchaineuse, "        DonnéesAjoutType(*", type.nom_globale_type, ", ChaineC(\"", type.nom, "\".caractères)),\n");
    type.code_pour_init_module_fut_généré = vrai;
}

génère_initialisation_module :: fonc (enchaineuse: *Enchaineuse, module: *ModulePython, types: []*TypePython)
{
    génère_tableaux_méthodes(enchaineuse, module.méthodes, "méthodes_du_module");

    ajoute_au_tampon(enchaineuse, "ChaineC :: Chaine.ChaineC\n");

    /* Déclaration de la globale pour la définition du module. */
    ajoute_au_tampon(enchaineuse, "définition_module := PyModuleDef(\n");

    imprime_dans_enchaineuse(enchaineuse, "    m_name = ChaineC(\"%\".caractères),\n", module.nom);
    ajoute_au_tampon(enchaineuse, "    m_doc = ChaineC(nul),\n");
    ajoute_au_tampon(enchaineuse, "    m_size = -1,\n");
    ajoute_au_tampon(enchaineuse, "    m_methods = *méthodes_du_module[0],\n");
    ajoute_au_tampon(enchaineuse, "    m_slots = nul,\n");
    ajoute_au_tampon(enchaineuse, "    m_traverse = nul,\n");
    ajoute_au_tampon(enchaineuse, "    m_clear = nul,\n");
    ajoute_au_tampon(enchaineuse, "    m_free = nul);\n");

    /* La fonction d'initialisation du module doit avoir la signature : PyInit_nom_module :: fonc () -> *PyObject */
    imprime_dans_enchaineuse(enchaineuse, "PyInit_% :: fonc () -> *PyObject #racine #sansbroyage #sanstrace #exporte\n", module.nom);
    ajoute_au_tampon(enchaineuse, "{\n");
    ajoute_au_tampon(enchaineuse, "    module_pyobject := PyModule_Create2(*définition_module, PYTHON_API_VERSION);\n");

    pour module.constantes_nombre_entier {
        imprime_dans_enchaineuse(enchaineuse, "    si PyModule_AddIntConstant(module_pyobject, ChaineC(\"%\".caractères), %) == -1 {\n", it.nom, it.valeur);
        ajoute_au_tampon(enchaineuse, "        retourne python_retourne_rien();\n");
        ajoute_au_tampon(enchaineuse, "    }\n");
    }

    pour module.constantes_chaine {
        imprime_dans_enchaineuse(enchaineuse, "    si PyModule_AddStringConstant(module_pyobject, ChaineC(\"%\".caractères), ChaineC(\"%\".caractères)) == -1 {\n", it.nom, it.valeur);
        ajoute_au_tampon(enchaineuse, "        retourne python_retourne_rien();\n");
        ajoute_au_tampon(enchaineuse, "    }\n");
    }

    /* Rassemble les types dans l'ordre. */
    itérateur_info_type_est_requis := faux;
    ajoute_au_tampon(enchaineuse, "    tous_les_types := [\n");
    pour types {
        si it.est_basique {
            continue;
        }
        si type_supporte_itération(it) && !it.type_itérateur {
            itérateur_info_type_est_requis = vrai;
        }
        ajoute_type_à_la_liste(enchaineuse, it);
    }
    /* Type itérateur info type. */
    si itérateur_info_type_est_requis {
        ajoute_au_tampon(enchaineuse, "         DonnéesAjoutType(*PyTypeItérateurPourInfoType, ChaineC(\"ItérateurPourInfoType\".caractères)),\n");
    }
    /* Sentinelle pour simplifier la génération de code pour les virgules. */
    ajoute_au_tampon(enchaineuse, "         DonnéesAjoutType(nul, ChaineC(nul));\n");
    ajoute_au_tampon(enchaineuse, "    ]\n");

    ajoute_au_tampon(enchaineuse, "    retourne Py_AjouteTypesAuModule(module_pyobject, tous_les_types);\n");
    ajoute_au_tampon(enchaineuse, "}\n");
}

génère_initialisation_table_création_objet :: fonc (enchaineuse: *Enchaineuse, types: []*TypePython)
{
    ajoute_au_tampon(enchaineuse, "initialise_table_création_objet :: fonc ()\n");
    ajoute_au_tampon(enchaineuse, "{\n");

    pour types {
        si it.est_basique {
            continue;
        }

        si it.drapeaux.TYPE_EST_ITÉRATEUR {
            /* Les fonctions de création ne sont pas disponibles pour les itérateurs. */
            continue;
        }

        symbole_pointeur := "";
        si it.drapeaux.TOUJOURS_COMME_POINTEUR {
            symbole_pointeur = "*";
        }

        ajoute_au_tampon(enchaineuse, "    tableau_ajoute(*__table_création_objet, DonnéesCréationObjet(*", it.nom_globale_type, ", info_de(", symbole_pointeur, it.nom_type_kuri ,"), ", it.fonctions.pour_construction, "_générique));\n");
    }

    ajoute_au_tampon(enchaineuse, "}\n");
    ajoute_au_tampon(enchaineuse, "#ajoute_init initialise_table_création_objet();\n");
}
