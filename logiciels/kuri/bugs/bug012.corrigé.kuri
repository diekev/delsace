/* Bug corrigé par le commit : 740b281a8738e1b71a5e916f686ec27a878c6c1d
 * On ne peut avoir plusieurs blocs emploie_contexte dans un même bloc (coulisse C)
 * Catégorie : [génération code, emploie_contexte]
 */

importe Chaine;
importe Fondation;

principale :: fonc ()
{
    nouveau_contexte := contexte();
    nouveau_contexte.allocatrice = __stockage_temporaire;

    mots: [..]chaine;

    emploie_contexte nouveau_contexte {
        mots = divise("Je suis une chaine !", ' ');
    }

    emploie_contexte nouveau_contexte {
        mots = divise("Je suis une autre chaine !", ' ');
    }
}
